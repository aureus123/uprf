/-
  Lemma 3.3 and Theorem 6.7.
-/
import UPRF.Robinson

namespace UPRF

/-- footnote 3: x - y stands for any function d(x, y) equal to x - y whenever x ≥ y -/
def IsDifference (d : ℕ → ℕ → ℕ) : Prop := ∀ a b, b ≤ a → d a b = a - b

def opDiff (d : ℕ → ℕ → ℕ) (F G : UFun) : UFun := fun x => d (F x) (G x)

/-- the basis ⟨S, Sq, O, Hf, Rt, F + G, F - G, FG, F^□⟩ of Lemma 3.3 -/
def basisL33 (d : ℕ → ℕ → ℕ) : Basis :=
  ⟨{funS, funSq, funO, funHf, funRt}, {opBox}, {opPlus, opDiff d, (· ∘ ·)}⟩

/-- Lemma 3.3, for every primitive recursive difference function.  The paper derives it
  from Lemma 3.1 and Theorem 2 of [15]; here it follows from Theorem 3 of [15] via
  E ≡ I - Sq Rt. -/
theorem Lemma_3_3 {d : ℕ → ℕ → ℕ} (hd : IsDifference d) (hdP : Primrec₂ d) :
    Suitable (basisL33 d) := by
  refine suitable_by_simulation Robinson_1947_sec7_thm3 ?_ ?_ ?_ ?_
  · have S : Clos (basisL33 d) funS := .init (by simp [basisL33])
    have Sq : Clos (basisL33 d) funSq := .init (by simp [basisL33])
    have Rt : Clos (basisL33 d) funRt := .init (by simp [basisL33])
    have I : Clos (basisL33 d) funI :=
      funI_eq_box_S ▸ .unop (u := opBox) (by simp [basisL33]) S
    have SqRt : Clos (basisL33 d) (funSq ∘ funRt) :=
      .binop (b := (· ∘ ·)) (by simp [basisL33]) Sq Rt
    have E : opDiff d funI (funSq ∘ funRt) = funE := by
      funext x; exact hd _ _ (funRt_sq_le x)
    rintro F (rfl | rfl)
    · exact S
    · exact E ▸ .binop (b := opDiff d) (by simp [basisL33]) I SqRt
  · rintro u rfl F hF; exact .unop (by simp [basisL33]) hF
  · rintro b (rfl | rfl) F G hF hG <;> exact .binop (by simp [basisL33]) hF hG
  · refine clos_sound ?_ ?_ ?_
    · rintro F (rfl | rfl | rfl | rfl | rfl)
      exacts [funS_PR, funSq_PR, funO_PR, funHf_PR, funRt_PR]
    · rintro u rfl F hF; exact opBox_PR hF
    · rintro b (rfl | rfl | rfl) F G hF hG
      · exact opPlus_PR hF hG
      · exact prim_of (hdP.comp (primrec_of hF) (primrec_of hG))
      · exact comp_PR hF hG

theorem C6_sound : ∀ F, C6 F → PrimNN F :=
  clos_sound
    (by rintro F (rfl | rfl); exacts [cst_PR 1, funE_PR])
    (by rintro u (rfl | rfl) F hF; exacts [opPlusI_PR hF, opBox_PR hF])
    (by rintro b rfl F G hF hG; exact comp_PR hF hG)

/-- Theorem 6.7: 𝓕 = ⟨1, E, F⁺, FG, F^□⟩ is suitable. -/
theorem Theorem_6_7 : Suitable basis6 := fun F => ⟨C6_sound F, PrimNN_sub_C6⟩

/-- The proof of the paper: the basis of Lemma 3.3 (with the difference function dE of
  footnote 8) is generated by 𝓕. -/
theorem Theorem_6_7_via_L33 : Suitable basis6 := by
  have hd : IsDifference dE := fun a b h => dE_diff h
  have hdP : Primrec₂ dE := by
    have := primrec_of funE_PR
    refine this.comp ?_
    exact Primrec.nat_add.comp (Primrec.nat_add.comp (Primrec.nat_add.comp
      (Primrec.nat_mul.comp (Primrec.nat_add.comp Primrec.fst Primrec.snd)
        (Primrec.nat_add.comp Primrec.fst Primrec.snd))
      (Primrec.nat_mul.comp (Primrec.const 3) Primrec.fst)) Primrec.snd) (Primrec.const 1)
  refine suitable_by_simulation (Lemma_3_3 hd hdP) ?_ ?_ ?_ C6_sound
  · rintro F (rfl | rfl | rfl | rfl | rfl)
    exacts [S_in, Sq_in, O_in, Hf_in, Rt_in]
  · rintro u rfl F hF; exact C6_box hF
  · rintro b (rfl | rfl | rfl) F G hF hG
    · exact plus_in hF hG
    · exact diffE_in hF hG
    · exact C6_comp hF hG

end UPRF
