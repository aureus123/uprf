environ
 vocabularies NUMBERS, SUBSET_1, FUNCT_1, FUNCT_2, RELAT_1, ARYTM_3, ARYTM_1,
   XXREAL_0, NAT_1, CARD_1, ORDINAL1, XBOOLE_0, TARSKI, BINOP_1, FUNCT_7,
   ZFMISC_1, INT_1, UPRF;
 notations TARSKI, XBOOLE_0, ENUMSET1, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
   XCMPLX_0, XXREAL_0, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
   BINOP_1, NAT_1, NAT_D;
 constructors ENUMSET1, NAT_1, NAT_D, BINOP_1, XXREAL_0, FUNCT_2, RELSET_1,
   SUBSET_1;
 registrations ORDINAL1, NUMBERS, FUNCT_1, RELAT_1, XREAL_0, NAT_1,
   FUNCT_2, RELSET_1, XBOOLE_0, SUBSET_1;
 requirements NUMERALS, SUBSET, ARITHM, REAL, BOOLE;
 definitions TARSKI;
 theorems TARSKI, ENUMSET1, XBOOLE_0, XBOOLE_1, SUBSET_1, FUNCT_2, NAT_1,
   XREAL_1, NAT_D, NAT_2, ORDINAL1, XXREAL_0, BINOP_1, NUMBER13;
 schemes FUNCT_2, NAT_1, SUBSET_1, BINOP_1;

begin

:: Section 2 of D. E. Severin, "Unary primitive recursive functions", JSL 2008:
:: one-argument functions, the operators of the paper, bases and closures.
:: Naming: the function X of the paper is funX, an operator is opX;
:: FG of the paper is F*G of Mizar ((F*G).x = F.(G.x)).

reserve x,y,n,m,k,r,s for Nat;
reserve F,G,H for Element of Funcs(NAT,NAT);

:: Two schemes to define one-argument functions by a formula

scheme UFunEx{T(Nat) -> Nat}:
  ex f being Element of Funcs(NAT,NAT) st for x being Nat holds f.x = T(x)
proof
  deffunc U(Element of NAT) = In(T($1),NAT);
  consider f being Function of NAT,NAT such that
  A1: for x being Element of NAT holds f.x = U(x) from FUNCT_2:sch 4;
  reconsider f as Element of Funcs(NAT,NAT) by FUNCT_2:8;
  take f;
  let x be Nat;
  A2: x in NAT by ORDINAL1:def 12;
  T(x) in NAT by ORDINAL1:def 12;
  then In(T(x),NAT) = T(x) by SUBSET_1:def 8;
  hence thesis by A1, A2;
end;

scheme UFunUq{T(Nat) -> Nat, f,g() -> Element of Funcs(NAT,NAT)}: f() = g()
provided
A1: for x being Nat holds f().x = T(x) and
A2: for x being Nat holds g().x = T(x)
proof
  now
    let x be Element of NAT;
    thus f().x = T(x) by A1 .= g().x by A2;
  end;
  hence thesis by FUNCT_2:63;
end;

registration
  let F be Element of Funcs(NAT,NAT), x be Nat;
  cluster F.x -> natural;
  coherence
  proof
    x in NAT by ORDINAL1:def 12;
    then F.x in NAT by FUNCT_2:5;
    hence thesis;
  end;
end;

theorem UFunExt:
  (for x being Nat holds F.x = G.x) implies F = G
proof
  assume A1: for x being Nat holds F.x = G.x;
  for x being Element of NAT holds F.x = G.x by A1;
  hence thesis by FUNCT_2:63;
end;

definition
  let G,F be Element of Funcs(NAT,NAT);
  redefine func F*G -> Element of Funcs(NAT,NAT);
  coherence
  proof
    reconsider f = F, g = G as Function of NAT,NAT;
    f*g is Function of NAT,NAT;
    hence thesis by FUNCT_2:8;
  end;
end;

scheme UOpEx{T(Element of Funcs(NAT,NAT), Nat) -> Nat}:
  ex u being UnOp of Funcs(NAT,NAT) st
  for F being Element of Funcs(NAT,NAT), x being Nat holds (u.F).x = T(F,x)
proof
  defpred P[object,object] means
    ex f,g being Element of Funcs(NAT,NAT) st f = $1 & g = $2 &
    for x being Nat holds g.x = T(f,x);
  A1: for F being Element of Funcs(NAT,NAT)
      ex g being Element of Funcs(NAT,NAT) st P[F,g]
  proof
    let F be Element of Funcs(NAT,NAT);
    deffunc T1(Nat) = T(F,$1);
    consider g being Element of Funcs(NAT,NAT) such that
    B1: for x being Nat holds g.x = T1(x) from UFunEx;
    take g, F, g;
    thus thesis by B1;
  end;
  consider u being Function of Funcs(NAT,NAT),Funcs(NAT,NAT) such that
  A2: for F being Element of Funcs(NAT,NAT) holds P[F,u.F]
    from FUNCT_2:sch 3(A1);
  take u;
  let F be Element of Funcs(NAT,NAT), x be Nat;
  ex f,g being Element of Funcs(NAT,NAT) st f = F & g = u.F &
    for x being Nat holds g.x = T(f,x) by A2;
  hence thesis;
end;

scheme UOpUq{T(Element of Funcs(NAT,NAT), Nat) -> Nat,
  u,v() -> UnOp of Funcs(NAT,NAT)}: u() = v()
provided
A1: for F being Element of Funcs(NAT,NAT), x being Nat holds (u().F).x = T(F,x)
  and
A2: for F being Element of Funcs(NAT,NAT), x being Nat holds (v().F).x = T(F,x)
proof
  now
    let F be Element of Funcs(NAT,NAT);
    now
      let x be Nat;
      thus (u().F).x = T(F,x) by A1 .= (v().F).x by A2;
    end;
    hence u().F = v().F by UFunExt;
  end;
  hence thesis by FUNCT_2:63;
end;

scheme BOpEx{T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat)
  -> Nat}:
  ex b being BinOp of Funcs(NAT,NAT) st
  for F,G being Element of Funcs(NAT,NAT), x being Nat holds
    (b.(F,G)).x = T(F,G,x)
proof
  defpred P[object,object,object] means
    ex f,g,h being Element of Funcs(NAT,NAT) st f = $1 & g = $2 & h = $3 &
    for x being Nat holds h.x = T(f,g,x);
  A1: for F,G being Element of Funcs(NAT,NAT)
      ex h being Element of Funcs(NAT,NAT) st P[F,G,h]
  proof
    let F,G be Element of Funcs(NAT,NAT);
    deffunc T1(Nat) = T(F,G,$1);
    consider h being Element of Funcs(NAT,NAT) such that
    B1: for x being Nat holds h.x = T1(x) from UFunEx;
    take h, F, G, h;
    thus thesis by B1;
  end;
  consider b being Function of [:Funcs(NAT,NAT),Funcs(NAT,NAT):],Funcs(NAT,NAT)
    such that
  A2: for F,G being Element of Funcs(NAT,NAT) holds P[F,G,b.(F,G)]
    from BINOP_1:sch 3(A1);
  take b;
  let F,G be Element of Funcs(NAT,NAT), x be Nat;
  ex f,g,h being Element of Funcs(NAT,NAT) st f = F & g = G & h = b.(F,G) &
    for x being Nat holds h.x = T(f,g,x) by A2;
  hence thesis;
end;

scheme BOpUq{T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat)
  -> Nat, b,c() -> BinOp of Funcs(NAT,NAT)}: b() = c()
provided
A1: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
  (b().(F,G)).x = T(F,G,x) and
A2: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
  (c().(F,G)).x = T(F,G,x)
proof
  now
    let F,G be Element of Funcs(NAT,NAT);
    now
      let x be Nat;
      thus (b().(F,G)).x = T(F,G,x) by A1 .= (c().(F,G)).x by A2;
    end;
    hence b().(F,G) = c().(F,G) by UFunExt;
  end;
  hence thesis by BINOP_1:2;
end;

:: Basic functions

:: identity
definition
  func funI -> Element of Funcs(NAT,NAT) means :DefI:
  for x being Nat holds it.x = x;
  existence
  proof
    deffunc T(Nat) = $1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: constants (written \overline n in the paper)
definition
  let n be Nat;
  func cst n -> Element of Funcs(NAT,NAT) means :DefCst:
  for x being Nat holds it.x = n;
  existence
  proof
    deffunc T(Nat) = n;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = n;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: successor
definition
  func funS -> Element of Funcs(NAT,NAT) means :DefS:
  for x being Nat holds it.x = x+1;
  existence
  proof
    deffunc T(Nat) = $1+1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1+1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: Arithmetic functions

:: double
definition
  func funD -> Element of Funcs(NAT,NAT) means :DefD:
  for x being Nat holds it.x = 2*x;
  existence
  proof
    deffunc T(Nat) = 2*$1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = 2*$1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: square
definition
  func funSq -> Element of Funcs(NAT,NAT) means :DefSq:
  for x being Nat holds it.x = x*x;
  existence
  proof
    deffunc T(Nat) = $1*$1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1*$1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: half
definition
  func funHf -> Element of Funcs(NAT,NAT) means :DefHf:
  for x being Nat holds it.x = x div 2;
  existence
  proof
    deffunc T(Nat) = $1 div 2;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1 div 2;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: Integer square root

theorem RtEx:
  for x being Nat ex r being Nat st r*r <= x & x < (r+1)*(r+1)
proof
  defpred P[Nat] means ex r being Nat st r*r <= $1 & $1 < (r+1)*(r+1);
  A1: P[0]
  proof
    take 0; thus thesis;
  end;
  A2: for x being Nat st P[x] holds P[x+1]
  proof
    let x be Nat;
    given r being Nat such that
    B1: r*r <= x & x < (r+1)*(r+1);
    per cases;
    suppose C1: x+1 < (r+1)*(r+1);
      take r;
      thus r*r <= x+1 by B1, NAT_1:13;
      thus thesis by C1;
    end;
    suppose C1: x+1 >= (r+1)*(r+1);
      take r+1;
      B3: x+1 <= (r+1)*(r+1) by B1, NAT_1:13;
      thus (r+1)*(r+1) <= x+1 by C1;
      B2: x+1 = (r+1)*(r+1) by B3, C1, XXREAL_0:1;
      (r+1+1)*(r+1+1) = (r+1)*(r+1) + (2*r+3);
      hence thesis by B2, XREAL_1:29;
    end;
  end;
  for x being Nat holds P[x] from NAT_1:sch 2(A1,A2);
  hence thesis;
end;

theorem RtUq:
  r*r <= x & x < (r+1)*(r+1) & s*s <= x & x < (s+1)*(s+1) implies r = s
proof
  assume that A1: r*r <= x and A2: x < (r+1)*(r+1) and
    A3: s*s <= x and A4: x < (s+1)*(s+1);
  A5: now
    let a,b be Nat such that B1: a*a <= x and B2: x < (b+1)*(b+1);
    assume not a <= b;
    then b+1 <= a by NAT_1:13;
    then (b+1)*(b+1) <= a*a by XREAL_1:66;
    hence contradiction by B1, B2, XXREAL_0:2;
  end;
  then r <= s by A1, A4;
  then s <= r implies r = s by XXREAL_0:1;
  hence thesis by A5, A3, A2;
end;

:: integer square root
definition
  func funRt -> Element of Funcs(NAT,NAT) means :DefRt:
  for x being Nat holds it.x * it.x <= x & x < (it.x + 1)*(it.x + 1);
  existence
  proof
    defpred P[Nat,Nat] means $2*$2 <= $1 & $1 < ($2+1)*($2+1);
    A1: for x being Element of NAT ex r being Element of NAT st P[x,r]
    proof
      let x be Element of NAT;
      consider r being Nat such that B1: P[x,r] by RtEx;
      reconsider r as Element of NAT by ORDINAL1:def 12;
      take r;
      thus thesis by B1;
    end;
    consider f being Function of NAT,NAT such that
    A2: for x being Element of NAT holds P[x,f.x] from FUNCT_2:sch 3(A1);
    reconsider f as Element of Funcs(NAT,NAT) by FUNCT_2:8;
    take f;
    let x be Nat;
    x in NAT by ORDINAL1:def 12;
    hence thesis by A2;
  end;
  uniqueness
  proof
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x * f.x <= x & x < (f.x + 1)*(f.x + 1) and
    A2: for x being Nat holds g.x * g.x <= x & x < (g.x + 1)*(g.x + 1);
    now
      let x be Nat;
      A3: f.x * f.x <= x & x < (f.x + 1)*(f.x + 1) by A1;
      g.x * g.x <= x & x < (g.x + 1)*(g.x + 1) by A2;
      hence f.x = g.x by A3, RtUq;
    end;
    hence f = g by UFunExt;
  end;
end;

theorem RtI:
  r*r <= x & x < (r+1)*(r+1) implies funRt.x = r
proof
  assume A1: r*r <= x & x < (r+1)*(r+1);
  funRt.x * funRt.x <= x & x < (funRt.x + 1)*(funRt.x + 1) by DefRt;
  hence thesis by A1, RtUq;
end;

:: excess over a square, E(x) = x - Rt(x)^2
definition
  func funE -> Element of Funcs(NAT,NAT) means :DefE:
  for x being Nat holds it.x = x -' (funRt.x)*(funRt.x);
  existence
  proof
    deffunc T(Nat) = $1 -' (funRt.$1)*(funRt.$1);
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1 -' (funRt.$1)*(funRt.$1);
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: power of zero (cosignum) and signum
definition
  func funO -> Element of Funcs(NAT,NAT) means :DefO:
  for x being Nat holds (x = 0 implies it.x = 1) & (x <> 0 implies it.x = 0);
  existence
  proof
    deffunc T(Nat) = 1 -' $1;
    consider f being Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) from UFunEx;
    take f;
    let x be Nat;
    thus x = 0 implies f.x = 1
    proof
      assume x = 0;
      then 1 -' x = 1 by NAT_D:40;
      hence thesis by A1;
    end;
    assume x <> 0;
    then 1 <= x by NAT_1:14;
    then 1 -' x = 0 by NAT_2:8;
    hence thesis by A1;
  end;
  uniqueness
  proof
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds
      (x = 0 implies f.x = 1) & (x <> 0 implies f.x = 0) and
    A2: for x being Nat holds
      (x = 0 implies g.x = 1) & (x <> 0 implies g.x = 0);
    now
      let x be Nat;
      per cases;
      suppose B1: x = 0;
        thus f.x = 1 by A1, B1 .= g.x by A2, B1;
      end;
      suppose B1: x <> 0;
        thus f.x = 0 by A1, B1 .= g.x by A2, B1;
      end;
    end;
    hence f = g by UFunExt;
  end;
end;

definition
  func funSgn -> Element of Funcs(NAT,NAT) means :DefSgn:
  for x being Nat holds (x = 0 implies it.x = 0) & (x <> 0 implies it.x = 1);
  existence
  proof
    deffunc T(Nat) = 1 -' (1 -' $1);
    consider f being Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) from UFunEx;
    take f;
    let x be Nat;
    thus x = 0 implies f.x = 0
    proof
      assume x = 0;
      then 1 -' x = 1 by NAT_D:40;
      then f.x = 1 -' 1 by A1;
      hence thesis by XREAL_1:232;
    end;
    assume x <> 0;
    then 1 <= x by NAT_1:14;
    then 1 -' x = 0 by NAT_2:8;
    then f.x = 1 -' 0 by A1;
    hence thesis by NAT_D:40;
  end;
  uniqueness
  proof
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds
      (x = 0 implies f.x = 0) & (x <> 0 implies f.x = 1) and
    A2: for x being Nat holds
      (x = 0 implies g.x = 0) & (x <> 0 implies g.x = 1);
    now
      let x be Nat;
      per cases;
      suppose B1: x = 0;
        thus f.x = 0 by A1, B1 .= g.x by A2, B1;
      end;
      suppose B1: x <> 0;
        thus f.x = 1 by A1, B1 .= g.x by A2, B1;
      end;
    end;
    hence f = g by UFunExt;
  end;
end;

:: Operators

:: F^+(x) = F(x) + x
definition
  func opPlusI -> UnOp of Funcs(NAT,NAT) means :DefPlusI:
  for F being Element of Funcs(NAT,NAT), x being Nat holds (it.F).x = F.x + x;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = $1.$2 + $2;
    thus ex u being UnOp of Funcs(NAT,NAT) st
      for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) from UOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = $1.$2 + $2;
    let u,v be UnOp of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) and
    A2: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (v.F).x = T(F,x);
    thus u = v from UOpUq(A1,A2);
  end;
end;

:: F + G and the arithmetic difference F -' G (pointwise)
definition
  func opPlus -> BinOp of Funcs(NAT,NAT) means :DefPlus:
  for F,G being Element of Funcs(NAT,NAT), x being Nat holds
    (it.(F,G)).x = F.x + G.x;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 + $2.$3;
    thus ex b being BinOp of Funcs(NAT,NAT) st
      for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) from BOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 + $2.$3;
    let b,c be BinOp of Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) and
    A2: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (c.(F,G)).x = T(F,G,x);
    thus b = c from BOpUq(A1,A2);
  end;
end;

definition
  func opMinus -> BinOp of Funcs(NAT,NAT) means :DefMinus:
  for F,G being Element of Funcs(NAT,NAT), x being Nat holds
    (it.(F,G)).x = F.x -' G.x;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 -' $2.$3;
    thus ex b being BinOp of Funcs(NAT,NAT) st
      for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) from BOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 -' $2.$3;
    let b,c be BinOp of Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) and
    A2: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (c.(F,G)).x = T(F,G,x);
    thus b = c from BOpUq(A1,A2);
  end;
end;

:: composition FG as an operator
definition
  func opComp -> BinOp of Funcs(NAT,NAT) means :DefComp:
  for F,G being Element of Funcs(NAT,NAT) holds it.(F,G) = F*G;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT)) = $1*$2;
    consider b being Function of [:Funcs(NAT,NAT),Funcs(NAT,NAT):],
      Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT) holds b.(F,G) = T(F,G)
      from BINOP_1:sch 4;
    take b;
    thus thesis by A1;
  end;
  uniqueness
  proof
    let b,c be BinOp of Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT) holds b.(F,G) = F*G and
    A2: for F,G being Element of Funcs(NAT,NAT) holds c.(F,G) = F*G;
    now
      let F,G be Element of Funcs(NAT,NAT);
      thus b.(F,G) = F*G by A1 .= c.(F,G) by A2;
    end;
    hence b = c by BINOP_1:2;
  end;
end;

:: pure iteration F^box: F^box(0) = 0, F^box(x+1) = F(F^box(x))
definition
  func opBox -> UnOp of Funcs(NAT,NAT) means :DefBox:
  for F being Element of Funcs(NAT,NAT) holds (it.F).0 = 0 &
    for x being Nat holds (it.F).(x+1) = F.((it.F).x);
  existence
  proof
    defpred P[object,object] means
      ex f,g being Element of Funcs(NAT,NAT) st f = $1 & g = $2 &
      g.0 = 0 & for x being Nat holds g.(x+1) = f.(g.x);
    A1: for F being Element of Funcs(NAT,NAT)
        ex g being Element of Funcs(NAT,NAT) st P[F,g]
    proof
      let F be Element of Funcs(NAT,NAT);
      deffunc R(Nat, Element of NAT) = F.$2;
      consider g being sequence of NAT such that
      B1: g.0 = 0 & for x being Nat holds g.(x+1) = R(x,g.x)
        from NAT_1:sch 12;
      reconsider g as Element of Funcs(NAT,NAT) by FUNCT_2:8;
      take g, F, g;
      thus thesis by B1;
    end;
    consider u being Function of Funcs(NAT,NAT),Funcs(NAT,NAT) such that
    A2: for F being Element of Funcs(NAT,NAT) holds P[F,u.F]
      from FUNCT_2:sch 3(A1);
    take u;
    let F be Element of Funcs(NAT,NAT);
    ex f,g being Element of Funcs(NAT,NAT) st f = F & g = u.F &
      g.0 = 0 & for x being Nat holds g.(x+1) = f.(g.x) by A2;
    hence thesis;
  end;
  uniqueness
  proof
    let u,v be UnOp of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT) holds (u.F).0 = 0 &
      for x being Nat holds (u.F).(x+1) = F.((u.F).x) and
    A2: for F being Element of Funcs(NAT,NAT) holds (v.F).0 = 0 &
      for x being Nat holds (v.F).(x+1) = F.((v.F).x);
    now
      let F be Element of Funcs(NAT,NAT);
      defpred P[Nat] means (u.F).$1 = (v.F).$1;
      (u.F).0 = 0 by A1 .= (v.F).0 by A2;
      then B1: P[0];
      B2: for x being Nat st P[x] holds P[x+1]
      proof
        let x be Nat;
        assume C1: P[x];
        thus (u.F).(x+1) = F.((u.F).x) by A1 .= (v.F).(x+1) by A2, C1;
      end;
      for x being Nat holds P[x] from NAT_1:sch 2(B1,B2);
      hence u.F = v.F by UFunExt;
    end;
    hence u = v by FUNCT_2:63;
  end;
end;

:: Bases and closures (end of Section 2).  A basis <F1,...,Fn, F^op, ..., F op G>
:: is given by a set I of initial functions, a set U of unary operators and a
:: set B of binary operators (on Funcs(NAT,NAT)).

definition
  let I,U,B be set;
  let X be Subset of Funcs(NAT,NAT);
  pred X is_closed_under I,U,B means :DefClosed:
  I c= X &
  (for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
     st u in U & F in X holds u.F in X) &
  (for b being BinOp of Funcs(NAT,NAT), F,G being Element of Funcs(NAT,NAT)
     st b in B & F in X & G in X holds b.(F,G) in X);
end;

definition
  let I,U,B be set;
  func clos(I,U,B) -> Subset of Funcs(NAT,NAT) means :DefClos:
  for F being Element of Funcs(NAT,NAT) holds F in it iff
    for X being Subset of Funcs(NAT,NAT) st X is_closed_under I,U,B
    holds F in X;
  existence
  proof
    defpred P[object] means
      for X being Subset of Funcs(NAT,NAT) st X is_closed_under I,U,B
      holds $1 in X;
    consider Y being Subset of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT) holds F in Y iff P[F]
      from SUBSET_1:sch 3;
    take Y;
    thus thesis by A1;
  end;
  uniqueness
  proof
    let Y1,Y2 be Subset of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT) holds F in Y1 iff
      for X being Subset of Funcs(NAT,NAT) st X is_closed_under I,U,B
      holds F in X and
    A2: for F being Element of Funcs(NAT,NAT) holds F in Y2 iff
      for X being Subset of Funcs(NAT,NAT) st X is_closed_under I,U,B
      holds F in X;
    defpred P[object] means
      for X being Subset of Funcs(NAT,NAT) st X is_closed_under I,U,B
      holds $1 in X;
    A3: for F being Element of Funcs(NAT,NAT) holds F in Y1 iff P[F] by A1;
    A4: for F being Element of Funcs(NAT,NAT) holds F in Y2 iff P[F] by A2;
    thus Y1 = Y2 from SUBSET_1:sch 2(A3,A4);
  end;
end;

reserve I,U,B for set;

theorem ClosInit:
  F in I implies F in clos(I,U,B)
proof
  assume A1: F in I;
  now
    let X be Subset of Funcs(NAT,NAT);
    assume X is_closed_under I,U,B;
    then I c= X by DefClosed;
    hence F in X by A1;
  end;
  hence thesis by DefClos;
end;

theorem ClosUnop:
  for u being UnOp of Funcs(NAT,NAT) st u in U & F in clos(I,U,B)
  holds u.F in clos(I,U,B)
proof
  let u be UnOp of Funcs(NAT,NAT);
  assume A1: u in U & F in clos(I,U,B);
  now
    let X be Subset of Funcs(NAT,NAT);
    assume A2: X is_closed_under I,U,B;
    then F in X by A1, DefClos;
    hence u.F in X by A1, A2, DefClosed;
  end;
  hence thesis by DefClos;
end;

theorem ClosBinop:
  for b being BinOp of Funcs(NAT,NAT) st b in B & F in clos(I,U,B) &
  G in clos(I,U,B) holds b.(F,G) in clos(I,U,B)
proof
  let b be BinOp of Funcs(NAT,NAT);
  assume A1: b in B & F in clos(I,U,B) & G in clos(I,U,B);
  now
    let X be Subset of Funcs(NAT,NAT);
    assume A2: X is_closed_under I,U,B;
    then F in X & G in X by A1, DefClos;
    hence b.(F,G) in X by A1, A2, DefClosed;
  end;
  hence thesis by DefClos;
end;

theorem ClosLeast:
  for X being Subset of Funcs(NAT,NAT) st X is_closed_under I,U,B
  holds clos(I,U,B) c= X
proof
  let X be Subset of Funcs(NAT,NAT);
  assume A1: X is_closed_under I,U,B;
  let F be object;
  assume A2: F in clos(I,U,B);
  then reconsider F as Element of Funcs(NAT,NAT);
  thus thesis by A1, A2, DefClos;
end;

theorem ClosClosed:
  I c= Funcs(NAT,NAT) implies clos(I,U,B) is_closed_under I,U,B
proof
  assume A1: I c= Funcs(NAT,NAT);
  thus I c= clos(I,U,B)
  proof
    let F be object;
    assume A2: F in I;
    then F in Funcs(NAT,NAT) by A1;
    hence thesis by A2, ClosInit;
  end;
  thus thesis by ClosUnop, ClosBinop;
end;

:: Arithmetic facts about Rt and E used silently in the paper

theorem RtSqAdd:
  k <= 2*m implies funRt.(m*m+k) = m
proof
  assume A1: k <= 2*m;
  A2: m*m <= m*m+k by NAT_1:11;
  2*m < 2*m+1 by NAT_1:13;
  then k < 2*m+1 by A1, XXREAL_0:2;
  then m*m+k < m*m+(2*m+1) by XREAL_1:6;
  then m*m+k < (m+1)*(m+1);
  hence thesis by A2, RtI;
end;

theorem RtSq:
  funRt.(m*m) = m
proof
  m*m < m*m + (2*m+1) by XREAL_1:29;
  then m*m < (m+1)*(m+1);
  hence thesis by RtI;
end;

theorem EVal:
  funE.x + funRt.x * funRt.x = x
proof
  A1: funRt.x * funRt.x <= x by DefRt;
  funE.x = x -' funRt.x * funRt.x by DefE;
  hence thesis by A1, XREAL_1:235;
end;

theorem ESqAdd:
  k <= 2*m implies funE.(m*m+k) = k
proof
  assume k <= 2*m;
  then funRt.(m*m+k) = m by RtSqAdd;
  then funE.(m*m+k) = k + m*m -' m*m by DefE;
  hence thesis by NAT_D:34;
end;

theorem ELe:
  funE.x <= x
proof
  funE.x + funRt.x * funRt.x = x by EVal;
  hence thesis by NAT_1:11;
end;

:: Robinson's difference formula: if b <= a then
:: a - b = E((a+b)^2 + 3a + b + 1)
theorem RobDiffE:
  for a,b being Nat st b <= a holds
  funE.((a+b)*(a+b) + 3*a + b + 1) = a -' b
proof
  let a,b be Nat;
  assume b <= a;
  then A1: (a -' b) + b = a by XREAL_1:235;
  set d = a -' b;
  A2: (a+b)*(a+b) + 3*a + b + 1 = (2*b+d+1)*(2*b+d+1) + d by A1;
  2*(2*b+d+1) = d + (4*b+d+2);
  then d <= 2*(2*b+d+1) by NAT_1:11;
  hence thesis by A2, ESqAdd;
end;

begin

:: Section 6: iteration and the unary operator F^+.
:: The basis is <1, E, F^+, FG, F^box>.

reserve q,t for Nat;

theorem CompVal:
  (F*G).x = F.(G.x)
proof
  x in NAT by ORDINAL1:def 12;
  hence thesis by FUNCT_2:15;
end;

:: The closure of the basis <1, E, F^+, FG, F^box>

definition
  func C6 -> Subset of Funcs(NAT,NAT) equals
  clos({cst 1, funE}, {opPlusI, opBox}, {opComp});
  coherence;
end;

theorem C6One:
  cst 1 in C6
proof
  cst 1 in {cst 1, funE} by TARSKI:def 2;
  hence thesis by ClosInit;
end;

theorem C6E:
  funE in C6
proof
  funE in {cst 1, funE} by TARSKI:def 2;
  hence thesis by ClosInit;
end;

theorem C6PlusI:
  F in C6 implies opPlusI.F in C6
proof
  assume A1: F in C6;
  opPlusI in {opPlusI, opBox} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem C6Box:
  F in C6 implies opBox.F in C6
proof
  assume A1: F in C6;
  opBox in {opPlusI, opBox} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem C6Comp:
  F in C6 & G in C6 implies F*G in C6
proof
  assume A1: F in C6 & G in C6;
  A2: opComp in {opComp} by TARSKI:def 1;
  opComp.(F,G) = F*G by DefComp;
  hence thesis by A1, A2, ClosBinop;
end;

:: Small values of Rt and E

theorem ESmall:
  funE.0 = 0 & funE.1 = 0 & funE.2 = 1 & funE.3 = 2 & funE.4 = 0
proof
  0*0 <= 0 & 0 < (0+1)*(0+1);
  then A0: funRt.0 = 0 by RtI;
  1*1 <= 1 & 1 < (1+1)*(1+1);
  then A1: funRt.1 = 1 by RtI;
  1*1 <= 2 & 2 < (1+1)*(1+1);
  then A2: funRt.2 = 1 by RtI;
  1*1 <= 3 & 3 < (1+1)*(1+1);
  then A3: funRt.3 = 1 by RtI;
  2*2 <= 4 & 4 < (2+1)*(2+1);
  then A4: funRt.4 = 2 by RtI;
  funE.0 = 0 -' 0*0 by A0, DefE;
  hence funE.0 = 0 by XREAL_1:232;
  funE.1 = 1 -' 1*1 by A1, DefE;
  hence funE.1 = 0 by XREAL_1:232;
  funE.2 = 2 -' 1*1 by A2, DefE .= 2 - 1 by XREAL_1:233;
  hence funE.2 = 1;
  funE.3 = 3 -' 1*1 by A3, DefE .= 3 - 1 by XREAL_1:233;
  hence funE.3 = 2;
  funE.4 = 4 -' 2*2 by A4, DefE;
  hence funE.4 = 0 by XREAL_1:232;
end;

theorem ESquare:
  funE.x = 0 iff ex k st x = k*k
proof
  thus funE.x = 0 implies ex k st x = k*k
  proof
    assume A1: funE.x = 0;
    take funRt.x;
    funE.x + funRt.x * funRt.x = x by EVal;
    hence thesis by A1;
  end;
  given k such that A2: x = k*k;
  funRt.(k*k) = k by RtSq;
  then funE.(k*k) = k*k -' k*k by DefE;
  hence thesis by A2, XREAL_1:232;
end;

:: Auxiliary functions named in Section 6

definition
  func funMod3 -> Element of Funcs(NAT,NAT) means :DefMod3:
  for x being Nat holds it.x = x mod 3;
  existence
  proof
    deffunc T(Nat) = $1 mod 3;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1 mod 3;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

definition
  func funM3 -> Element of Funcs(NAT,NAT) means :DefM3:
  for x being Nat holds it.x = 3*x;
  existence
  proof
    deffunc T(Nat) = 3*$1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = 3*$1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: R(x) = x + 2 Rt(x), as in Lemma 5.7
definition
  func funR -> Element of Funcs(NAT,NAT) means :DefR:
  for x being Nat holds it.x = x + 2*(funRt.x);
  existence
  proof
    deffunc T(Nat) = $1 + 2*(funRt.$1);
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1 + 2*(funRt.$1);
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: characteristic function of the squares
definition
  func funQ -> Element of Funcs(NAT,NAT) means :DefQ:
  for x being Nat holds ((ex k being Nat st x = k*k) implies it.x = 1) &
    ((not ex k being Nat st x = k*k) implies it.x = 0);
  existence
  proof
    deffunc T(Nat) = 1 -' funE.$1;
    consider f being Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) from UFunEx;
    take f;
    let x be Nat;
    thus (ex k being Nat st x = k*k) implies f.x = 1
    proof
      assume ex k being Nat st x = k*k;
      then funE.x = 0 by ESquare;
      then f.x = 1 -' 0 by A1;
      hence thesis by NAT_D:40;
    end;
    assume not ex k being Nat st x = k*k;
    then funE.x <> 0 by ESquare;
    then 1 <= funE.x by NAT_1:14;
    then 1 -' funE.x = 0 by NAT_2:8;
    hence thesis by A1;
  end;
  uniqueness
  proof
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds ((ex k being Nat st x = k*k) implies f.x = 1) &
      ((not ex k being Nat st x = k*k) implies f.x = 0) and
    A2: for x being Nat holds ((ex k being Nat st x = k*k) implies g.x = 1) &
      ((not ex k being Nat st x = k*k) implies g.x = 0);
    now
      let x be Nat;
      per cases;
      suppose B1: ex k being Nat st x = k*k;
        thus f.x = 1 by A1, B1 .= g.x by A2, B1;
      end;
      suppose B1: not ex k being Nat st x = k*k;
        thus f.x = 0 by A1, B1 .= g.x by A2, B1;
      end;
    end;
    hence f = g by UFunExt;
  end;
end;

:: First functions in clos F

theorem SExpr:
  opPlusI.(cst 1) = funS
proof
  now
    let x;
    thus (opPlusI.(cst 1)).x = (cst 1).x + x by DefPlusI
      .= x + 1 by DefCst
      .= funS.x by DefS;
  end;
  hence thesis by UFunExt;
end;

theorem SgnExpr:
  opBox.(cst 1) = funSgn
proof
  now
    let x;
    per cases by NAT_1:6;
    suppose A1: x = 0;
      hence (opBox.(cst 1)).x = 0 by DefBox .= funSgn.x by A1, DefSgn;
    end;
    suppose ex y st x = y+1;
      then consider y such that A1: x = y+1;
      thus (opBox.(cst 1)).x = (cst 1).((opBox.(cst 1)).y) by A1, DefBox
        .= 1 by DefCst
        .= funSgn.x by A1, DefSgn;
    end;
  end;
  hence thesis by UFunExt;
end;

theorem ZeroExpr:
  funE*(cst 1) = cst 0
proof
  now
    let x;
    thus (funE*(cst 1)).x = funE.((cst 1).x) by CompVal
      .= funE.1 by DefCst
      .= 0 by ESmall
      .= (cst 0).x by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem DExpr:
  opPlusI.(opPlusI.(cst 0)) = funD
proof
  now
    let x;
    thus (opPlusI.(opPlusI.(cst 0))).x = (opPlusI.(cst 0)).x + x by DefPlusI
      .= (cst 0).x + x + x by DefPlusI
      .= 0 + x + x by DefCst
      .= 2*x
      .= funD.x by DefD;
  end;
  hence thesis by UFunExt;
end;

theorem M3Expr:
  opPlusI.funD = funM3
proof
  now
    let x;
    thus (opPlusI.funD).x = funD.x + x by DefPlusI
      .= 2*x + x by DefD
      .= 3*x
      .= funM3.x by DefM3;
  end;
  hence thesis by UFunExt;
end;

theorem OExpr:
  funE*funD*funS*funSgn = funO
proof
  now
    let x;
    A1: (funE*funD*funS*funSgn).x = (funE*funD*funS).(funSgn.x) by CompVal
      .= (funE*funD).(funS.(funSgn.x)) by CompVal
      .= funE.(funD.(funS.(funSgn.x))) by CompVal
      .= funE.(funD.(funSgn.x + 1)) by DefS
      .= funE.(2*(funSgn.x + 1)) by DefD;
    per cases;
    suppose A2: x = 0;
      then funSgn.x = 0 by DefSgn;
      hence (funE*funD*funS*funSgn).x = 1 by A1, ESmall
        .= funO.x by A2, DefO;
    end;
    suppose A2: x <> 0;
      then funSgn.x = 1 by DefSgn;
      hence (funE*funD*funS*funSgn).x = 0 by A1, ESmall
        .= funO.x by A2, DefO;
    end;
  end;
  hence thesis by UFunExt;
end;

theorem QExpr:
  funO*funE = funQ
proof
  now
    let x;
    A1: (funO*funE).x = funO.(funE.x) by CompVal;
    per cases;
    suppose A2: ex k st x = k*k;
      then funE.x = 0 by ESquare;
      hence (funO*funE).x = 1 by A1, DefO .= funQ.x by A2, DefQ;
    end;
    suppose A2: not ex k st x = k*k;
      then funE.x <> 0 by ESquare;
      hence (funO*funE).x = 0 by A1, DefO .= funQ.x by A2, DefQ;
    end;
  end;
  hence thesis by UFunExt;
end;

theorem ESSVal:
  (funE*funS*funS).x = funE.(x+2)
proof
  thus (funE*funS*funS).x = (funE*funS).(funS.x) by CompVal
    .= funE.(funS.(funS.x)) by CompVal
    .= funE.(funS.(x+1)) by DefS
    .= funE.(x+1+1) by DefS
    .= funE.(x+2);
end;

theorem Mod3Expr:
  opBox.(funE*funS*funS) = funMod3
proof
  set B = opBox.(funE*funS*funS);
  defpred P[Nat] means B.(3*$1) = 0 & B.(3*$1+1) = 1 & B.(3*$1+2) = 2;
  A1: B.(0+1) = (funE*funS*funS).(B.0) by DefBox
    .= (funE*funS*funS).0 by DefBox
    .= funE.(0+2) by ESSVal
    .= 1 by ESmall;
  B.(1+1) = (funE*funS*funS).(B.1) by DefBox
    .= funE.(1+2) by A1, ESSVal
    .= 2 by ESmall;
  then A2: P[0] by A1, DefBox;
  A3: for q st P[q] holds P[q+1]
  proof
    let q;
    assume A4: P[q];
    A5: B.(3*(q+1)) = B.((3*q+2)+1)
      .= (funE*funS*funS).(B.(3*q+2)) by DefBox
      .= funE.(2+2) by A4, ESSVal
      .= 0 by ESmall;
    A6: B.(3*(q+1)+1) = (funE*funS*funS).(B.(3*(q+1))) by DefBox
      .= funE.(0+2) by A5, ESSVal
      .= 1 by ESmall;
    B.(3*(q+1)+2) = B.((3*(q+1)+1)+1)
      .= (funE*funS*funS).(B.(3*(q+1)+1)) by DefBox
      .= funE.(1+2) by A6, ESSVal
      .= 2 by ESmall;
    hence thesis by A5, A6;
  end;
  A7: for q holds P[q] from NAT_1:sch 2(A2,A3);
  now
    let x;
    set q = x div 3, r = x mod 3;
    A8: x = 3*q + r by NAT_D:2;
    A9: funMod3.x = r by DefMod3;
    A10: P[q] by A7;
    r < 3 by NAT_D:1;
    then r = 0 or r = 1 or r = 2 by NUMBER13:1;
    hence B.x = funMod3.x by A8, A9, A10;
  end;
  hence thesis by UFunExt;
end;

:: R(x) = x + 2 Rt(x) is in clos F (Lemma 5.7 technique)

theorem NotSquare:
  m*m < x & x < (m+1)*(m+1) implies not ex k st x = k*k
proof
  assume A1: m*m < x & x < (m+1)*(m+1);
  given k such that A2: x = k*k;
  per cases;
  suppose k <= m;
    then k*k <= m*m by XREAL_1:66;
    hence contradiction by A1, A2;
  end;
  suppose m < k;
    then m+1 <= k by NAT_1:13;
    then (m+1)*(m+1) <= k*k by XREAL_1:66;
    hence contradiction by A1, A2;
  end;
end;

theorem RStep:
  (opPlusI.(funD*funQ*funS*funS*funS)).(funS.(funR.n)) = funR.(n+1)
proof
  set r = funRt.n;
  set v = funS.(funR.n);
  A1: r*r <= n & n < (r+1)*(r+1) by DefRt;
  A2: v = funR.n + 1 by DefS .= n + 2*r + 1 by DefR;
  A3: (funD*funQ*funS*funS*funS).v
      = (funD*funQ*funS*funS).(funS.v) by CompVal
     .= (funD*funQ*funS).(funS.(funS.v)) by CompVal
     .= (funD*funQ).(funS.(funS.(funS.v))) by CompVal
     .= funD.(funQ.(funS.(funS.(funS.v)))) by CompVal
     .= 2*(funQ.(funS.(funS.(funS.v)))) by DefD;
  A4: funS.(funS.(funS.v)) = funS.(funS.(v+1)) by DefS
     .= funS.(v+1+1) by DefS
     .= v+1+1+1 by DefS
     .= n + 2*r + 4 by A2;
  A5: (opPlusI.(funD*funQ*funS*funS*funS)).v
      = (funD*funQ*funS*funS*funS).v + v by DefPlusI
     .= 2*(funQ.(n + 2*r + 4)) + (n + 2*r + 1) by A2, A3, A4;
  n+1 <= (r+1)*(r+1) by A1, NAT_1:13;
  then per cases by XXREAL_0:1;
  suppose A6: n+1 = (r+1)*(r+1);
    A7: (r+1)*(r+1) <= n+1 by A6;
    (r+1+1)*(r+1+1) = (r+1)*(r+1) + (2*r+3);
    then n+1 < (r+1+1)*(r+1+1) by A6, XREAL_1:29;
    then A8: funRt.(n+1) = r+1 by A7, RtI;
    n + 2*r + 4 = (r+2)*(r+2) by A6;
    then funQ.(n + 2*r + 4) = 1 by DefQ;
    hence (opPlusI.(funD*funQ*funS*funS*funS)).(funS.(funR.n))
      = 2*1 + (n + 2*r + 1) by A5
     .= (n+1) + 2*(r+1)
     .= funR.(n+1) by A8, DefR;
  end;
  suppose A6: n+1 < (r+1)*(r+1);
    r*r <= n+1 by A1, NAT_1:13;
    then A8: funRt.(n+1) = r by A6, RtI;
    n+1+1 <= (r+1)*(r+1) by A6, NAT_1:13;
    then n+1+1 + (2*r+2) <= (r+1)*(r+1) + (2*r + 2) by XREAL_1:6;
    then A9: n + 2*r + 4 <= (r+1)*(r+1) + (2*r + 2);
    (r+1)*(r+1) + (2*r+2) < (r+1)*(r+1) + (2*r+2) + 1 by XREAL_1:29;
    then n + 2*r + 4 < (r+1)*(r+1) + (2*r+2) + 1 by A9, XXREAL_0:2;
    then A10: n + 2*r + 4 < (r+1+1)*(r+1+1);
    r*r + (2*r+1) <= n + (2*r+1) by A1, XREAL_1:6;
    then A11: (r+1)*(r+1) <= n + 2*r + 1;
    n + 2*r + 1 < n + 2*r + 1 + 3 by XREAL_1:29;
    then (r+1)*(r+1) < n + 2*r + 1 + 3 by A11, XXREAL_0:2;
    then (r+1)*(r+1) < n + 2*r + 4;
    then not ex k st n + 2*r + 4 = k*k by A10, NotSquare;
    then funQ.(n + 2*r + 4) = 0 by DefQ;
    hence (opPlusI.(funD*funQ*funS*funS*funS)).(funS.(funR.n))
      = (n+1) + 2*r by A5
     .= funR.(n+1) by A8, DefR;
  end;
end;

theorem RExpr:
  opBox.((opPlusI.(funD*funQ*funS*funS*funS))*funS) = funR
proof
  set B = opBox.((opPlusI.(funD*funQ*funS*funS*funS))*funS);
  defpred P[Nat] means B.$1 = funR.$1;
  0*0 <= 0 & 0 < (0+1)*(0+1);
  then funRt.0 = 0 by RtI;
  then funR.0 = 0 + 2*0 by DefR;
  then A1: P[0] by DefBox;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    thus B.(n+1) = ((opPlusI.(funD*funQ*funS*funS*funS))*funS).(B.n) by DefBox
      .= (opPlusI.(funD*funQ*funS*funS*funS)).(funS.(funR.n)) by A3, CompVal
      .= funR.(n+1) by RStep;
  end;
  for n holds P[n] from NAT_1:sch 2(A1,A2);
  hence thesis by UFunExt;
end;

theorem SqExpr:
  opBox.(funS*funR) = funSq
proof
  set B = opBox.(funS*funR);
  defpred P[Nat] means B.$1 = $1*$1;
  A1: P[0] by DefBox;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    A4: funRt.(n*n) = n by RtSq;
    thus B.(n+1) = (funS*funR).(B.n) by DefBox
      .= funS.(funR.(n*n)) by A3, CompVal
      .= funR.(n*n) + 1 by DefS
      .= n*n + 2*n + 1 by A4, DefR
      .= (n+1)*(n+1);
  end;
  A5: for n holds P[n] from NAT_1:sch 2(A1,A2);
  now
    let n;
    thus B.n = n*n by A5 .= funSq.n by DefSq;
  end;
  hence thesis by UFunExt;
end;

theorem SIn: funS in C6 by C6One, C6PlusI, SExpr;
theorem SgnIn: funSgn in C6 by C6One, C6Box, SgnExpr;
theorem ZeroIn: cst 0 in C6 by C6One, C6E, C6Comp, ZeroExpr;
theorem DIn:
  funD in C6
proof
  opPlusI.(cst 0) in C6 by ZeroIn, C6PlusI;
  hence thesis by C6PlusI, DExpr;
end;
theorem M3In: funM3 in C6 by DIn, C6PlusI, M3Expr;

theorem OIn:
  funO in C6
proof
  funE*funD in C6 by C6E, DIn, C6Comp;
  then funE*funD*funS in C6 by SIn, C6Comp;
  then funE*funD*funS*funSgn in C6 by SgnIn, C6Comp;
  hence thesis by OExpr;
end;

theorem QIn: funQ in C6 by OIn, C6E, C6Comp, QExpr;

theorem Mod3In:
  funMod3 in C6
proof
  funE*funS in C6 by C6E, SIn, C6Comp;
  then funE*funS*funS in C6 by SIn, C6Comp;
  hence thesis by C6Box, Mod3Expr;
end;

theorem RIn:
  funR in C6
proof
  funD*funQ in C6 by DIn, QIn, C6Comp;
  then funD*funQ*funS in C6 by SIn, C6Comp;
  then funD*funQ*funS*funS in C6 by SIn, C6Comp;
  then funD*funQ*funS*funS*funS in C6 by SIn, C6Comp;
  then opPlusI.(funD*funQ*funS*funS*funS) in C6 by C6PlusI;
  then (opPlusI.(funD*funQ*funS*funS*funS))*funS in C6 by SIn, C6Comp;
  hence thesis by C6Box, RExpr;
end;

theorem SqIn:
  funSq in C6
proof
  funS*funR in C6 by SIn, RIn, C6Comp;
  hence thesis by C6Box, SqExpr;
end;

:: Definition 6.1 (the operators are meaningful when F(x) >= x, G(x) >= x
:: and, for F (-) G, F(x) >= G(x)^2; -' is the arithmetic difference)

:: F^-(x) = F(x) - x
definition
  func opMinusI -> UnOp of Funcs(NAT,NAT) means :DefMinusI:
  for F being Element of Funcs(NAT,NAT), x being Nat holds
    (it.F).x = F.x -' x;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = $1.$2 -' $2;
    thus ex u being UnOp of Funcs(NAT,NAT) st
      for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) from UOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = $1.$2 -' $2;
    let u,v be UnOp of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) and
    A2: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (v.F).x = T(F,x);
    thus u = v from UOpUq(A1,A2);
  end;
end;

:: (F (+) G)(x) = F(x) + G(x)^2
definition
  func opOplus -> BinOp of Funcs(NAT,NAT) means :DefOplus:
  for F,G being Element of Funcs(NAT,NAT), x being Nat holds
    (it.(F,G)).x = F.x + G.x * G.x;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 + $2.$3 * $2.$3;
    thus ex b being BinOp of Funcs(NAT,NAT) st
      for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) from BOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 + $2.$3 * $2.$3;
    let b,c be BinOp of Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) and
    A2: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (c.(F,G)).x = T(F,G,x);
    thus b = c from BOpUq(A1,A2);
  end;
end;

:: (F (-) G)(x) = F(x) - G(x)^2
definition
  func opOminus -> BinOp of Funcs(NAT,NAT) means :DefOminus:
  for F,G being Element of Funcs(NAT,NAT), x being Nat holds
    (it.(F,G)).x = F.x -' G.x * G.x;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 -' $2.$3 * $2.$3;
    thus ex b being BinOp of Funcs(NAT,NAT) st
      for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) from BOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 -' $2.$3 * $2.$3;
    let b,c be BinOp of Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) and
    A2: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (c.(F,G)).x = T(F,G,x);
    thus b = c from BOpUq(A1,A2);
  end;
end;

:: (F (x) G)(x) = F(x) G(x)
definition
  func opOtimes -> BinOp of Funcs(NAT,NAT) means :DefOtimes:
  for F,G being Element of Funcs(NAT,NAT), x being Nat holds
    (it.(F,G)).x = F.x * G.x;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 * $2.$3;
    thus ex b being BinOp of Funcs(NAT,NAT) st
      for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) from BOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      $1.$3 * $2.$3;
    let b,c be BinOp of Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) and
    A2: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (c.(F,G)).x = T(F,G,x);
    thus b = c from BOpUq(A1,A2);
  end;
end;

:: Lemma 6.2: F^- = E S (M3 F E)^+ (Sq F^+)^+

definition
  let F be Element of Funcs(NAT,NAT);
  func exprMinusI F -> Element of Funcs(NAT,NAT) equals
  funE*funS*(opPlusI.(funM3*F*funE))*(opPlusI.(funSq*(opPlusI.F)));
  coherence;
end;

theorem MinusIExprIn:
  F in C6 implies exprMinusI F in C6
proof
  assume A1: F in C6;
  A2: funE*funS in C6 by C6E, SIn, C6Comp;
  funM3*F in C6 by A1, M3In, C6Comp;
  then funM3*F*funE in C6 by C6E, C6Comp;
  then opPlusI.(funM3*F*funE) in C6 by C6PlusI;
  then A3: funE*funS*(opPlusI.(funM3*F*funE)) in C6 by A2, C6Comp;
  opPlusI.F in C6 by A1, C6PlusI;
  then funSq*(opPlusI.F) in C6 by SqIn, C6Comp;
  then opPlusI.(funSq*(opPlusI.F)) in C6 by C6PlusI;
  hence thesis by A3, C6Comp;
end;

:: pointwise correctness: only F(x) >= x at the point x is needed
theorem MinusIExprVal:
  x <= F.x implies (exprMinusI F).x = F.x -' x
proof
  assume A1: x <= F.x;
  set a = F.x;
  set y = (a+x)*(a+x) + x;
  A2: (opPlusI.(funSq*(opPlusI.F))).x = (funSq*(opPlusI.F)).x + x by DefPlusI
     .= funSq.((opPlusI.F).x) + x by CompVal
     .= funSq.(a + x) + x by DefPlusI
     .= y by DefSq;
  2*(a+x) = x + (2*a + x);
  then x <= 2*(a+x) by NAT_1:11;
  then A3: funE.y = x by ESqAdd;
  A4: (opPlusI.(funM3*F*funE)).y = (funM3*F*funE).y + y by DefPlusI
     .= (funM3*F).(funE.y) + y by CompVal
     .= funM3.(F.x) + y by A3, CompVal
     .= 3*a + y by DefM3;
  thus (exprMinusI F).x
      = (funE*funS*(opPlusI.(funM3*F*funE))).(y) by A2, CompVal
     .= (funE*funS).(3*a + y) by A4, CompVal
     .= funE.(funS.(3*a + y)) by CompVal
     .= funE.(3*a + y + 1) by DefS
     .= funE.((a+x)*(a+x) + 3*a + x + 1)
     .= a -' x by A1, RobDiffE;
end;

theorem Lemma62:
  F in C6 & (for x holds x <= F.x) implies opMinusI.F in C6
proof
  assume that A1: F in C6 and A2: for x holds x <= F.x;
  now
    let x;
    thus (exprMinusI F).x = F.x -' x by A2, MinusIExprVal
      .= (opMinusI.F).x by DefMinusI;
  end;
  then exprMinusI F = opMinusI.F by UFunExt;
  hence thesis by A1, MinusIExprIn;
end;

:: Lemma 6.3: Hf = ((S Mod3^+)^box)^- and Rt = Hf R^-

theorem HfAux:
  (opBox.(funS*(opPlusI.funMod3))).(2*q) = 3*q &
  (opBox.(funS*(opPlusI.funMod3))).(2*q+1) = 3*q+1
proof
  set B = opBox.(funS*(opPlusI.funMod3));
  A0: for y holds B.(y+1) = funMod3.(B.y) + B.y + 1
  proof
    let y;
    thus B.(y+1) = (funS*(opPlusI.funMod3)).(B.y) by DefBox
      .= funS.((opPlusI.funMod3).(B.y)) by CompVal
      .= (opPlusI.funMod3).(B.y) + 1 by DefS
      .= funMod3.(B.y) + B.y + 1 by DefPlusI;
  end;
  defpred P[Nat] means B.(2*$1) = 3*$1 & B.(2*$1+1) = 3*$1+1;
  A1: for q holds B.(2*q) = 3*q implies B.(2*q+1) = 3*q+1
  proof
    let q;
    assume A2: B.(2*q) = 3*q;
    A3: funMod3.(3*q) = (3*q) mod 3 by DefMod3 .= 0 by NAT_D:13;
    thus B.(2*q+1) = funMod3.(B.(2*q)) + B.(2*q) + 1 by A0
      .= 3*q+1 by A2, A3;
  end;
  B.(2*0) = 3*0 by DefBox;
  then A4: P[0] by A1;
  A5: for q st P[q] holds P[q+1]
  proof
    let q;
    assume A6: P[q];
    A7: funMod3.(3*q+1) = (3*q+1) mod 3 by DefMod3
      .= 1 mod 3 by NAT_D:21
      .= 1 by NAT_D:24;
    B.(2*(q+1)) = B.((2*q+1)+1)
      .= funMod3.(B.(2*q+1)) + B.(2*q+1) + 1 by A0
      .= 1 + (3*q+1) + 1 by A6, A7
      .= 3*(q+1);
    hence thesis by A1;
  end;
  for q holds P[q] from NAT_1:sch 2(A4,A5);
  hence thesis;
end;

theorem HfAux2:
  (opBox.(funS*(opPlusI.funMod3))).x = x + (x div 2)
proof
  set B = opBox.(funS*(opPlusI.funMod3));
  set q = x div 2;
  A1: x = 2*q + (x mod 2) by NAT_D:2;
  per cases by NAT_D:12;
  suppose x mod 2 = 0;
    then A3: x = 2*q by A1;
    hence B.x = 3*q by HfAux .= x + q by A3;
  end;
  suppose A2: x mod 2 = 1;
    then x = 2*q+1 by A1;
    hence B.x = 3*q+1 by HfAux .= x + q by A1, A2;
  end;
end;

definition
  func exprHf -> Element of Funcs(NAT,NAT) equals
  exprMinusI (opBox.(funS*(opPlusI.funMod3)));
  coherence;
end;

definition
  func exprRt -> Element of Funcs(NAT,NAT) equals
  funHf*(exprMinusI funR);
  coherence;
end;

theorem HfExpr:
  exprHf = funHf
proof
  set B = opBox.(funS*(opPlusI.funMod3));
  now
    let x;
    A1: B.x = x + (x div 2) by HfAux2;
    then x <= B.x by NAT_1:11;
    hence exprHf.x = B.x -' x by MinusIExprVal
      .= (x div 2) + x -' x by A1
      .= x div 2 by NAT_D:34
      .= funHf.x by DefHf;
  end;
  hence thesis by UFunExt;
end;

theorem RtExpr:
  exprRt = funRt
proof
  now
    let x;
    A1: funR.x = 2*(funRt.x) + x by DefR;
    then x <= funR.x by NAT_1:11;
    then A2: (exprMinusI funR).x = funR.x -' x by MinusIExprVal
      .= 2*(funRt.x) by A1, NAT_D:34;
    thus exprRt.x = funHf.((exprMinusI funR).x) by CompVal
      .= (2*(funRt.x)) div 2 by A2, DefHf
      .= funRt.x by NAT_D:18;
  end;
  hence thesis by UFunExt;
end;

theorem Lemma63:
  funHf in C6 & funRt in C6
proof
  opPlusI.funMod3 in C6 by Mod3In, C6PlusI;
  then A1: funS*(opPlusI.funMod3) in C6 by SIn, C6Comp;
  then opBox.(funS*(opPlusI.funMod3)) in C6 by C6Box;
  then A2: exprHf in C6 by MinusIExprIn;
  hence funHf in C6 by HfExpr;
  exprMinusI funR in C6 by RIn, MinusIExprIn;
  then exprRt in C6 by A2, HfExpr, C6Comp;
  hence thesis by RtExpr;
end;

theorem HfIn: funHf in C6 by Lemma63;
theorem RtIn: funRt in C6 by Lemma63;

theorem LeSq:
  n <= n*n
proof
  per cases by NAT_1:14;
  suppose n = 0;
    hence thesis;
  end;
  suppose 1 <= n;
    then n*1 <= n*n by XREAL_1:64;
    hence thesis;
  end;
end;

:: Lemma 6.4: F (+) G = (F^- E)^+ (Sq G)^+ and F (-) G = (F^+ E)^- (Sq G)^+

definition
  let F,G be Element of Funcs(NAT,NAT);
  func exprOplus(F,G) -> Element of Funcs(NAT,NAT) equals
  (opPlusI.((exprMinusI F)*funE))*(opPlusI.(funSq*G));
  coherence;
  func exprOminus(F,G) -> Element of Funcs(NAT,NAT) equals
  (exprMinusI((opPlusI.F)*funE))*(opPlusI.(funSq*G));
  coherence;
end;

theorem OplusExprIn:
  F in C6 & G in C6 implies exprOplus(F,G) in C6
proof
  assume A1: F in C6 & G in C6;
  then exprMinusI F in C6 by MinusIExprIn;
  then (exprMinusI F)*funE in C6 by C6E, C6Comp;
  then A2: opPlusI.((exprMinusI F)*funE) in C6 by C6PlusI;
  funSq*G in C6 by A1, SqIn, C6Comp;
  then opPlusI.(funSq*G) in C6 by C6PlusI;
  hence thesis by A2, C6Comp;
end;

theorem OminusExprIn:
  F in C6 & G in C6 implies exprOminus(F,G) in C6
proof
  assume A1: F in C6 & G in C6;
  then opPlusI.F in C6 by C6PlusI;
  then (opPlusI.F)*funE in C6 by C6E, C6Comp;
  then A2: exprMinusI((opPlusI.F)*funE) in C6 by MinusIExprIn;
  funSq*G in C6 by A1, SqIn, C6Comp;
  then opPlusI.(funSq*G) in C6 by C6PlusI;
  hence thesis by A2, C6Comp;
end;

:: if G(x) >= x then (Sq G)^+(x) = G(x)^2 + x and E(G(x)^2 + x) = x
theorem SqGVal:
  x <= G.x implies (opPlusI.(funSq*G)).x = G.x * G.x + x &
  funE.(G.x * G.x + x) = x
proof
  assume A1: x <= G.x;
  thus (opPlusI.(funSq*G)).x = (funSq*G).x + x by DefPlusI
    .= funSq.(G.x) + x by CompVal
    .= G.x * G.x + x by DefSq;
  2*(G.x) = G.x + G.x;
  then G.x <= 2*(G.x) by NAT_1:11;
  then x <= 2*(G.x) by A1, XXREAL_0:2;
  hence thesis by ESqAdd;
end;

theorem OplusExprVal:
  x <= F.x & x <= G.x implies exprOplus(F,G).x = F.x + G.x * G.x
proof
  assume that A1: x <= F.x and A2: x <= G.x;
  set y = G.x * G.x + x;
  A3: (opPlusI.(funSq*G)).x = y & funE.y = x by A2, SqGVal;
  A4: (F.x -' x) + x = F.x by A1, XREAL_1:235;
  thus exprOplus(F,G).x = (opPlusI.((exprMinusI F)*funE)).y by A3, CompVal
    .= ((exprMinusI F)*funE).y + y by DefPlusI
    .= (exprMinusI F).x + y by A3, CompVal
    .= (F.x -' x) + y by A1, MinusIExprVal
    .= (F.x -' x) + x + G.x * G.x
    .= F.x + G.x * G.x by A4;
end;

theorem OminusExprVal:
  x <= G.x & G.x * G.x <= F.x implies
  exprOminus(F,G).x = F.x -' G.x * G.x
proof
  assume that A1: x <= G.x and A2: G.x * G.x <= F.x;
  set y = G.x * G.x + x;
  set H = (opPlusI.F)*funE;
  A3: (opPlusI.(funSq*G)).x = y & funE.y = x by A1, SqGVal;
  A4: H.y = (opPlusI.F).x by A3, CompVal .= F.x + x by DefPlusI;
  then A5: y <= H.y by A2, XREAL_1:6;
  thus exprOminus(F,G).x = (exprMinusI H).y by A3, CompVal
    .= H.y -' y by A5, MinusIExprVal
    .= (F.x + x) - (G.x * G.x + x) by A4, A5, XREAL_1:233
    .= F.x - G.x * G.x
    .= F.x -' G.x * G.x by A2, XREAL_1:233;
end;

theorem Lemma64:
  F in C6 & G in C6 & (for x holds x <= F.x) & (for x holds x <= G.x) implies
  opOplus.(F,G) in C6 &
  ((for x holds G.x * G.x <= F.x) implies opOminus.(F,G) in C6)
proof
  assume that A1: F in C6 & G in C6 and A2: for x holds x <= F.x and
    A3: for x holds x <= G.x;
  now
    let x;
    A4: x <= F.x & x <= G.x by A2, A3;
    thus exprOplus(F,G).x = F.x + G.x * G.x by A4, OplusExprVal
      .= (opOplus.(F,G)).x by DefOplus;
  end;
  then exprOplus(F,G) = opOplus.(F,G) by UFunExt;
  hence opOplus.(F,G) in C6 by A1, OplusExprIn;
  assume A5: for x holds G.x * G.x <= F.x;
  now
    let x;
    A6: x <= G.x & G.x * G.x <= F.x by A3, A5;
    thus exprOminus(F,G).x = F.x -' G.x * G.x by A6, OminusExprVal
      .= (opOminus.(F,G)).x by DefOminus;
  end;
  then exprOminus(F,G) = opOminus.(F,G) by UFunExt;
  hence thesis by A1, OminusExprIn;
end;

:: Lemma 6.5: P^ = ((Sq^+)^+)^+ (-) S, so that P^(x+1) = x, and
:: F (x) G = Rt((Hf Hf (Sq P^((Sq S Sq F (+) G) (-) Sq F) (-) Sq G)) (-) Sq F)

definition
  func exprPhat -> Element of Funcs(NAT,NAT) equals
  exprOminus(opPlusI.(opPlusI.(opPlusI.funSq)), funS);
  coherence;
end;

theorem PhatIn:
  exprPhat in C6
proof
  opPlusI.funSq in C6 by SqIn, C6PlusI;
  then opPlusI.(opPlusI.funSq) in C6 by C6PlusI;
  then opPlusI.(opPlusI.(opPlusI.funSq)) in C6 by C6PlusI;
  hence thesis by SIn, OminusExprIn;
end;

theorem PhatVal:
  exprPhat.(x+1) = x
proof
  set y = x+1;
  set F3 = opPlusI.(opPlusI.(opPlusI.funSq));
  A1: F3.y = (opPlusI.(opPlusI.funSq)).y + y by DefPlusI
    .= (opPlusI.funSq).y + y + y by DefPlusI
    .= funSq.y + y + y + y by DefPlusI
    .= y*y + y + y + y by DefSq;
  A2: funS.y = y + 1 by DefS;
  then A3: y <= funS.y by NAT_1:11;
  1 <= y by NAT_1:11;
  then 2*y + 1 <= 2*y + y by XREAL_1:6;
  then y*y + (2*y + 1) <= y*y + (2*y + y) by XREAL_1:6;
  then A4: funS.y * funS.y <= F3.y by A1, A2;
  thus exprPhat.y = F3.y -' funS.y * funS.y by A3, A4, OminusExprVal
    .= x + (y + 1)*(y + 1) -' (y + 1)*(y + 1) by A1, A2
    .= x by NAT_D:34;
end;

definition
  let F,G be Element of Funcs(NAT,NAT);
  func exprOtimes(F,G) -> Element of Funcs(NAT,NAT) equals
  funRt*exprOminus(funHf*funHf*exprOminus(funSq*exprPhat*
    exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F), funSq*G), funSq*F);
  coherence;
end;

theorem OtimesExprIn:
  F in C6 & G in C6 implies exprOtimes(F,G) in C6
proof
  assume A1: F in C6 & G in C6;
  A2: funSq*F in C6 by A1, SqIn, C6Comp;
  A3: funSq*G in C6 by A1, SqIn, C6Comp;
  funSq*funS in C6 by SqIn, SIn, C6Comp;
  then funSq*funS*funSq in C6 by SqIn, C6Comp;
  then funSq*funS*funSq*F in C6 by A1, C6Comp;
  then exprOplus(funSq*funS*funSq*F, G) in C6 by A1, OplusExprIn;
  then A4: exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F) in C6
    by A2, OminusExprIn;
  funSq*exprPhat in C6 by SqIn, PhatIn, C6Comp;
  then funSq*exprPhat*exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F)
    in C6 by A4, C6Comp;
  then A5: exprOminus(funSq*exprPhat*
    exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F), funSq*G) in C6
    by A3, OminusExprIn;
  funHf*funHf in C6 by HfIn, C6Comp;
  then funHf*funHf*exprOminus(funSq*exprPhat*
    exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F), funSq*G) in C6
    by A5, C6Comp;
  then exprOminus(funHf*funHf*exprOminus(funSq*exprPhat*
    exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F), funSq*G),
    funSq*F) in C6 by A2, OminusExprIn;
  hence thesis by RtIn, C6Comp;
end;

theorem OtimesExprVal:
  x <= F.x & x <= G.x implies exprOtimes(F,G).x = F.x * G.x
proof
  assume that A1: x <= F.x and A2: x <= G.x;
  set a = F.x, b = G.x;
  set H1 = exprOplus(funSq*funS*funSq*F, G);
  set H2 = exprOminus(H1, funSq*F);
  set H3 = funSq*exprPhat*H2;
  set H4 = exprOminus(H3, funSq*G);
  set H5 = funHf*funHf*H4;
  set H6 = exprOminus(H5, funSq*F);
  A3: (funSq*F).x = funSq.a by CompVal .= a*a by DefSq;
  A4: (funSq*G).x = funSq.b by CompVal .= b*b by DefSq;
  a <= a*a by LeSq;
  then A5: x <= (funSq*F).x by A1, A3, XXREAL_0:2;
  b <= b*b by LeSq;
  then A6: x <= (funSq*G).x by A2, A4, XXREAL_0:2;
  :: (Sq S Sq F (+) G)(x) = (a^2 + 1)^2 + b^2
  A7: (funSq*funS*funSq*F).x = (funSq*funS*funSq).a by CompVal
    .= (funSq*funS).(funSq.a) by CompVal
    .= funSq.(funS.(funSq.a)) by CompVal
    .= funSq.(funS.(a*a)) by DefSq
    .= funSq.(a*a + 1) by DefS
    .= (a*a + 1)*(a*a + 1) by DefSq;
  A40: a*a <= (a*a + 1) by NAT_1:11;
  a*a + 1 <= (a*a + 1)*(a*a + 1) by LeSq;
  then a*a <= (a*a + 1)*(a*a + 1) by A40, XXREAL_0:2;
  then x <= (funSq*funS*funSq*F).x by A5, A3, A7, XXREAL_0:2;
  then A8: H1.x = (a*a + 1)*(a*a + 1) + b*b by A2, A7, OplusExprVal;
  :: (-) Sq F gives 2a^2 + 1 + b^2
  (funSq*F).x * (funSq*F).x <= (funSq*F).x * (funSq*F).x + (2*(a*a) + 1 + b*b)
    by NAT_1:11;
  then (funSq*F).x * (funSq*F).x <= H1.x by A3, A8;
  then A9: H2.x = H1.x -' (funSq*F).x * (funSq*F).x by A5, OminusExprVal
    .= (2*(a*a) + 1 + b*b) + (a*a)*(a*a) -' (a*a)*(a*a) by A3, A8
    .= 2*(a*a) + b*b + 1 by NAT_D:34;
  :: Sq P^ gives (2a^2 + b^2)^2
  set c = 2*(a*a) + b*b;
  A10: H3.x = (funSq*exprPhat).(H2.x) by CompVal
    .= funSq.(exprPhat.(c + 1)) by A9, CompVal
    .= funSq.c by PhatVal
    .= c*c by DefSq;
  :: (-) Sq G gives 4a^4 + 4a^2b^2
  b*b <= c by NAT_1:11;
  then (b*b)*(b*b) <= c*c by XREAL_1:66;
  then A11: H4.x = H3.x -' (funSq*G).x * (funSq*G).x by A4, A6, A10,
      OminusExprVal
    .= (4*((a*a)*(a*a) + (a*a)*(b*b))) + (b*b)*(b*b) -' (b*b)*(b*b)
      by A4, A10
    .= 4*((a*a)*(a*a) + (a*a)*(b*b)) by NAT_D:34;
  :: Hf Hf gives a^4 + a^2b^2
  set w = (a*a)*(a*a) + (a*a)*(b*b);
  A12: H5.x = (funHf*funHf).(H4.x) by CompVal
    .= funHf.(funHf.(2*(2*w))) by A11, CompVal
    .= funHf.((2*(2*w)) div 2) by DefHf
    .= funHf.(2*w) by NAT_D:18
    .= (2*w) div 2 by DefHf
    .= w by NAT_D:18;
  :: (-) Sq F gives a^2b^2, and Rt gives ab
  (a*a)*(a*a) <= w by NAT_1:11;
  then A13: H6.x = H5.x -' (funSq*F).x * (funSq*F).x by A3, A5, A12,
      OminusExprVal
    .= (a*b)*(a*b) + (a*a)*(a*a) -' (a*a)*(a*a) by A3, A12
    .= (a*b)*(a*b) by NAT_D:34;
  thus exprOtimes(F,G).x = funRt.(H6.x) by CompVal
    .= a*b by A13, RtSq;
end;

theorem Lemma65:
  F in C6 & G in C6 & (for x holds x <= F.x) & (for x holds x <= G.x) implies
  opOtimes.(F,G) in C6
proof
  assume that A1: F in C6 & G in C6 and A2: for x holds x <= F.x and
    A3: for x holds x <= G.x;
  now
    let x;
    A4: x <= F.x & x <= G.x by A2, A3;
    thus exprOtimes(F,G).x = F.x * G.x by A4, OtimesExprVal
      .= (opOtimes.(F,G)).x by DefOtimes;
  end;
  then exprOtimes(F,G) = opOtimes.(F,G) by UFunExt;
  hence thesis by A1, OtimesExprIn;
end;

:: Lemma 6.6: F + G = ((Rt((D(F^+ (x) G^+) (+) F^+) (+) G^+))^-)^- and
:: F - G = E S (Sq(F + G) + M3 F + G)

definition
  let F,G be Element of Funcs(NAT,NAT);
  func exprPlus(F,G) -> Element of Funcs(NAT,NAT) equals
  exprMinusI(exprMinusI(funRt*exprOplus(exprOplus(funD*exprOtimes(
    opPlusI.F, opPlusI.G), opPlusI.F), opPlusI.G)));
  coherence;
end;

definition
  let F,G be Element of Funcs(NAT,NAT);
  func exprMinus(F,G) -> Element of Funcs(NAT,NAT) equals
  funE*funS*exprPlus(exprPlus(funSq*exprPlus(F,G), funM3*F), G);
  coherence;
end;

theorem PlusExprIn:
  F in C6 & G in C6 implies exprPlus(F,G) in C6
proof
  assume A1: F in C6 & G in C6;
  then A2: opPlusI.F in C6 & opPlusI.G in C6 by C6PlusI;
  then exprOtimes(opPlusI.F, opPlusI.G) in C6 by OtimesExprIn;
  then funD*exprOtimes(opPlusI.F, opPlusI.G) in C6 by DIn, C6Comp;
  then exprOplus(funD*exprOtimes(opPlusI.F, opPlusI.G), opPlusI.F) in C6
    by A2, OplusExprIn;
  then exprOplus(exprOplus(funD*exprOtimes(opPlusI.F, opPlusI.G),
    opPlusI.F), opPlusI.G) in C6 by A2, OplusExprIn;
  then funRt*exprOplus(exprOplus(funD*exprOtimes(opPlusI.F, opPlusI.G),
    opPlusI.F), opPlusI.G) in C6 by RtIn, C6Comp;
  then exprMinusI(funRt*exprOplus(exprOplus(funD*exprOtimes(
    opPlusI.F, opPlusI.G), opPlusI.F), opPlusI.G)) in C6 by MinusIExprIn;
  hence thesis by MinusIExprIn;
end;

theorem MinusExprIn:
  F in C6 & G in C6 implies exprMinus(F,G) in C6
proof
  assume A1: F in C6 & G in C6;
  then exprPlus(F,G) in C6 by PlusExprIn;
  then A2: funSq*exprPlus(F,G) in C6 by SqIn, C6Comp;
  funM3*F in C6 by A1, M3In, C6Comp;
  then exprPlus(funSq*exprPlus(F,G), funM3*F) in C6 by A2, PlusExprIn;
  then A3: exprPlus(exprPlus(funSq*exprPlus(F,G), funM3*F), G) in C6
    by A1, PlusExprIn;
  funE*funS in C6 by C6E, SIn, C6Comp;
  hence thesis by A3, C6Comp;
end;

theorem PlusExprVal:
  exprPlus(F,G).x = F.x + G.x
proof
  set a = F.x + x, b = G.x + x;
  A1: (opPlusI.F).x = a & (opPlusI.G).x = b by DefPlusI;
  A2: x <= a & x <= b by NAT_1:11;
  set T = exprOtimes(opPlusI.F, opPlusI.G);
  A3: T.x = a*b by A1, A2, OtimesExprVal;
  A4: x <= 2*(a*b)
  proof
    per cases by NAT_1:14;
    suppose x = 0;
      hence thesis;
    end;
    suppose 1 <= x;
      then 1 <= b by A2, XXREAL_0:2;
      then a*1 <= a*b by XREAL_1:64;
      then A5: x <= a*b by A2, XXREAL_0:2;
      2*(a*b) = a*b + a*b;
      then a*b <= 2*(a*b) by NAT_1:11;
      hence thesis by A5, XXREAL_0:2;
    end;
  end;
  A6: (funD*T).x = funD.(a*b) by A3, CompVal .= 2*(a*b) by DefD;
  set O1 = exprOplus(funD*T, opPlusI.F);
  A7: O1.x = 2*(a*b) + a*a by A1, A2, A4, A6, OplusExprVal;
  2*(a*b) <= O1.x by A7, NAT_1:11;
  then x <= O1.x by A4, XXREAL_0:2;
  then A8: exprOplus(O1, opPlusI.G).x = O1.x + b*b by A1, A2, OplusExprVal
    .= (a+b)*(a+b) by A7;
  set H = funRt*exprOplus(O1, opPlusI.G);
  A9: H.x = funRt.((a+b)*(a+b)) by A8, CompVal .= a+b by RtSq;
  x <= a+b by A2, NAT_1:12;
  then A10: (exprMinusI H).x = a+b -' x by A9, MinusIExprVal
    .= (F.x + G.x + x) + x -' x
    .= F.x + G.x + x by NAT_D:34;
  then x <= (exprMinusI H).x by NAT_1:11;
  hence exprPlus(F,G).x = (exprMinusI H).x -' x by MinusIExprVal
    .= F.x + G.x by A10, NAT_D:34;
end;

theorem PlusExprEq:
  exprPlus(F,G) = opPlus.(F,G)
proof
  now
    let x;
    thus exprPlus(F,G).x = F.x + G.x by PlusExprVal
      .= (opPlus.(F,G)).x by DefPlus;
  end;
  hence thesis by UFunExt;
end;

:: The difference function computed by F - G (footnote 8): it equals
:: F - G where F >= G, and some other value elsewhere.
definition
  func opDiffE -> BinOp of Funcs(NAT,NAT) means :DefDiffE:
  for F,G being Element of Funcs(NAT,NAT), x being Nat holds
    (it.(F,G)).x = funE.((F.x + G.x)*(F.x + G.x) + 3*F.x + G.x + 1);
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      funE.(($1.$3 + $2.$3)*($1.$3 + $2.$3) + 3*$1.$3 + $2.$3 + 1);
    thus ex b being BinOp of Funcs(NAT,NAT) st
      for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) from BOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Element of Funcs(NAT,NAT), Nat) =
      funE.(($1.$3 + $2.$3)*($1.$3 + $2.$3) + 3*$1.$3 + $2.$3 + 1);
    let b,c be BinOp of Funcs(NAT,NAT) such that
    A1: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (b.(F,G)).x = T(F,G,x) and
    A2: for F,G being Element of Funcs(NAT,NAT), x being Nat holds
      (c.(F,G)).x = T(F,G,x);
    thus b = c from BOpUq(A1,A2);
  end;
end;

theorem DiffEIsDifference:
  G.x <= F.x implies (opDiffE.(F,G)).x = F.x -' G.x
proof
  assume A1: G.x <= F.x;
  thus (opDiffE.(F,G)).x
      = funE.((F.x + G.x)*(F.x + G.x) + 3*F.x + G.x + 1) by DefDiffE
     .= F.x -' G.x by A1, RobDiffE;
end;

theorem MinusExprEq:
  exprMinus(F,G) = opDiffE.(F,G)
proof
  now
    let x;
    set a = F.x, b = G.x;
    A1: exprPlus(F,G).x = a + b by PlusExprVal;
    A2: (funSq*exprPlus(F,G)).x = funSq.(a+b) by A1, CompVal
      .= (a+b)*(a+b) by DefSq;
    A3: (funM3*F).x = funM3.a by CompVal .= 3*a by DefM3;
    A4: exprPlus(funSq*exprPlus(F,G), funM3*F).x = (a+b)*(a+b) + 3*a
      by A2, A3, PlusExprVal;
    A5: exprPlus(exprPlus(funSq*exprPlus(F,G), funM3*F), G).x
      = (a+b)*(a+b) + 3*a + b by A4, PlusExprVal;
    thus exprMinus(F,G).x
        = (funE*funS).(exprPlus(exprPlus(funSq*exprPlus(F,G), funM3*F), G).x)
          by CompVal
       .= funE.(funS.((a+b)*(a+b) + 3*a + b)) by A5, CompVal
       .= funE.((a+b)*(a+b) + 3*a + b + 1) by DefS
       .= (opDiffE.(F,G)).x by DefDiffE;
  end;
  hence thesis by UFunExt;
end;

theorem Lemma66:
  F in C6 & G in C6 implies opPlus.(F,G) in C6 & opDiffE.(F,G) in C6 &
  ((for x holds G.x <= F.x) implies opMinus.(F,G) in C6)
proof
  assume A1: F in C6 & G in C6;
  then exprPlus(F,G) in C6 by PlusExprIn;
  hence opPlus.(F,G) in C6 by PlusExprEq;
  exprMinus(F,G) in C6 by A1, MinusExprIn;
  hence A2: opDiffE.(F,G) in C6 by MinusExprEq;
  assume A3: for x holds G.x <= F.x;
  now
    let x;
    thus (opDiffE.(F,G)).x = F.x -' G.x by A3, DiffEIsDifference
      .= (opMinus.(F,G)).x by DefMinus;
  end;
  hence thesis by A2, UFunExt;
end;

:: Theorem 6.7 (closure part).  Robinson [15, Sec. 7, Thm. 3] proved that the
:: basis <S, E, F + G, FG, F^box> is suitable; here we show that it generates
:: exactly clos F, so clos F = Prim(N,N) follows from Robinson's theorem.

definition
  func RobinsonClos -> Subset of Funcs(NAT,NAT) equals
  clos({funS, funE}, {opBox}, {opPlus, opComp});
  coherence;
end;

theorem BoxE:
  opBox.funE = cst 0
proof
  set B = opBox.funE;
  defpred P[Nat] means B.$1 = 0;
  A1: P[0] by DefBox;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume P[n];
    then B.(n+1) = funE.0 by DefBox;
    hence thesis by ESmall;
  end;
  A3: for n holds P[n] from NAT_1:sch 2(A1,A2);
  now
    let n;
    thus B.n = 0 by A3 .= (cst 0).n by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem BoxS:
  opBox.funS = funI
proof
  set B = opBox.funS;
  defpred P[Nat] means B.$1 = $1;
  A1: P[0] by DefBox;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume P[n];
    then B.(n+1) = funS.n by DefBox;
    hence thesis by DefS;
  end;
  A3: for n holds P[n] from NAT_1:sch 2(A1,A2);
  now
    let n;
    thus B.n = n by A3 .= funI.n by DefI;
  end;
  hence thesis by UFunExt;
end;

theorem OneExpr:
  funS*(cst 0) = cst 1
proof
  now
    let x;
    thus (funS*(cst 0)).x = funS.((cst 0).x) by CompVal
      .= funS.0 by DefCst
      .= 0 + 1 by DefS
      .= (cst 1).x by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem PlusIEq:
  opPlusI.F = opPlus.(F, funI)
proof
  now
    let x;
    thus (opPlusI.F).x = F.x + x by DefPlusI
      .= F.x + funI.x by DefI
      .= (opPlus.(F, funI)).x by DefPlus;
  end;
  hence thesis by UFunExt;
end;

theorem C6ClosedRobinson:
  C6 is_closed_under {funS, funE}, {opBox}, {opPlus, opComp}
proof
  thus {funS, funE} c= C6
  proof
    let z be object;
    assume z in {funS, funE};
    then z = funS or z = funE by TARSKI:def 2;
    hence thesis by SIn, C6E;
  end;
  thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
    st u in {opBox} & F in C6 holds u.F in C6
  proof
    let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
    assume A1: u in {opBox} & F in C6;
    then u = opBox by TARSKI:def 1;
    hence thesis by A1, C6Box;
  end;
  let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
  assume A2: b in {opPlus, opComp} & F in C6 & G in C6;
  then A3: b = opPlus or b = opComp by TARSKI:def 2;
  per cases by A3;
  suppose b = opPlus;
    hence thesis by A2, Lemma66;
  end;
  suppose b = opComp;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A2, C6Comp;
  end;
end;

theorem RobinsonClosedC6:
  RobinsonClos is_closed_under {cst 1, funE}, {opPlusI, opBox}, {opComp}
proof
  set R = RobinsonClos;
  funS in {funS, funE} & funE in {funS, funE} by TARSKI:def 2;
  then A1: funS in R & funE in R by ClosInit;
  A2: opBox in {opBox} by TARSKI:def 1;
  A3: opPlus in {opPlus, opComp} & opComp in {opPlus, opComp}
    by TARSKI:def 2;
  A4: for F,G st F in R & G in R holds F*G in R
  proof
    let F,G;
    assume F in R & G in R;
    then opComp.(F,G) in R by A3, ClosBinop;
    hence thesis by DefComp;
  end;
  opBox.funE in R by A1, A2, ClosUnop;
  then A5: cst 0 in R by BoxE;
  thus {cst 1, funE} c= R
  proof
    let z be object;
    assume z in {cst 1, funE};
    then A6: z = cst 1 or z = funE by TARSKI:def 2;
    funS*(cst 0) in R by A1, A4, A5;
    hence thesis by A1, A6, OneExpr;
  end;
  opBox.funS in R by A1, A2, ClosUnop;
  then A7: funI in R by BoxS;
  thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
    st u in {opPlusI, opBox} & F in R holds u.F in R
  proof
    let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
    assume A8: u in {opPlusI, opBox} & F in R;
    then A9: u = opPlusI or u = opBox by TARSKI:def 2;
    per cases by A9;
    suppose A10: u = opPlusI;
      opPlus.(F, funI) in R by A3, A7, A8, ClosBinop;
      hence thesis by A10, PlusIEq;
    end;
    suppose u = opBox;
      hence thesis by A2, A8, ClosUnop;
    end;
  end;
  let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
  assume A11: b in {opComp} & F in R & G in R;
  then b = opComp by TARSKI:def 1;
  hence thesis by A3, A11, ClosBinop;
end;

theorem Theorem67:
  C6 = RobinsonClos
proof
  A1: RobinsonClos c= C6 by C6ClosedRobinson, ClosLeast;
  C6 c= RobinsonClos by RobinsonClosedC6, ClosLeast;
  hence thesis by A1, XBOOLE_0:def 10;
end;

:: The proof of Theorem 6.7 in the paper: clos F contains the basis of
:: Lemma 3.3, <S, Sq, O, Hf, Rt, F + G, F - G, FG, F^box>, with F - G given
:: by the difference function of footnote 8.

theorem Theorem67L33:
  clos({funS, funSq, funO, funHf, funRt}, {opBox}, {opPlus, opDiffE, opComp})
  c= C6
proof
  C6 is_closed_under {funS, funSq, funO, funHf, funRt}, {opBox},
    {opPlus, opDiffE, opComp}
  proof
    thus {funS, funSq, funO, funHf, funRt} c= C6
    proof
      let z be object;
      assume z in {funS, funSq, funO, funHf, funRt};
      then z = funS or z = funSq or z = funO or z = funHf or z = funRt
        by ENUMSET1:def 3;
      hence thesis by SIn, SqIn, OIn, HfIn, RtIn;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opBox} & F in C6 holds u.F in C6
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A1: u in {opBox} & F in C6;
      then u = opBox by TARSKI:def 1;
      hence thesis by A1, C6Box;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A2: b in {opPlus, opDiffE, opComp} & F in C6 & G in C6;
    then A3: b = opPlus or b = opDiffE or b = opComp by ENUMSET1:def 1;
    per cases by A3;
    suppose b = opPlus or b = opDiffE;
      hence thesis by A2, Lemma66;
    end;
    suppose b = opComp;
      then b.(F,G) = F*G by DefComp;
      hence thesis by A2, C6Comp;
    end;
  end;
  hence thesis by ClosLeast;
end;

begin

:: Cantor pairing functions (Section 2 of the paper): A(x) = x(x+1)/2,
:: V(x) = (Rt(8x+1) - 1)/2, K(x) = x - A(V(x)), L(x) = A(V(x)+1) - x - 1.

theorem TriEx:
  ex a being Nat st 2*a = x*x + x
proof
  set q = x div 2;
  A1: x = 2*q + (x mod 2) by NAT_D:2;
  per cases by NAT_D:12;
  suppose x mod 2 = 0;
    then A2: x = 2*q by A1;
    take q*x + q;
    thus thesis by A2;
  end;
  suppose x mod 2 = 1;
    then A3: x = 2*q + 1 by A1;
    take x*(q+1);
    thus thesis by A3;
  end;
end;

definition
  func funA -> Element of Funcs(NAT,NAT) means :DefA:
  for x being Nat holds it.x = (x*x + x) div 2;
  existence
  proof
    deffunc T(Nat) = ($1*$1 + $1) div 2;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = ($1*$1 + $1) div 2;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

theorem TwoA:
  2*(funA.x) = x*x + x
proof
  consider a being Nat such that A1: 2*a = x*x + x by TriEx;
  funA.x = (2*a) div 2 by A1, DefA .= a by NAT_D:18;
  hence thesis by A1;
end;

theorem ASuc:
  funA.(x+1) = funA.x + x + 1
proof
  2*(funA.(x+1)) = (x+1)*(x+1) + (x+1) by TwoA
    .= x*x + x + 2*(x+1)
    .= 2*(funA.x) + 2*(x+1) by TwoA
    .= 2*(funA.x + x + 1);
  hence thesis;
end;

theorem AMono:
  m <= n implies funA.m <= funA.n
proof
  assume A1: m <= n;
  then A2: m*m <= n*n by XREAL_1:66;
  2*(funA.m) = m*m + m & 2*(funA.n) = n*n + n by TwoA;
  then 2*(funA.m) <= 2*(funA.n) by A1, A2, XREAL_1:7;
  hence thesis by XREAL_1:68;
end;

theorem AStrict:
  funA.m < funA.n implies m < n
proof
  assume A1: funA.m < funA.n;
  assume not m < n;
  hence contradiction by A1, AMono;
end;

theorem AIndexEx:
  ex t being Nat st funA.t <= x & x < funA.(t+1)
proof
  defpred P[Nat] means ex t being Nat st funA.t <= $1 & $1 < funA.(t+1);
  2*(funA.0) = 0*0 + 0 by TwoA;
  then A0: funA.0 = 0;
  funA.(0+1) = funA.0 + 0 + 1 by ASuc;
  then A1: P[0] by A0;
  A2: for x st P[x] holds P[x+1]
  proof
    let x;
    given t being Nat such that B1: funA.t <= x & x < funA.(t+1);
    per cases;
    suppose C1: x+1 < funA.(t+1);
      take t;
      thus thesis by B1, C1, NAT_1:13;
    end;
    suppose C1: x+1 >= funA.(t+1);
      take t+1;
      x+1 <= funA.(t+1) by B1, NAT_1:13;
      then A3: x+1 = funA.(t+1) by C1, XXREAL_0:1;
      hence funA.(t+1) <= x+1;
      funA.(t+1+1) = funA.(t+1) + (t+1) + 1 by ASuc;
      then A4: funA.(t+1+1) = funA.(t+1) + ((t+1) + 1);
      funA.(t+1) < funA.(t+1) + ((t+1) + 1) by XREAL_1:29;
      hence thesis by A3, A4;
    end;
  end;
  for x holds P[x] from NAT_1:sch 2(A1,A2);
  hence thesis;
end;

theorem AIndexUq:
  funA.r <= x & x < funA.(r+1) & funA.s <= x & x < funA.(s+1) implies r = s
proof
  assume that A1: funA.r <= x and A2: x < funA.(r+1) and
    A3: funA.s <= x and A4: x < funA.(s+1);
  A5: now
    let a,b be Nat such that B1: funA.a <= x and B2: x < funA.(b+1);
    funA.a < funA.(b+1) by B1, B2, XXREAL_0:2;
    then a < b+1 by AStrict;
    hence a <= b by NAT_1:13;
  end;
  then A6: r <= s by A1, A4;
  s <= r by A5, A3, A2;
  hence thesis by A6, XXREAL_0:1;
end;

definition
  func funV -> Element of Funcs(NAT,NAT) means :DefV:
  for x being Nat holds it.x = (funRt.(8*x + 1) -' 1) div 2;
  existence
  proof
    deffunc T(Nat) = (funRt.(8*$1 + 1) -' 1) div 2;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = (funRt.(8*$1 + 1) -' 1) div 2;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: V is the inverse of A: A(V(x)) <= x < A(V(x)+1)
theorem VChar:
  funA.t <= x & x < funA.(t+1) implies funV.x = t
proof
  assume that A1: funA.t <= x and A2: x < funA.(t+1);
  A3: 2*(funA.t) = t*t + t & 2*(funA.(t+1)) = (t+1)*(t+1) + (t+1) by TwoA;
  8*(funA.t) <= 8*x by A1, XREAL_1:64;
  then 4*(t*t + t) + 1 <= 8*x + 1 by A3, XREAL_1:6;
  then A4: (2*t+1)*(2*t+1) <= 8*x + 1;
  x + 1 <= funA.(t+1) by A2, NAT_1:13;
  then 8*(x+1) <= 8*(funA.(t+1)) by XREAL_1:64;
  then 8*x + 8 <= 4*((t+1)*(t+1) + (t+1)) by A3;
  then A50: 8*x + 8 <= 4*(t*t) + 12*t + 8;
  8*x + 1 < 8*x + 1 + 7 by XREAL_1:29;
  then A51: 8*x + 1 < 4*(t*t) + 12*t + 8 by A50, XXREAL_0:2;
  4*(t*t) + 12*t + 8 < 4*(t*t) + 12*t + 8 + 1 by XREAL_1:29;
  then 8*x + 1 < 4*(t*t) + 12*t + 8 + 1 by A51, XXREAL_0:2;
  then A5: 8*x + 1 < (2*t+3)*(2*t+3);
  set s = funRt.(8*x + 1);
  A6: s = 2*t+1 or s = 2*t+2
  proof
    per cases;
    suppose B1: (2*t+2)*(2*t+2) <= 8*x + 1;
      8*x + 1 < (2*t+2+1)*(2*t+2+1) by A5;
      hence thesis by B1, RtI;
    end;
    suppose B1: not (2*t+2)*(2*t+2) <= 8*x + 1;
      8*x + 1 < (2*t+1+1)*(2*t+1+1) by B1;
      hence thesis by A4, RtI;
    end;
  end;
  A7: funV.x = (s -' 1) div 2 by DefV;
  per cases by A6;
  suppose s = 2*t+1;
    then s -' 1 = 2*t by NAT_D:34;
    hence thesis by A7, NAT_D:18;
  end;
  suppose s = 2*t+2;
    then s = (2*t+1) + 1;
    then A8: s -' 1 = 2*t + 1 by NAT_D:34;
    2*t + 1 = 2*t + 1 & 1 < 2;
    then (2*t + 1) div 2 = t by NAT_D:def 1;
    hence thesis by A7, A8;
  end;
end;

theorem VBounds:
  funA.(funV.x) <= x & x < funA.(funV.x + 1)
proof
  consider t being Nat such that A1: funA.t <= x & x < funA.(t+1) by AIndexEx;
  thus thesis by A1, VChar;
end;

definition
  func funK -> Element of Funcs(NAT,NAT) means :DefK:
  for x being Nat holds it.x = x -' funA.(funV.x);
  existence
  proof
    deffunc T(Nat) = $1 -' funA.(funV.$1);
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = $1 -' funA.(funV.$1);
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

definition
  func funL -> Element of Funcs(NAT,NAT) means :DefL:
  for x being Nat holds it.x = funA.(funV.x + 1) -' x -' 1;
  existence
  proof
    deffunc T(Nat) = funA.(funV.$1 + 1) -' $1 -' 1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = funA.(funV.$1 + 1) -' $1 -' 1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

:: values on a diagonal of the Cantor table: for k <= t,
:: V(A(t)+k) = t, K(A(t)+k) = k and L(A(t)+k) = t-k
theorem Diag:
  k <= t implies funV.(funA.t + k) = t & funK.(funA.t + k) = k &
  funL.(funA.t + k) = t -' k
proof
  assume A1: k <= t;
  set x = funA.t + k;
  A2: funA.(t+1) = funA.t + t + 1 by ASuc;
  A3: funA.t <= x by NAT_1:11;
  k < t + 1 by A1, NAT_1:13;
  then x < funA.t + (t + 1) by XREAL_1:6;
  then A4: funV.x = t by A2, A3, VChar;
  thus funV.x = t by A4;
  thus funK.x = k + funA.t -' funA.t by A4, DefK .= k by NAT_D:34;
  set d = t -' k;
  A5: d + k = t by A1, XREAL_1:235;
  funA.(t+1) = (d + 1) + x + 1 - 1 by A2, A5;
  then funA.(t+1) = ((d + 1) + x) by A2, A5;
  then funA.(t+1) -' x = d + 1 by NAT_D:34;
  hence funL.x = d + 1 -' 1 by A4, DefL .= d by NAT_D:34;
end;

theorem Decomp:
  x = funA.(funV.x) + funK.x & funK.x <= funV.x
proof
  set t = funV.x;
  A1: funA.t <= x & x < funA.(t+1) by VBounds;
  funK.x = x -' funA.t by DefK;
  hence A2: x = funA.t + funK.x by A1, XREAL_1:235;
  funA.(t+1) = funA.t + t + 1 by ASuc;
  then funA.t + funK.x < funA.t + (t + 1) by A1, A2;
  then funK.x < t + 1 by XREAL_1:6;
  hence thesis by NAT_1:13;
end;

theorem LEq:
  funL.x = funV.x -' funK.x
proof
  A1: x = funA.(funV.x) + funK.x & funK.x <= funV.x by Decomp;
  hence funL.x = funL.(funA.(funV.x) + funK.x)
    .= funV.x -' funK.x by A1, Diag;
end;

:: K and L are in clos F

theorem IIn:
  funI in C6 by SIn, C6Box, BoxS;

theorem AIn:
  funA in C6
proof
  now
    let x;
    thus (funHf*(opPlusI.funSq)).x = funHf.((opPlusI.funSq).x) by CompVal
      .= funHf.(funSq.x + x) by DefPlusI
      .= funHf.(x*x + x) by DefSq
      .= (x*x + x) div 2 by DefHf
      .= funA.x by DefA;
  end;
  then A1: funHf*(opPlusI.funSq) = funA by UFunExt;
  opPlusI.funSq in C6 by SqIn, C6PlusI;
  hence thesis by A1, HfIn, C6Comp;
end;

theorem VIn:
  funV in C6
proof
  set G = funHf*exprPhat*funRt*funS*funD*funD*funD;
  now
    let x;
    set s = funRt.(8*x + 1);
    A1: (funD*funD*funD).x = (funD*funD).(funD.x) by CompVal
      .= funD.(funD.(funD.x)) by CompVal
      .= funD.(funD.(2*x)) by DefD
      .= funD.(2*(2*x)) by DefD
      .= 2*(2*(2*x)) by DefD
      .= 8*x;
    A2: G.x = (funHf*exprPhat*funRt*funS*funD*funD).(funD.x) by CompVal
      .= (funHf*exprPhat*funRt*funS*funD).(funD.(funD.x)) by CompVal
      .= (funHf*exprPhat*funRt*funS).(funD.(funD.(funD.x))) by CompVal
      .= (funHf*exprPhat*funRt*funS).((funD*funD).(funD.x)) by CompVal
      .= (funHf*exprPhat*funRt*funS).(8*x) by A1, CompVal
      .= (funHf*exprPhat*funRt).(funS.(8*x)) by CompVal
      .= (funHf*exprPhat*funRt).(8*x + 1) by DefS
      .= (funHf*exprPhat).s by CompVal
      .= funHf.(exprPhat.s) by CompVal;
    s <> 0
    proof
      assume s = 0;
      then 8*x + 1 < (0+1)*(0+1) by DefRt;
      hence contradiction by NAT_1:11;
    end;
    then 1 <= s by NAT_1:14;
    then A3: (s -' 1) + 1 = s by XREAL_1:235;
    thus G.x = funHf.(exprPhat.((s -' 1) + 1)) by A2, A3
      .= funHf.(s -' 1) by PhatVal
      .= (s -' 1) div 2 by DefHf
      .= funV.x by DefV;
  end;
  then A4: G = funV by UFunExt;
  funHf*exprPhat in C6 by HfIn, PhatIn, C6Comp;
  then funHf*exprPhat*funRt in C6 by RtIn, C6Comp;
  then funHf*exprPhat*funRt*funS in C6 by SIn, C6Comp;
  then funHf*exprPhat*funRt*funS*funD in C6 by DIn, C6Comp;
  then funHf*exprPhat*funRt*funS*funD*funD in C6 by DIn, C6Comp;
  hence thesis by A4, DIn, C6Comp;
end;

theorem KIn:
  funK in C6
proof
  A1: funA*funV in C6 by AIn, VIn, C6Comp;
  A2: for x holds (funA*funV).x <= funI.x
  proof
    let x;
    A3: (funA*funV).x = funA.(funV.x) by CompVal;
    funI.x = x by DefI .= funA.(funV.x) + funK.x by Decomp;
    hence thesis by A3, NAT_1:11;
  end;
  now
    let x;
    thus (opMinus.(funI, funA*funV)).x = funI.x -' (funA*funV).x by DefMinus
      .= x -' (funA*funV).x by DefI
      .= x -' funA.(funV.x) by CompVal
      .= funK.x by DefK;
  end;
  then opMinus.(funI, funA*funV) = funK by UFunExt;
  hence thesis by A1, A2, IIn, Lemma66;
end;

theorem LIn:
  funL in C6
proof
  A1: for x holds funK.x <= funV.x by Decomp;
  now
    let x;
    thus (opMinus.(funV, funK)).x = funV.x -' funK.x by DefMinus
      .= funL.x by LEq;
  end;
  then opMinus.(funV, funK) = funL by UFunExt;
  hence thesis by A1, VIn, KIn, Lemma66;
end;

:: Bases <1, G, F^+, FG, F^box> for a single initial function G

definition
  let G be Element of Funcs(NAT,NAT);
  func Clos1 G -> Subset of Funcs(NAT,NAT) equals
  clos({cst 1, G}, {opPlusI, opBox}, {opComp});
  coherence;
end;

reserve G1 for Element of Funcs(NAT,NAT);

theorem C1One:
  cst 1 in Clos1 G1 & G1 in Clos1 G1
proof
  cst 1 in {cst 1, G1} & G1 in {cst 1, G1} by TARSKI:def 2;
  hence thesis by ClosInit;
end;

theorem C1PlusI:
  F in Clos1 G1 implies opPlusI.F in Clos1 G1
proof
  assume A1: F in Clos1 G1;
  opPlusI in {opPlusI, opBox} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem C1Box:
  F in Clos1 G1 implies opBox.F in Clos1 G1
proof
  assume A1: F in Clos1 G1;
  opBox in {opPlusI, opBox} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem C1Comp:
  F in Clos1 G1 & G in Clos1 G1 implies F*G in Clos1 G1
proof
  assume A1: F in Clos1 G1 & G in Clos1 G1;
  A2: opComp in {opComp} by TARSKI:def 1;
  opComp.(F,G) = F*G by DefComp;
  hence thesis by A1, A2, ClosBinop;
end;

:: if G is generated by <1, H, F^+, FG, F^box> then so is everything
:: generated by <1, G, F^+, FG, F^box>
theorem C1Sub:
  G1 in Clos1 H implies Clos1 G1 c= Clos1 H
proof
  assume A1: G1 in Clos1 H;
  Clos1 H is_closed_under {cst 1, G1}, {opPlusI, opBox}, {opComp}
  proof
    thus {cst 1, G1} c= Clos1 H
    proof
      let z be object;
      assume z in {cst 1, G1};
      then z = cst 1 or z = G1 by TARSKI:def 2;
      hence thesis by A1, C1One;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBox} & F in Clos1 H holds u.F in Clos1 H
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opPlusI, opBox} & F in Clos1 H;
      then u = opPlusI or u = opBox by TARSKI:def 2;
      hence thesis by A2, C1PlusI, C1Box;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: b in {opComp} & F in Clos1 H & G in Clos1 H;
    then b = opComp by TARSKI:def 1;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A3, C1Comp;
  end;
  hence thesis by ClosLeast;
end;

theorem C1S:
  funS in Clos1 G1 by C1One, C1PlusI, SExpr;

theorem C1Sgn:
  funSgn in Clos1 G1 by C1One, C1Box, SgnExpr;

:: Theorem 6.8: the bases <1, K, F^+, FG, F^box> and <1, L, F^+, FG, F^box>
:: generate clos F (following Robinson [16, p. 664]).

definition
  func C6K -> Subset of Funcs(NAT,NAT) equals
  Clos1 funK;
  coherence;
  func C6L -> Subset of Funcs(NAT,NAT) equals
  Clos1 funL;
  coherence;
end;

theorem C6Eq:
  C6 = Clos1 funE;

:: Z(x) = x(x+3)/2 = A(x) + x and Y(x) = 2x - Rt(x)
definition
  func funZ -> Element of Funcs(NAT,NAT) means :DefZ:
  for x being Nat holds it.x = funA.x + x;
  existence
  proof
    deffunc T(Nat) = funA.$1 + $1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = funA.$1 + $1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

definition
  func funY -> Element of Funcs(NAT,NAT) means :DefY:
  for x being Nat holds it.x = 2*x -' funRt.x;
  existence
  proof
    deffunc T(Nat) = 2*$1 -' funRt.$1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = 2*$1 -' funRt.$1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

theorem TwoZ:
  2*(funZ.x) = x*(x+3)
proof
  2*(funZ.x) = 2*(funA.x + x) by DefZ .= 2*(funA.x) + 2*x
    .= x*x + x + 2*x by TwoA;
  hence thesis;
end;

theorem AOne:
  funA.1 = 1
proof
  2*(funA.1) = 1*1 + 1 by TwoA;
  hence thesis;
end;

theorem ZeroExprK:
  funK*(cst 1) = cst 0
proof
  A1: funK.(funA.1 + 0) = 0 by Diag;
  now
    let x;
    thus (funK*(cst 1)).x = funK.((cst 1).x) by CompVal
      .= funK.1 by DefCst
      .= 0 by A1, AOne
      .= (cst 0).x by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem ZExpr:
  opBox.(funS*funS*(opPlusI.funK)) = funZ
proof
  set B = opBox.(funS*funS*(opPlusI.funK));
  defpred P[Nat] means B.$1 = funZ.$1;
  2*(funA.0) = 0*0 + 0 by TwoA;
  then funZ.0 = 0 + 0 by DefZ;
  then A1: P[0] by DefBox;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    A4: funZ.n = funA.n + n by DefZ;
    A5: funK.(funA.n + n) = n by Diag;
    thus B.(n+1) = (funS*funS*(opPlusI.funK)).(funZ.n) by A3, DefBox
      .= (funS*funS).((opPlusI.funK).(funZ.n)) by CompVal
      .= funS.(funS.((opPlusI.funK).(funZ.n))) by CompVal
      .= funS.((opPlusI.funK).(funZ.n) + 1) by DefS
      .= (opPlusI.funK).(funZ.n) + 1 + 1 by DefS
      .= funK.(funZ.n) + funZ.n + 1 + 1 by DefPlusI
      .= n + (funA.n + n) + 1 + 1 by A4, A5
      .= (funA.n + n + 1) + (n + 1)
      .= funA.(n+1) + (n+1) by ASuc
      .= funZ.(n+1) by DefZ;
  end;
  for n holds P[n] from NAT_1:sch 2(A1,A2);
  hence thesis by UFunExt;
end;

:: Robinson's formula: K((a+b)(a+b+3)/2 + 2a + 3) = a - b if a >= b
theorem RobDiffK:
  for a,b being Nat st b <= a holds
  funK.(funZ.(a+b) + 2*a + 3) = a -' b
proof
  let a,b be Nat;
  assume b <= a;
  then A1: (a -' b) + b = a by XREAL_1:235;
  set d = a -' b, t = a + b;
  A2: funA.(t+1) = funA.t + t + 1 by ASuc;
  funA.(t+1+1) = funA.(t+1) + (t+1) + 1 by ASuc;
  then A3: funA.(t+2) = funA.t + 2*t + 3 by A2;
  A4: funZ.t + 2*a + 3 = funA.t + t + 2*a + 3 by DefZ
    .= funA.(t+2) + d by A1, A3;
  A5: d <= a by A1, NAT_1:11;
  a <= t by NAT_1:11;
  then A6: d <= t by A5, XXREAL_0:2;
  t <= t + 2 by NAT_1:11;
  then d <= t + 2 by A6, XXREAL_0:2;
  hence thesis by A4, Diag;
end;

:: I - F = K S S S ((Z F^+)^+)^+ (if x >= F(x)) and
:: D - F = K S S S ((((Z (F^+)^+)^+)^+)^+)^+ (if 2x >= F(x))
definition
  let F be Element of Funcs(NAT,NAT);
  func exprIminusF F -> Element of Funcs(NAT,NAT) equals
  funK*funS*funS*funS*(opPlusI.(opPlusI.(funZ*(opPlusI.F))));
  coherence;
  func exprDminusF F -> Element of Funcs(NAT,NAT) equals
  funK*funS*funS*funS*(opPlusI.(opPlusI.(opPlusI.(opPlusI.(
    funZ*(opPlusI.(opPlusI.F)))))));
  coherence;
end;

theorem KSSSVal:
  (funK*funS*funS*funS).y = funK.(y + 3)
proof
  thus (funK*funS*funS*funS).y = (funK*funS*funS).(funS.y) by CompVal
    .= (funK*funS).(funS.(funS.y)) by CompVal
    .= funK.(funS.(funS.(funS.y))) by CompVal
    .= funK.(funS.(funS.(y+1))) by DefS
    .= funK.(funS.(y+1+1)) by DefS
    .= funK.(y+1+1+1) by DefS
    .= funK.(y+3);
end;

theorem IminusFVal:
  F.x <= x implies (exprIminusF F).x = x -' F.x
proof
  assume A1: F.x <= x;
  A2: (opPlusI.(opPlusI.(funZ*(opPlusI.F)))).x
      = (opPlusI.(funZ*(opPlusI.F))).x + x by DefPlusI
     .= (funZ*(opPlusI.F)).x + x + x by DefPlusI
     .= funZ.((opPlusI.F).x) + x + x by CompVal
     .= funZ.(x + F.x) + x + x by DefPlusI;
  thus (exprIminusF F).x = (funK*funS*funS*funS).(funZ.(x + F.x) + x + x)
      by A2, CompVal
    .= funK.(funZ.(x + F.x) + x + x + 3) by KSSSVal
    .= funK.(funZ.(x + F.x) + 2*x + 3)
    .= x -' F.x by A1, RobDiffK;
end;

theorem DminusFVal:
  F.x <= 2*x implies (exprDminusF F).x = 2*x -' F.x
proof
  assume A1: F.x <= 2*x;
  set G = funZ*(opPlusI.(opPlusI.F));
  A2: G.x = funZ.((opPlusI.(opPlusI.F)).x) by CompVal
    .= funZ.((opPlusI.F).x + x) by DefPlusI
    .= funZ.(F.x + x + x) by DefPlusI
    .= funZ.(2*x + F.x);
  A3: (opPlusI.(opPlusI.(opPlusI.(opPlusI.G)))).x
      = (opPlusI.(opPlusI.(opPlusI.G))).x + x by DefPlusI
     .= (opPlusI.(opPlusI.G)).x + x + x by DefPlusI
     .= (opPlusI.G).x + x + x + x by DefPlusI
     .= G.x + x + x + x + x by DefPlusI
     .= funZ.(2*x + F.x) + 4*x by A2;
  thus (exprDminusF F).x = (funK*funS*funS*funS).(funZ.(2*x + F.x) + 4*x)
      by A3, CompVal
    .= funK.(funZ.(2*x + F.x) + 4*x + 3) by KSSSVal
    .= funK.(funZ.(2*x + F.x) + 2*(2*x) + 3)
    .= 2*x -' F.x by A1, RobDiffK;
end;

:: Y = ((Sgn K)^+ S)^box; Y(n) + 1 is triangular iff n + 1 is a square

theorem RtLe:
  funRt.x <= x
proof
  A1: funRt.x * funRt.x <= x by DefRt;
  funRt.x <= funRt.x * funRt.x by LeSq;
  hence thesis by A1, XXREAL_0:2;
end;

theorem YAdd:
  funY.n + funRt.n = 2*n
proof
  A1: funRt.n <= n by RtLe;
  2*n = n + n;
  then n <= 2*n by NAT_1:11;
  then funRt.n <= 2*n by A1, XXREAL_0:2;
  then 2*n -' funRt.n + funRt.n = 2*n by XREAL_1:235;
  hence thesis by DefY;
end;

theorem YStepSquare:
  (funRt.n + 1)*(funRt.n + 1) = n + 1 implies funK.(funY.n + 1) = 0
proof
  set r = funRt.n;
  assume A1: (r + 1)*(r + 1) = n + 1;
  A2: funY.n + r = 2*n by YAdd;
  2*(funA.(2*r+1)) = (2*r+1)*(2*r+1) + (2*r+1) by TwoA
    .= 2*(funY.n + r) - 2*r + 2 by A1, A2
    .= 2*(funY.n + 1);
  then funY.n + 1 = funA.(2*r+1) + 0;
  hence thesis by Diag;
end;

theorem YStepNonSquare:
  (funRt.n + 1)*(funRt.n + 1) <> n + 1 implies funK.(funY.n + 1) <> 0
proof
  set r = funRt.n;
  set m = funY.n + 1;
  assume A1: (r + 1)*(r + 1) <> n + 1;
  A2: r*r <= n & n < (r + 1)*(r + 1) by DefRt;
  then n + 1 <= (r + 1)*(r + 1) by NAT_1:13;
  then A3: n + 1 < (r + 1)*(r + 1) by A1, XXREAL_0:1;
  A4: r <> 0
  proof
    assume r = 0;
    then n + 1 < 1 by A3;
    hence contradiction by NAT_1:11;
  end;
  consider s such that A5: r = s + 1 by A4, NAT_1:6;
  A6: (s+1)*(s+1) <= n by A2, A5;
  n + 1 + 1 <= (s+1+1)*(s+1+1) by A3, A5, NAT_1:13;
  then A7: n + 2 <= (s+2)*(s+2);
  A8: funY.n + r = 2*n by YAdd;
  then A9: m + s = 2*n by A5;
  assume A10: funK.m = 0;
  set u = funV.m;
  A11: m = funA.u + funK.m by Decomp .= funA.u by A10;
  :: A(2s+1) < m < A(2s+3)
  A12: 2*(funA.(2*s+1)) = (2*s+1)*(2*s+1) + (2*s+1) by TwoA;
  4*((s+1)*(s+1)) <= 4*n by A6, XREAL_1:64;
  then 4*((s+1)*(s+1)) <= 2*(m + s) by A9;
  then (4*(s*s) + 6*s + 4) + 2*s <= 2*m + 2*s;
  then A130: 4*(s*s) + 6*s + 4 <= 2*m by XREAL_1:6;
  4*(s*s) + 6*s + 2 < 4*(s*s) + 6*s + 2 + 2 by XREAL_1:29;
  then A13: 4*(s*s) + 6*s + 2 < 2*m by A130, XXREAL_0:2;
  2*(funA.(2*s+1)) < 2*m by A12, A13;
  then A131: 2*(funA.(2*s+1)) < 2*(funA.u) by A11;
  funA.(2*s+1) < funA.u
  proof
    assume not thesis;
    then (funA.u)*2 <= (funA.(2*s+1))*2 by XREAL_1:64;
    hence contradiction by A131;
  end;
  then A14: 2*s+1 < u by AStrict;
  A15: 2*(funA.(2*s+3)) = (2*s+3)*(2*s+3) + (2*s+3) by TwoA;
  4*(n + 2) <= 4*((s+2)*(s+2)) by A7, XREAL_1:64;
  then 2*(m + s) + 8 <= 4*((s+2)*(s+2)) by A9;
  then 2*m + (2*s + 8) <= (4*(s*s) + 14*s + 8) + (2*s + 8);
  then A160: 2*m <= 4*(s*s) + 14*s + 8 by XREAL_1:6;
  4*(s*s) + 14*s + 8 < 4*(s*s) + 14*s + 8 + 4 by XREAL_1:29;
  then A16: 2*m < 4*(s*s) + 14*s + 12 by A160, XXREAL_0:2;
  2*m < 2*(funA.(2*s+3)) by A15, A16;
  then A161: 2*(funA.u) < 2*(funA.(2*s+3)) by A11;
  funA.u < funA.(2*s+3)
  proof
    assume not thesis;
    then (funA.(2*s+3))*2 <= (funA.u)*2 by XREAL_1:64;
    hence contradiction by A161;
  end;
  then u < 2*s+3 by AStrict;
  then u + 1 <= 2*s + 2 + 1 by NAT_1:13;
  then A17: u <= 2*s + 2 by XREAL_1:6;
  2*s + 1 + 1 <= u by A14, NAT_1:13;
  then A18: u = 2*s + 2 by A17, XXREAL_0:1;
  :: but then 2n = 2s^2 + 6s + 3, which is odd
  2*m = 2*(funA.u) by A11 .= (2*s+2)*(2*s+2) + (2*s+2) by A18, TwoA;
  then 2*(2*n) = 2*(2*(s*s + 3*s + 1) + 1) by A9;
  then A19: 2*n = 2*(s*s + 3*s + 1) + 1;
  A20: (2*n) mod 2 = 0 by NAT_D:13;
  (2*(s*s + 3*s + 1) + 1) mod 2 = 1 mod 2 by NAT_D:21 .= 1 by NAT_D:14;
  hence contradiction by A19, A20;
end;

theorem YStep:
  (opPlusI.(funSgn*funK)).(funS.(funY.n)) = funY.(n+1)
proof
  set r = funRt.n;
  A1: funY.n + r = 2*n by YAdd;
  A0: funS.(funY.n) = funY.n + 1 by DefS;
  A2: (opPlusI.(funSgn*funK)).(funS.(funY.n))
      = (funSgn*funK).(funS.(funY.n)) + funS.(funY.n) by DefPlusI
     .= funSgn.(funK.(funS.(funY.n))) + funS.(funY.n) by CompVal
     .= funSgn.(funK.(funY.n + 1)) + (funY.n + 1) by A0;
  A3: funY.(n+1) + funRt.(n+1) = 2*(n+1) by YAdd;
  A4: r*r <= n & n < (r + 1)*(r + 1) by DefRt;
  then A5: n + 1 <= (r + 1)*(r + 1) by NAT_1:13;
  per cases;
  suppose A6: (r + 1)*(r + 1) = n + 1;
    then A7: (r + 1)*(r + 1) <= n + 1;
    (r+1+1)*(r+1+1) = (r+1)*(r+1) + (2*r+3);
    then n + 1 < (r+1+1)*(r+1+1) by A6, XREAL_1:29;
    then funRt.(n+1) = r + 1 by A7, RtI;
    then A8: funY.(n+1) = funY.n + 1 by A1, A3;
    funK.(funY.n + 1) = 0 by A6, YStepSquare;
    then funSgn.(funK.(funY.n + 1)) = 0 by DefSgn;
    hence thesis by A2, A8;
  end;
  suppose A6: (r + 1)*(r + 1) <> n + 1;
    then A7: n + 1 < (r + 1)*(r + 1) by A5, XXREAL_0:1;
    r*r <= n + 1 by A4, NAT_1:13;
    then funRt.(n+1) = r by A7, RtI;
    then A8: funY.(n+1) = funY.n + 1 + 1 by A1, A3;
    funK.(funY.n + 1) <> 0 by A6, YStepNonSquare;
    then funSgn.(funK.(funY.n + 1)) = 1 by DefSgn;
    hence thesis by A2, A8;
  end;
end;

theorem YExpr:
  opBox.((opPlusI.(funSgn*funK))*funS) = funY
proof
  set B = opBox.((opPlusI.(funSgn*funK))*funS);
  defpred P[Nat] means B.$1 = funY.$1;
  0*0 <= 0 & 0 < (0+1)*(0+1);
  then funRt.0 = 0 by RtI;
  then funY.0 = 2*0 -' 0 by DefY .= 0 by XREAL_1:232;
  then A1: P[0] by DefBox;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    thus B.(n+1) = ((opPlusI.(funSgn*funK))*funS).(B.n) by DefBox
      .= (opPlusI.(funSgn*funK)).(funS.(funY.n)) by A3, CompVal
      .= funY.(n+1) by YStep;
  end;
  for n holds P[n] from NAT_1:sch 2(A1,A2);
  hence thesis by UFunExt;
end;

:: Rt = D - Y, Sq = (((1^+)^+ Rt)^+)^box and E = I - Sq Rt

theorem RtExprK:
  exprDminusF funY = funRt
proof
  now
    let x;
    A1: funY.x = 2*x -' funRt.x by DefY;
    then A2: funY.x <= 2*x by NAT_D:35;
    A3: funRt.x <= x by RtLe;
    2*x = x + x;
    then x <= 2*x by NAT_1:11;
    then A4: funRt.x <= 2*x by A3, XXREAL_0:2;
    thus (exprDminusF funY).x = 2*x -' funY.x by A2, DminusFVal
      .= funRt.x by A1, A4, NAT_D:58;
  end;
  hence thesis by UFunExt;
end;

theorem SqExprK:
  opBox.(opPlusI.((opPlusI.(opPlusI.(cst 1)))*funRt)) = funSq
proof
  set B = opBox.(opPlusI.((opPlusI.(opPlusI.(cst 1)))*funRt));
  defpred P[Nat] means B.$1 = $1*$1;
  A1: P[0] by DefBox;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    A4: funRt.(n*n) = n by RtSq;
    thus B.(n+1) = (opPlusI.((opPlusI.(opPlusI.(cst 1)))*funRt)).(n*n)
        by A3, DefBox
      .= ((opPlusI.(opPlusI.(cst 1)))*funRt).(n*n) + n*n by DefPlusI
      .= (opPlusI.(opPlusI.(cst 1))).n + n*n by A4, CompVal
      .= (opPlusI.(cst 1)).n + n + n*n by DefPlusI
      .= (cst 1).n + n + n + n*n by DefPlusI
      .= 1 + n + n + n*n by DefCst
      .= (n+1)*(n+1);
  end;
  A5: for n holds P[n] from NAT_1:sch 2(A1,A2);
  now
    let n;
    thus B.n = n*n by A5 .= funSq.n by DefSq;
  end;
  hence thesis by UFunExt;
end;

theorem EExprK:
  exprIminusF(funSq*funRt) = funE
proof
  now
    let x;
    A1: (funSq*funRt).x = funSq.(funRt.x) by CompVal
      .= funRt.x * funRt.x by DefSq;
    then (funSq*funRt).x <= x by DefRt;
    hence (exprIminusF(funSq*funRt)).x = x -' (funSq*funRt).x by IminusFVal
      .= funE.x by A1, DefE;
  end;
  hence thesis by UFunExt;
end;

theorem EInK:
  funE in C6K
proof
  A1: funS in C6K & funSgn in C6K & funK in C6K by C1S, C1Sgn, C1One;
  :: Z and the two differences
  A20: funS*funS in C6K by A1, C1Comp;
  opPlusI.funK in C6K by A1, C1PlusI;
  then A2: funS*funS*(opPlusI.funK) in C6K by A20, C1Comp;
  A3: funZ in C6K by A2, C1Box, ZExpr;
  funK*funS in C6K by A1, C1Comp;
  then funK*funS*funS in C6K by A1, C1Comp;
  then A4: funK*funS*funS*funS in C6K by A1, C1Comp;
  A5: for F st F in C6K holds exprIminusF F in C6K &
    exprDminusF F in C6K
  proof
    let F;
    assume F in C6K;
    then A6: opPlusI.F in C6K by C1PlusI;
    then funZ*(opPlusI.F) in C6K by A3, C1Comp;
    then opPlusI.(funZ*(opPlusI.F)) in C6K by C1PlusI;
    then opPlusI.(opPlusI.(funZ*(opPlusI.F))) in C6K by C1PlusI;
    hence exprIminusF F in C6K by A4, C1Comp;
    opPlusI.(opPlusI.F) in C6K by A6, C1PlusI;
    then funZ*(opPlusI.(opPlusI.F)) in C6K by A3, C1Comp;
    then opPlusI.(funZ*(opPlusI.(opPlusI.F))) in C6K by C1PlusI;
    then opPlusI.(opPlusI.(funZ*(opPlusI.(opPlusI.F)))) in C6K by C1PlusI;
    then opPlusI.(opPlusI.(opPlusI.(funZ*(opPlusI.(opPlusI.F))))) in C6K
      by C1PlusI;
    then opPlusI.(opPlusI.(opPlusI.(opPlusI.(funZ*(opPlusI.(opPlusI.F))))))
      in C6K by C1PlusI;
    hence thesis by A4, C1Comp;
  end;
  :: Y, Rt, Sq, E
  funSgn*funK in C6K by A1, C1Comp;
  then opPlusI.(funSgn*funK) in C6K by C1PlusI;
  then (opPlusI.(funSgn*funK))*funS in C6K by A1, C1Comp;
  then funY in C6K by C1Box, YExpr;
  then A7: funRt in C6K by A5, RtExprK;
  opPlusI.(cst 1) in C6K by C1One, C1PlusI;
  then opPlusI.(opPlusI.(cst 1)) in C6K by C1PlusI;
  then (opPlusI.(opPlusI.(cst 1)))*funRt in C6K by A7, C1Comp;
  then opPlusI.((opPlusI.(opPlusI.(cst 1)))*funRt) in C6K by C1PlusI;
  then funSq in C6K by C1Box, SqExprK;
  then funSq*funRt in C6K by A7, C1Comp;
  hence thesis by A5, EExprK;
end;

:: K = L 1^+ ((1^+)^+ L)^+, i.e. K(x) = L(x + 2L(x) + 2)
theorem KExprL:
  funL*(opPlusI.(cst 1))*(opPlusI.((opPlusI.(opPlusI.(cst 1)))*funL)) = funK
proof
  now
    let x;
    set t = funV.x, k = funK.x;
    A1: x = funA.t + k & k <= t by Decomp;
    set d = t -' k;
    A2: d + k = t by A1, XREAL_1:235;
    A3: funL.x = d by LEq;
    A4: (opPlusI.((opPlusI.(opPlusI.(cst 1)))*funL)).x
        = ((opPlusI.(opPlusI.(cst 1)))*funL).x + x by DefPlusI
       .= (opPlusI.(opPlusI.(cst 1))).d + x by A3, CompVal
       .= (opPlusI.(cst 1)).d + d + x by DefPlusI
       .= (cst 1).d + d + d + x by DefPlusI
       .= 1 + d + d + x by DefCst;
    A5: funA.(t+1) = funA.t + t + 1 by ASuc;
    A6: (funL*(opPlusI.(cst 1))).(1 + d + d + x)
        = funL.((opPlusI.(cst 1)).(1 + d + d + x)) by CompVal
       .= funL.((cst 1).(1 + d + d + x) + (1 + d + d + x)) by DefPlusI
       .= funL.(1 + (1 + d + d + x)) by DefCst
       .= funL.(funA.(t+1) + (d + 1)) by A1, A2, A5;
    d + 1 <= t + 1 by A2, NAT_1:11, XREAL_1:6;
    then A7: funL.(funA.(t+1) + (d + 1)) = (t + 1) -' (d + 1) by Diag;
    t + 1 = k + (d + 1) by A2;
    then A8: (t + 1) -' (d + 1) = k by NAT_D:34;
    thus (funL*(opPlusI.(cst 1))*
        (opPlusI.((opPlusI.(opPlusI.(cst 1)))*funL))).x
        = (funL*(opPlusI.(cst 1))).(1 + d + d + x) by A4, CompVal
       .= funK.x by A6, A7, A8;
  end;
  hence thesis by UFunExt;
end;

theorem KInL:
  funK in C6L
proof
  A1: funL in C6L & cst 1 in C6L by C1One;
  then A2: opPlusI.(cst 1) in C6L by C1PlusI;
  then opPlusI.(opPlusI.(cst 1)) in C6L by C1PlusI;
  then (opPlusI.(opPlusI.(cst 1)))*funL in C6L by A1, C1Comp;
  then A3: opPlusI.((opPlusI.(opPlusI.(cst 1)))*funL) in C6L by C1PlusI;
  funL*(opPlusI.(cst 1)) in C6L by A1, A2, C1Comp;
  hence thesis by A3, C1Comp, KExprL;
end;

theorem Theorem68:
  C6K = C6 & C6L = C6
proof
  A1: C6 c= C6K by C6Eq, EInK, C1Sub;
  C6K c= C6 by C6Eq, KIn, C1Sub;
  hence C6K = C6 by A1, XBOOLE_0:def 10;
  A2: C6L c= C6 by C6Eq, LIn, C1Sub;
  C6K c= C6L by KInL, C1Sub;
  then C6 c= C6L by A1, XBOOLE_1:1;
  hence thesis by A2, XBOOLE_0:def 10;
end;

begin

:: Remark 6.9: with iteration starting from 1, F^box(1)(0) = 1 and
:: F^box(1)(x+1) = F(F^box(1)(x)), the constant 1 can be dropped:
:: <E, F^+, FG, F^box(1)>, <K, F^+, FG, F^box(1)> and <L, F^+, FG, F^box(1)>
:: generate clos F as well.

definition
  func opBox1 -> UnOp of Funcs(NAT,NAT) means :DefBox1:
  for F being Element of Funcs(NAT,NAT) holds (it.F).0 = 1 &
    for x being Nat holds (it.F).(x+1) = F.((it.F).x);
  existence
  proof
    defpred P[object,object] means
      ex f,g being Element of Funcs(NAT,NAT) st f = $1 & g = $2 &
      g.0 = 1 & for x being Nat holds g.(x+1) = f.(g.x);
    A1: for F being Element of Funcs(NAT,NAT)
        ex g being Element of Funcs(NAT,NAT) st P[F,g]
    proof
      let F be Element of Funcs(NAT,NAT);
      deffunc R(Nat, Element of NAT) = F.$2;
      consider g being sequence of NAT such that
      B1: g.0 = 1 & for x being Nat holds g.(x+1) = R(x,g.x)
        from NAT_1:sch 12;
      reconsider g as Element of Funcs(NAT,NAT) by FUNCT_2:8;
      take g, F, g;
      thus thesis by B1;
    end;
    consider u being Function of Funcs(NAT,NAT),Funcs(NAT,NAT) such that
    A2: for F being Element of Funcs(NAT,NAT) holds P[F,u.F]
      from FUNCT_2:sch 3(A1);
    take u;
    let F be Element of Funcs(NAT,NAT);
    ex f,g being Element of Funcs(NAT,NAT) st f = F & g = u.F &
      g.0 = 1 & for x being Nat holds g.(x+1) = f.(g.x) by A2;
    hence thesis;
  end;
  uniqueness
  proof
    let u,v be UnOp of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT) holds (u.F).0 = 1 &
      for x being Nat holds (u.F).(x+1) = F.((u.F).x) and
    A2: for F being Element of Funcs(NAT,NAT) holds (v.F).0 = 1 &
      for x being Nat holds (v.F).(x+1) = F.((v.F).x);
    now
      let F be Element of Funcs(NAT,NAT);
      defpred P[Nat] means (u.F).$1 = (v.F).$1;
      (u.F).0 = 1 by A1 .= (v.F).0 by A2;
      then B1: P[0];
      B2: for x being Nat st P[x] holds P[x+1]
      proof
        let x be Nat;
        assume C1: P[x];
        thus (u.F).(x+1) = F.((u.F).x) by A1 .= (v.F).(x+1) by A2, C1;
      end;
      for x being Nat holds P[x] from NAT_1:sch 2(B1,B2);
      hence u.F = v.F by UFunExt;
    end;
    hence u = v by FUNCT_2:63;
  end;
end;

:: Recovering F^box from F^box(1) with a predecessor P^ (P^(x+1) = x):
:: F^box = P^ (S F P^)^box(1)
theorem BoxFromBox1:
  (for x holds H.(x+1) = x) implies H*(opBox1.(funS*F*H)) = opBox.F
proof
  assume A1: for x holds H.(x+1) = x;
  set B = opBox1.(funS*F*H);
  defpred P[Nat] means B.$1 = (opBox.F).$1 + 1;
  B.0 = 0 + 1 by DefBox1;
  then A2: P[0] by DefBox;
  A3: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A4: P[n];
    thus B.(n+1) = (funS*F*H).((opBox.F).n + 1) by A4, DefBox1
      .= (funS*F).(H.((opBox.F).n + 1)) by CompVal
      .= (funS*F).((opBox.F).n) by A1
      .= funS.(F.((opBox.F).n)) by CompVal
      .= F.((opBox.F).n) + 1 by DefS
      .= (opBox.F).(n+1) + 1 by DefBox;
  end;
  A5: for n holds P[n] from NAT_1:sch 2(A2,A3);
  now
    let n;
    thus (H*B).n = H.(B.n) by CompVal
      .= H.((opBox.F).n + 1) by A5
      .= (opBox.F).n by A1;
  end;
  hence thesis by UFunExt;
end;

:: F^box(1) is in clos F when F is: F^box(1) = P^ (T)^box S with
:: T(0) = 2 and T(y+1) = F(y) + 1, T = Sgn . (S F P^) + D O
theorem TimesIn:
  F in C6 & G in C6 implies opOtimes.(F,G) in C6
proof
  assume A1: F in C6 & G in C6;
  set H1 = funSq*(opPlus.(F,G));
  set H2 = opPlus.(funSq*F, funSq*G);
  opPlus.(F,G) in C6 by A1, Lemma66;
  then A2: H1 in C6 by SqIn, C6Comp;
  funSq*F in C6 & funSq*G in C6 by A1, SqIn, C6Comp;
  then A3: H2 in C6 by Lemma66;
  A4: for x holds H1.x = H2.x + 2*(F.x * G.x)
  proof
    let x;
    thus H1.x = funSq.((opPlus.(F,G)).x) by CompVal
      .= funSq.(F.x + G.x) by DefPlus
      .= (F.x + G.x)*(F.x + G.x) by DefSq
      .= (F.x * F.x + G.x * G.x) + 2*(F.x * G.x)
      .= (funSq.(F.x) + G.x * G.x) + 2*(F.x * G.x) by DefSq
      .= (funSq.(F.x) + funSq.(G.x)) + 2*(F.x * G.x) by DefSq
      .= ((funSq*F).x + funSq.(G.x)) + 2*(F.x * G.x) by CompVal
      .= ((funSq*F).x + (funSq*G).x) + 2*(F.x * G.x) by CompVal
      .= H2.x + 2*(F.x * G.x) by DefPlus;
  end;
  A5: for x holds H2.x <= H1.x
  proof
    let x;
    H1.x = H2.x + 2*(F.x * G.x) by A4;
    hence thesis by NAT_1:11;
  end;
  then A6: opMinus.(H1,H2) in C6 by A2, A3, Lemma66;
  now
    let x;
    thus (funHf*(opMinus.(H1,H2))).x = funHf.((opMinus.(H1,H2)).x) by CompVal
      .= funHf.(H1.x -' H2.x) by DefMinus
      .= funHf.(2*(F.x * G.x) + H2.x -' H2.x) by A4
      .= funHf.(2*(F.x * G.x)) by NAT_D:34
      .= (2*(F.x * G.x)) div 2 by DefHf
      .= F.x * G.x by NAT_D:18
      .= (opOtimes.(F,G)).x by DefOtimes;
  end;
  then funHf*(opMinus.(H1,H2)) = opOtimes.(F,G) by UFunExt;
  hence thesis by A6, HfIn, C6Comp;
end;

theorem Box1In:
  F in C6 implies opBox1.F in C6
proof
  assume A1: F in C6;
  set T = opPlus.(opOtimes.(funSgn, funS*F*exprPhat), funD*funO);
  set W = opBox.T;
  set u = opBox1.F;
  A2: T.0 = 2
  proof
    thus T.0 = (opOtimes.(funSgn, funS*F*exprPhat)).0 + (funD*funO).0
        by DefPlus
      .= funSgn.0 * (funS*F*exprPhat).0 + (funD*funO).0 by DefOtimes
      .= 0 * (funS*F*exprPhat).0 + (funD*funO).0 by DefSgn
      .= funD.(funO.0) by CompVal
      .= funD.1 by DefO
      .= 2*1 by DefD
      .= 2;
  end;
  A3: for y holds T.(y+1) = F.y + 1
  proof
    let y;
    thus T.(y+1) = (opOtimes.(funSgn, funS*F*exprPhat)).(y+1)
        + (funD*funO).(y+1) by DefPlus
      .= funSgn.(y+1) * (funS*F*exprPhat).(y+1) + (funD*funO).(y+1)
        by DefOtimes
      .= 1 * (funS*F*exprPhat).(y+1) + (funD*funO).(y+1) by DefSgn
      .= (funS*F*exprPhat).(y+1) + funD.(funO.(y+1)) by CompVal
      .= (funS*F*exprPhat).(y+1) + funD.0 by DefO
      .= (funS*F*exprPhat).(y+1) + 2*0 by DefD
      .= (funS*F).(exprPhat.(y+1)) by CompVal
      .= (funS*F).y by PhatVal
      .= funS.(F.y) by CompVal
      .= F.y + 1 by DefS;
  end;
  defpred P[Nat] means W.($1+1) = u.$1 + 1;
  W.(0+1) = T.(W.0) by DefBox .= T.0 by DefBox .= 1 + 1 by A2;
  then A4: P[0] by DefBox1;
  A5: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A6: P[n];
    thus W.(n+1+1) = T.(u.n + 1) by A6, DefBox
      .= F.(u.n) + 1 by A3
      .= u.(n+1) + 1 by DefBox1;
  end;
  A7: for n holds P[n] from NAT_1:sch 2(A4,A5);
  now
    let n;
    thus (exprPhat*W*funS).n = (exprPhat*W).(funS.n) by CompVal
      .= exprPhat.(W.(funS.n)) by CompVal
      .= exprPhat.(W.(n+1)) by DefS
      .= exprPhat.(u.n + 1) by A7
      .= u.n by PhatVal;
  end;
  then A8: exprPhat*W*funS = u by UFunExt;
  funS*F in C6 by A1, SIn, C6Comp;
  then funS*F*exprPhat in C6 by PhatIn, C6Comp;
  then A9: opOtimes.(funSgn, funS*F*exprPhat) in C6 by SgnIn, TimesIn;
  funD*funO in C6 by DIn, OIn, C6Comp;
  then T in C6 by A9, Lemma66;
  then W in C6 by C6Box;
  then exprPhat*W in C6 by PhatIn, C6Comp;
  hence thesis by A8, SIn, C6Comp;
end;

:: Bases <G, F^+, FG, F^box(1)> for a single initial function G

definition
  let G be Element of Funcs(NAT,NAT);
  func ClosB1 G -> Subset of Funcs(NAT,NAT) equals
  clos({G}, {opPlusI, opBox1}, {opComp});
  coherence;
end;

theorem CBG:
  G1 in ClosB1 G1
proof
  G1 in {G1} by TARSKI:def 1;
  hence thesis by ClosInit;
end;

theorem CBPlusI:
  F in ClosB1 G1 implies opPlusI.F in ClosB1 G1
proof
  assume A1: F in ClosB1 G1;
  opPlusI in {opPlusI, opBox1} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CBBox1:
  F in ClosB1 G1 implies opBox1.F in ClosB1 G1
proof
  assume A1: F in ClosB1 G1;
  opBox1 in {opPlusI, opBox1} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CBComp:
  F in ClosB1 G1 & G in ClosB1 G1 implies F*G in ClosB1 G1
proof
  assume A1: F in ClosB1 G1 & G in ClosB1 G1;
  A2: opComp in {opComp} by TARSKI:def 1;
  opComp.(F,G) = F*G by DefComp;
  hence thesis by A1, A2, ClosBinop;
end;

theorem CBSubC6:
  G1 in C6 implies ClosB1 G1 c= C6
proof
  assume A1: G1 in C6;
  C6 is_closed_under {G1}, {opPlusI, opBox1}, {opComp}
  proof
    thus {G1} c= C6
    proof
      let z be object;
      assume z in {G1};
      hence thesis by A1, TARSKI:def 1;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBox1} & F in C6 holds u.F in C6
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opPlusI, opBox1} & F in C6;
      then u = opPlusI or u = opBox1 by TARSKI:def 2;
      hence thesis by A2, C6PlusI, Box1In;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: b in {opComp} & F in C6 & G in C6;
    then b = opComp by TARSKI:def 1;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A3, C6Comp;
  end;
  hence thesis by ClosLeast;
end;

theorem CBSub:
  G1 in ClosB1 H implies ClosB1 G1 c= ClosB1 H
proof
  assume A1: G1 in ClosB1 H;
  ClosB1 H is_closed_under {G1}, {opPlusI, opBox1}, {opComp}
  proof
    thus {G1} c= ClosB1 H
    proof
      let z be object;
      assume z in {G1};
      hence thesis by A1, TARSKI:def 1;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBox1} & F in ClosB1 H holds u.F in ClosB1 H
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opPlusI, opBox1} & F in ClosB1 H;
      then u = opPlusI or u = opBox1 by TARSKI:def 2;
      hence thesis by A2, CBPlusI, CBBox1;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: b in {opComp} & F in ClosB1 H & G in ClosB1 H;
    then b = opComp by TARSKI:def 1;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A3, CBComp;
  end;
  hence thesis by ClosLeast;
end;

:: if 1 and a predecessor P^ are generated, the basis <1, G, F^+, FG, F^box>
:: is simulated
theorem CBSup:
  cst 1 in ClosB1 G1 & H in ClosB1 G1 & (for x holds H.(x+1) = x) implies
  Clos1 G1 c= ClosB1 G1
proof
  assume that A1: cst 1 in ClosB1 G1 and A2: H in ClosB1 G1 and
    A3: for x holds H.(x+1) = x;
  A4: funS in ClosB1 G1 by A1, CBPlusI, SExpr;
  ClosB1 G1 is_closed_under {cst 1, G1}, {opPlusI, opBox}, {opComp}
  proof
    thus {cst 1, G1} c= ClosB1 G1
    proof
      let z be object;
      assume z in {cst 1, G1};
      then z = cst 1 or z = G1 by TARSKI:def 2;
      hence thesis by A1, CBG;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBox} & F in ClosB1 G1 holds u.F in ClosB1 G1
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A5: u in {opPlusI, opBox} & F in ClosB1 G1;
      then A6: u = opPlusI or u = opBox by TARSKI:def 2;
      per cases by A6;
      suppose u = opPlusI;
        hence thesis by A5, CBPlusI;
      end;
      suppose A7: u = opBox;
        funS*F in ClosB1 G1 by A4, A5, CBComp;
        then funS*F*H in ClosB1 G1 by A2, CBComp;
        then opBox1.(funS*F*H) in ClosB1 G1 by CBBox1;
        then H*(opBox1.(funS*F*H)) in ClosB1 G1 by A2, CBComp;
        hence thesis by A3, A7, BoxFromBox1;
      end;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A8: b in {opComp} & F in ClosB1 G1 & G in ClosB1 G1;
    then b = opComp by TARSKI:def 1;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A8, CBComp;
  end;
  hence thesis by ClosLeast;
end;

:: (I) O = E^box(1), 0 = E O, 1 = O 0,
:: G = (((D Q S S)^+ S)^box(1))^box(1) with G(x) = (x+1)^2,
:: and P^ = E S S ((G^+)^+)^+

theorem OBox1:
  F.1 = 0 & F.0 = 0 implies opBox1.F = funO
proof
  assume A1: F.1 = 0 & F.0 = 0;
  set B = opBox1.F;
  defpred P[Nat] means B.($1+1) = 0;
  B.(0+1) = F.(B.0) by DefBox1 .= 0 by A1, DefBox1;
  then A2: P[0];
  A3: for n st P[n] holds P[n+1]
  proof
    let n;
    assume P[n];
    then B.(n+1+1) = F.0 by DefBox1;
    hence thesis by A1;
  end;
  A4: for n holds P[n] from NAT_1:sch 2(A2,A3);
  now
    let x;
    per cases by NAT_1:6;
    suppose A5: x = 0;
      hence B.x = 1 by DefBox1 .= funO.x by A5, DefO;
    end;
    suppose ex y st x = y+1;
      then consider y such that A5: x = y+1;
      thus B.x = 0 by A4, A5 .= funO.x by A5, DefO;
    end;
  end;
  hence thesis by UFunExt;
end;

theorem ZeroFromO:
  F.1 = 0 & F.0 = 0 implies F*funO = cst 0
proof
  assume A1: F.1 = 0 & F.0 = 0;
  now
    let x;
    A2: (F*funO).x = F.(funO.x) by CompVal;
    per cases;
    suppose x = 0;
      then funO.x = 1 by DefO;
      hence (F*funO).x = 0 by A1, A2 .= (cst 0).x by DefCst;
    end;
    suppose x <> 0;
      then funO.x = 0 by DefO;
      hence (F*funO).x = 0 by A1, A2 .= (cst 0).x by DefCst;
    end;
  end;
  hence thesis by UFunExt;
end;

theorem OneFromO:
  funO*(cst 0) = cst 1
proof
  now
    let x;
    thus (funO*(cst 0)).x = funO.((cst 0).x) by CompVal
      .= funO.0 by DefCst
      .= 1 by DefO
      .= (cst 1).x by DefCst;
  end;
  hence thesis by UFunExt;
end;

definition
  func funG -> Element of Funcs(NAT,NAT) means :DefG:
  for x being Nat holds it.x = (x+1)*(x+1);
  existence
  proof
    deffunc T(Nat) = ($1+1)*($1+1);
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = ($1+1)*($1+1);
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

theorem DQSVal:
  (funD*funQ*funS*funS).y = 2*(funQ.(y+2)) &
  (funD*funQ*funS*funS*funS).y = 2*(funQ.(y+3))
proof
  A1: for z being Nat holds (funD*funQ*funS*funS).z = 2*(funQ.(z+2))
  proof
    let z be Nat;
    thus (funD*funQ*funS*funS).z = (funD*funQ*funS).(funS.z) by CompVal
      .= (funD*funQ).(funS.(funS.z)) by CompVal
      .= funD.(funQ.(funS.(funS.z))) by CompVal
      .= funD.(funQ.(funS.(z+1))) by DefS
      .= funD.(funQ.(z+1+1)) by DefS
      .= 2*(funQ.(z+1+1)) by DefD
      .= 2*(funQ.(z+2));
  end;
  hence (funD*funQ*funS*funS).y = 2*(funQ.(y+2));
  thus (funD*funQ*funS*funS*funS).y = (funD*funQ*funS*funS).(funS.y) by CompVal
    .= (funD*funQ*funS*funS).(y+1) by DefS
    .= 2*(funQ.(y+1+2)) by A1
    .= 2*(funQ.(y+3));
end;

theorem GInner:
  (opBox1.((opPlusI.(funD*funQ*funS*funS))*funS)).n = funR.n + 1
proof
  set T1 = (opPlusI.(funD*funQ*funS*funS))*funS;
  set B = opBox1.T1;
  defpred P[Nat] means B.$1 = funR.$1 + 1;
  0*0 <= 0 & 0 < (0+1)*(0+1);
  then funRt.0 = 0 by RtI;
  then funR.0 = 0 + 2*0 by DefR;
  then A1: P[0] by DefBox1;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    set v = funR.n;
    A4: funS.(v+1) = v+1+1 by DefS;
    A5: funS.v = v+1 by DefS;
    A6: (opPlusI.(funD*funQ*funS*funS*funS)).(funS.v)
       = (funD*funQ*funS*funS*funS).(v+1) + (v+1) by A5, DefPlusI
      .= 2*(funQ.(v+1+3)) + (v+1) by DQSVal;
    thus B.(n+1) = T1.(v+1) by A3, DefBox1
      .= (opPlusI.(funD*funQ*funS*funS)).(funS.(v+1)) by CompVal
      .= (funD*funQ*funS*funS).(v+1+1) + (v+1+1) by A4, DefPlusI
      .= 2*(funQ.(v+1+1+2)) + (v+1+1) by DQSVal
      .= (opPlusI.(funD*funQ*funS*funS*funS)).(funS.v) + 1 by A6
      .= funR.(n+1) + 1 by RStep;
  end;
  for n holds P[n] from NAT_1:sch 2(A1,A2);
  hence thesis;
end;

theorem GExprI:
  opBox1.(opBox1.((opPlusI.(funD*funQ*funS*funS))*funS)) = funG
proof
  set T1 = (opPlusI.(funD*funQ*funS*funS))*funS;
  set B = opBox1.(opBox1.T1);
  defpred P[Nat] means B.$1 = ($1+1)*($1+1);
  A1: P[0] by DefBox1;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    A4: funRt.((n+1)*(n+1)) = n+1 by RtSq;
    thus B.(n+1) = (opBox1.T1).((n+1)*(n+1)) by A3, DefBox1
      .= funR.((n+1)*(n+1)) + 1 by GInner
      .= (n+1)*(n+1) + 2*(n+1) + 1 by A4, DefR
      .= (n+1+1)*(n+1+1);
  end;
  A5: for n holds P[n] from NAT_1:sch 2(A1,A2);
  now
    let n;
    thus B.n = (n+1)*(n+1) by A5 .= funG.n by DefG;
  end;
  hence thesis by UFunExt;
end;

definition
  func exprPhatI -> Element of Funcs(NAT,NAT) equals
  funE*funS*funS*(opPlusI.(opPlusI.(opPlusI.funG)));
  coherence;
end;

theorem PhatIVal:
  exprPhatI.(x+1) = x
proof
  set y = x+1;
  A1: (opPlusI.(opPlusI.(opPlusI.funG))).y
      = (opPlusI.(opPlusI.funG)).y + y by DefPlusI
     .= (opPlusI.funG).y + y + y by DefPlusI
     .= funG.y + y + y + y by DefPlusI
     .= (y+1)*(y+1) + y + y + y by DefG;
  2*(x+3) = x + (x+6);
  then A2: x <= 2*(x+3) by NAT_1:11;
  thus exprPhatI.y = (funE*funS*funS).((y+1)*(y+1) + y + y + y) by A1, CompVal
    .= funE.((y+1)*(y+1) + y + y + y + 2) by ESSVal
    .= funE.((x+3)*(x+3) + x)
    .= x by A2, ESqAdd;
end;

theorem Remark69I:
  ClosB1 funE = C6
proof
  set C = ClosB1 funE;
  A1: funE in C by CBG;
  opBox1.funE = funO by OBox1, ESmall;
  then A2: funO in C by A1, CBBox1;
  funE*funO = cst 0 by ZeroFromO, ESmall;
  then A3: cst 0 in C by A1, A2, CBComp;
  A4: cst 1 in C by A2, A3, CBComp, OneFromO;
  A5: funS in C by A4, CBPlusI, SExpr;
  opPlusI.(cst 0) in C by A3, CBPlusI;
  then A6: funD in C by CBPlusI, DExpr;
  A7: funQ in C by A1, A2, CBComp, QExpr;
  funD*funQ in C by A6, A7, CBComp;
  then funD*funQ*funS in C by A5, CBComp;
  then funD*funQ*funS*funS in C by A5, CBComp;
  then opPlusI.(funD*funQ*funS*funS) in C by CBPlusI;
  then (opPlusI.(funD*funQ*funS*funS))*funS in C by A5, CBComp;
  then opBox1.((opPlusI.(funD*funQ*funS*funS))*funS) in C by CBBox1;
  then funG in C by CBBox1, GExprI;
  then opPlusI.funG in C by CBPlusI;
  then opPlusI.(opPlusI.funG) in C by CBPlusI;
  then A8: opPlusI.(opPlusI.(opPlusI.funG)) in C by CBPlusI;
  funE*funS in C by A1, A5, CBComp;
  then funE*funS*funS in C by A5, CBComp;
  then exprPhatI in C by A8, CBComp;
  then A9: C6 c= C by A4, C6Eq, PhatIVal, CBSup;
  C c= C6 by C6E, CBSubC6;
  hence thesis by A9, XBOOLE_0:def 10;
end;

:: (II) O = K^box(1), 0 = K O, 1 = O 0, H = S (S K^+ S)^box(1) with
:: H(x) = A(x+1) + x + 1 = (x+1)(x+4)/2, and P^ = K S S S (H^+)^+

definition
  func funH -> Element of Funcs(NAT,NAT) means :DefH:
  for x being Nat holds it.x = funA.(x+1) + x + 1;
  existence
  proof
    deffunc T(Nat) = funA.($1+1) + $1 + 1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = funA.($1+1) + $1 + 1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

theorem TwoH:
  2*(funH.x) = (x+1)*(x+4)
proof
  2*(funH.x) = 2*(funA.(x+1) + x + 1) by DefH
    .= 2*(funA.(x+1)) + 2*x + 2
    .= (x+1)*(x+1) + (x+1) + 2*x + 2 by TwoA;
  hence thesis;
end;

theorem KSmall:
  funK.0 = 0 & funK.1 = 0
proof
  2*(funA.0) = 0*0 + 0 by TwoA;
  then funA.0 + 0 = 0;
  hence funK.0 = 0 by Diag;
  funA.1 + 0 = 1 by AOne;
  hence thesis by Diag;
end;

theorem HInner:
  (opBox1.(funS*(opPlusI.funK)*funS)).n = funA.(n+1) + n
proof
  set B = opBox1.(funS*(opPlusI.funK)*funS);
  defpred P[Nat] means B.$1 = funA.($1+1) + $1;
  A1: P[0] by AOne, DefBox1;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A3: P[n];
    A4: funK.(funA.(n+1) + (n+1)) = n+1 by Diag;
    A5: funA.(n+1+1) = funA.(n+1) + (n+1) + 1 by ASuc;
    A6: funS.(funA.(n+1) + n) = funA.(n+1) + n + 1 by DefS
      .= funA.(n+1) + (n+1);
    thus B.(n+1) = (funS*(opPlusI.funK)*funS).(funA.(n+1) + n) by A3, DefBox1
      .= (funS*(opPlusI.funK)).(funS.(funA.(n+1) + n)) by CompVal
      .= (funS*(opPlusI.funK)).(funA.(n+1) + (n+1)) by A6
      .= funS.((opPlusI.funK).(funA.(n+1) + (n+1))) by CompVal
      .= (opPlusI.funK).(funA.(n+1) + (n+1)) + 1 by DefS
      .= funK.(funA.(n+1) + (n+1)) + (funA.(n+1) + (n+1)) + 1 by DefPlusI
      .= funA.(n+1+1) + (n+1) by A4, A5;
  end;
  for n holds P[n] from NAT_1:sch 2(A1,A2);
  hence thesis;
end;

theorem HExprII:
  funS*(opBox1.(funS*(opPlusI.funK)*funS)) = funH
proof
  now
    let x;
    thus (funS*(opBox1.(funS*(opPlusI.funK)*funS))).x
        = funS.((opBox1.(funS*(opPlusI.funK)*funS)).x) by CompVal
       .= funS.(funA.(x+1) + x) by HInner
       .= funA.(x+1) + x + 1 by DefS
       .= funH.x by DefH;
  end;
  hence thesis by UFunExt;
end;

definition
  func exprPhatII -> Element of Funcs(NAT,NAT) equals
  funK*funS*funS*funS*(opPlusI.(opPlusI.funH));
  coherence;
end;

theorem PhatIIVal:
  exprPhatII.(x+1) = x
proof
  set y = x+1;
  A1: (opPlusI.(opPlusI.funH)).y = (opPlusI.funH).y + y by DefPlusI
    .= funH.y + y + y by DefPlusI
    .= funA.(y+1) + y + 1 + y + y by DefH;
  A2: funA.(x+2+1) = funA.(x+2) + (x+2) + 1 by ASuc;
  funA.(x+3+1) = funA.(x+3) + (x+3) + 1 by ASuc;
  then A3: funA.(x+4) = funA.(x+2) + 2*x + 7 by A2;
  A4: x <= x + 4 by NAT_1:11;
  thus exprPhatII.y = (funK*funS*funS*funS).(funA.(y+1) + y + 1 + y + y)
      by A1, CompVal
    .= funK.(funA.(y+1) + y + 1 + y + y + 3) by KSSSVal
    .= funK.(funA.(x+4) + x) by A3
    .= x by A4, Diag;
end;

theorem Remark69II:
  ClosB1 funK = C6
proof
  set C = ClosB1 funK;
  A1: funK in C by CBG;
  opBox1.funK = funO by OBox1, KSmall;
  then A2: funO in C by A1, CBBox1;
  funK*funO = cst 0 by ZeroFromO, KSmall;
  then A3: cst 0 in C by A1, A2, CBComp;
  A4: cst 1 in C by A2, A3, CBComp, OneFromO;
  A5: funS in C by A4, CBPlusI, SExpr;
  opPlusI.funK in C by A1, CBPlusI;
  then funS*(opPlusI.funK) in C by A5, CBComp;
  then funS*(opPlusI.funK)*funS in C by A5, CBComp;
  then opBox1.(funS*(opPlusI.funK)*funS) in C by CBBox1;
  then funH in C by A5, CBComp, HExprII;
  then opPlusI.funH in C by CBPlusI;
  then A6: opPlusI.(opPlusI.funH) in C by CBPlusI;
  funK*funS in C by A1, A5, CBComp;
  then funK*funS*funS in C by A5, CBComp;
  then funK*funS*funS*funS in C by A5, CBComp;
  then exprPhatII in C by A6, CBComp;
  then Clos1 funK c= C by A4, PhatIIVal, CBSup;
  then A7: C6 c= C by Theorem68;
  C c= C6 by KIn, CBSubC6;
  hence thesis by A7, XBOOLE_0:def 10;
end;

:: (III) 1 = L^box(1) (since L(1) = 1) and K = L 1^+ ((1^+)^+ L)^+

theorem LOne:
  funL.1 = 1
proof
  funL.(funA.1 + 0) = 1 -' 0 by Diag;
  hence thesis by AOne, NAT_D:40;
end;

theorem OneExprIII:
  opBox1.funL = cst 1
proof
  set B = opBox1.funL;
  defpred P[Nat] means B.$1 = 1;
  A1: P[0] by DefBox1;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    assume P[n];
    then B.(n+1) = funL.1 by DefBox1;
    hence thesis by LOne;
  end;
  A3: for n holds P[n] from NAT_1:sch 2(A1,A2);
  now
    let n;
    thus B.n = 1 by A3 .= (cst 1).n by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem Remark69III:
  ClosB1 funL = C6
proof
  set C = ClosB1 funL;
  A1: funL in C by CBG;
  then A2: cst 1 in C by CBBox1, OneExprIII;
  then A3: opPlusI.(cst 1) in C by CBPlusI;
  then opPlusI.(opPlusI.(cst 1)) in C by CBPlusI;
  then (opPlusI.(opPlusI.(cst 1)))*funL in C by A1, CBComp;
  then A4: opPlusI.((opPlusI.(opPlusI.(cst 1)))*funL) in C by CBPlusI;
  funL*(opPlusI.(cst 1)) in C by A1, A3, CBComp;
  then funK in C by A4, CBComp, KExprL;
  then ClosB1 funK c= C by CBSub;
  then A5: C6 c= C by Remark69II;
  C c= C6 by LIn, CBSubC6;
  hence thesis by A5, XBOOLE_0:def 10;
end;

theorem Remark69:
  ClosB1 funE = C6 & ClosB1 funK = C6 & ClosB1 funL = C6
  by Remark69I, Remark69II, Remark69III;

begin

:: Questions left open in the paper (solved here; see the README).
:: (1) Iteration from any a >= 2: <X, F^+, FG, F^box(a)> generates clos F
::     for X in {E, K, L}; with Remark 6.9 (a = 1) this covers every a >= 1.
:: (2) The shifted operator F^+b(x) = F(x) + x + b: <E, F^+b, FG, F^box>
::     generates clos F if and only if b >= 1.

reserve a,b,c,d,i,j for Nat;
reserve X,W for Element of Funcs(NAT,NAT);

:: iteration from a: F^box(a)(0) = a, F^box(a)(x+1) = F(F^box(a)(x))
definition
  let a be Nat;
  func opBoxA a -> UnOp of Funcs(NAT,NAT) means :DefBoxA:
  for F being Element of Funcs(NAT,NAT) holds (it.F).0 = a &
    for x being Nat holds (it.F).(x+1) = F.((it.F).x);
  existence
  proof
    reconsider a1 = a as Element of NAT by ORDINAL1:def 12;
    defpred P[object,object] means
      ex f,g being Element of Funcs(NAT,NAT) st f = $1 & g = $2 &
      g.0 = a & for x being Nat holds g.(x+1) = f.(g.x);
    A1: for F being Element of Funcs(NAT,NAT)
        ex g being Element of Funcs(NAT,NAT) st P[F,g]
    proof
      let F be Element of Funcs(NAT,NAT);
      deffunc R(Nat, Element of NAT) = F.$2;
      consider g being sequence of NAT such that
      B1: g.0 = a1 & for x being Nat holds g.(x+1) = R(x,g.x)
        from NAT_1:sch 12;
      reconsider g as Element of Funcs(NAT,NAT) by FUNCT_2:8;
      take g, F, g;
      thus thesis by B1;
    end;
    consider u being Function of Funcs(NAT,NAT),Funcs(NAT,NAT) such that
    A2: for F being Element of Funcs(NAT,NAT) holds P[F,u.F]
      from FUNCT_2:sch 3(A1);
    take u;
    let F be Element of Funcs(NAT,NAT);
    ex f,g being Element of Funcs(NAT,NAT) st f = F & g = u.F &
      g.0 = a & for x being Nat holds g.(x+1) = f.(g.x) by A2;
    hence thesis;
  end;
  uniqueness
  proof
    let u,v be UnOp of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT) holds (u.F).0 = a &
      for x being Nat holds (u.F).(x+1) = F.((u.F).x) and
    A2: for F being Element of Funcs(NAT,NAT) holds (v.F).0 = a &
      for x being Nat holds (v.F).(x+1) = F.((v.F).x);
    now
      let F be Element of Funcs(NAT,NAT);
      defpred P[Nat] means (u.F).$1 = (v.F).$1;
      (u.F).0 = a by A1 .= (v.F).0 by A2;
      then B1: P[0];
      B2: for x being Nat st P[x] holds P[x+1]
      proof
        let x be Nat;
        assume C1: P[x];
        thus (u.F).(x+1) = F.((u.F).x) by A1 .= (v.F).(x+1) by A2, C1;
      end;
      for x being Nat holds P[x] from NAT_1:sch 2(B1,B2);
      hence u.F = v.F by UFunExt;
    end;
    hence u = v by FUNCT_2:63;
  end;
end;

theorem BoxA1:
  opBoxA 1 = opBox1
proof
  for F being Element of Funcs(NAT,NAT) holds ((opBoxA 1).F).0 = 1 &
    for x being Nat holds ((opBoxA 1).F).(x+1) = F.(((opBoxA 1).F).x)
    by DefBoxA;
  hence thesis by DefBox1;
end;

:: M_r(x) = r x
definition
  let r be Nat;
  func funM r -> Element of Funcs(NAT,NAT) means :DefM:
  for x being Nat holds it.x = r*x;
  existence
  proof
    deffunc T(Nat) = r*$1;
    thus ex f being Element of Funcs(NAT,NAT) st
      for x being Nat holds f.x = T(x) from UFunEx;
  end;
  uniqueness
  proof
    deffunc T(Nat) = r*$1;
    let f,g be Element of Funcs(NAT,NAT) such that
    A1: for x being Nat holds f.x = T(x) and
    A2: for x being Nat holds g.x = T(x);
    thus f = g from UFunUq(A1,A2);
  end;
end;

theorem MVals:
  funM 0 = cst 0 & funM 1 = funI & funM 2 = funD &
  opPlusI.(funM r) = funM (r+1)
proof
  now
    let x;
    thus (funM 0).x = 0*x by DefM .= (cst 0).x by DefCst;
  end;
  hence funM 0 = cst 0 by UFunExt;
  now
    let x;
    thus (funM 1).x = 1*x by DefM .= funI.x by DefI;
  end;
  hence funM 1 = funI by UFunExt;
  now
    let x;
    thus (funM 2).x = 2*x by DefM .= funD.x by DefD;
  end;
  hence funM 2 = funD by UFunExt;
  now
    let x;
    thus (opPlusI.(funM r)).x = (funM r).x + x by DefPlusI
      .= r*x + x by DefM
      .= (r+1)*x
      .= (funM (r+1)).x by DefM;
  end;
  hence thesis by UFunExt;
end;

:: M_r = (...(0^+)^+...)^+ (r times) is in every closure with 0 and F^+
theorem MInClos:
  cst 0 in clos(I,U,B) & opPlusI in U implies funM r in clos(I,U,B)
proof
  assume that A1: cst 0 in clos(I,U,B) and A2: opPlusI in U;
  defpred P[Nat] means funM $1 in clos(I,U,B);
  A3: P[0] by A1, MVals;
  A4: for r st P[r] holds P[r+1]
  proof
    let r;
    assume P[r];
    then opPlusI.(funM r) in clos(I,U,B) by A2, ClosUnop;
    hence thesis by MVals;
  end;
  for r holds P[r] from NAT_1:sch 2(A3,A4);
  hence thesis;
end;

theorem CompIn:
  F in clos(I,U,{opComp}) & G in clos(I,U,{opComp}) implies
  F*G in clos(I,U,{opComp})
proof
  assume A1: F in clos(I,U,{opComp}) & G in clos(I,U,{opComp});
  A2: opComp in {opComp} by TARSKI:def 1;
  opComp.(F,G) = F*G by DefComp;
  hence thesis by A1, A2, ClosBinop;
end;

:: powers under composition: A^k G for a shift A(x) = x + c
theorem PowShift:
  W in clos(I,U,{opComp}) & (for x holds W.x = x + c) &
  G in clos(I,U,{opComp}) implies
  ex H st H in clos(I,U,{opComp}) & for x holds H.x = G.x + k*c
proof
  assume that A1: W in clos(I,U,{opComp}) and
    A2: for x holds W.x = x + c and A3: G in clos(I,U,{opComp});
  defpred P[Nat] means ex H st H in clos(I,U,{opComp}) &
    for x holds H.x = G.x + $1*c;
  A4: P[0]
  proof
    take G;
    thus G in clos(I,U,{opComp}) by A3;
    let x;
    thus G.x = G.x + 0*c;
  end;
  A5: for k st P[k] holds P[k+1]
  proof
    let k;
    assume P[k];
    then consider H such that A6: H in clos(I,U,{opComp}) and
      A7: for x holds H.x = G.x + k*c;
    take W*H;
    thus W*H in clos(I,U,{opComp}) by A1, A6, CompIn;
    let x;
    thus (W*H).x = W.(H.x) by CompVal
      .= H.x + c by A2
      .= G.x + k*c + c by A7
      .= G.x + (k+1)*c;
  end;
  for k holds P[k] from NAT_1:sch 2(A4,A5);
  hence thesis;
end;

:: powers of a predecessor: P^k G, and P^k(y + k) = y
theorem PowPred:
  W in clos(I,U,{opComp}) & (for x holds W.(x+1) = x) &
  G in clos(I,U,{opComp}) implies
  ex H st H in clos(I,U,{opComp}) & for x,y st G.x = y + k holds H.x = y
proof
  assume that A1: W in clos(I,U,{opComp}) and
    A2: for x holds W.(x+1) = x and A3: G in clos(I,U,{opComp});
  defpred P[Nat] means for G st G in clos(I,U,{opComp}) holds
    ex H st H in clos(I,U,{opComp}) & for x,y st G.x = y + $1 holds H.x = y;
  A4: P[0]
  proof
    let G;
    assume A5: G in clos(I,U,{opComp});
    take G;
    thus G in clos(I,U,{opComp}) by A5;
    let x,y;
    assume G.x = y + 0;
    hence thesis;
  end;
  A6: for k st P[k] holds P[k+1]
  proof
    let k;
    assume A7: P[k];
    let G;
    assume G in clos(I,U,{opComp});
    then W*G in clos(I,U,{opComp}) by A1, CompIn;
    then consider H such that A8: H in clos(I,U,{opComp}) and
      A9: for x,y st (W*G).x = y + k holds H.x = y by A7;
    take H;
    thus H in clos(I,U,{opComp}) by A8;
    let x,y;
    assume A10: G.x = y + (k+1);
    (W*G).x = W.(G.x) by CompVal
      .= W.((y+k)+1) by A10
      .= y + k by A2;
    hence thesis by A9;
  end;
  for k holds P[k] from NAT_1:sch 2(A4,A6);
  hence thesis by A3;
end;

:: powers of a decreasing X (X(0) = 0, X(y) < y for y > 0) reach 0
theorem PowDec:
  X in clos(I,U,{opComp}) & X.0 = 0 & (for y st 0 < y holds X.y < y) &
  G in clos(I,U,{opComp}) & (for x holds G.x <= k) implies
  ex H st H in clos(I,U,{opComp}) & for x holds H.x = 0
proof
  assume that A1: X in clos(I,U,{opComp}) and A2: X.0 = 0 and
    A3: for y st 0 < y holds X.y < y;
  defpred P[Nat] means for G st G in clos(I,U,{opComp}) &
    (for x holds G.x <= $1) holds
    ex H st H in clos(I,U,{opComp}) & for x holds H.x = 0;
  A4: P[0]
  proof
    let G;
    assume A5: G in clos(I,U,{opComp}) & for x holds G.x <= 0;
    take G;
    thus G in clos(I,U,{opComp}) by A5;
    let x;
    G.x <= 0 & 0 <= G.x by A5, NAT_1:2;
    hence thesis by XXREAL_0:1;
  end;
  A6: for k st P[k] holds P[k+1]
  proof
    let k;
    assume A7: P[k];
    let G;
    assume A8: G in clos(I,U,{opComp}) & for x holds G.x <= k+1;
    A9: X*G in clos(I,U,{opComp}) by A1, A8, CompIn;
    for x holds (X*G).x <= k
    proof
      let x;
      A10: (X*G).x = X.(G.x) by CompVal;
      per cases;
      suppose G.x = 0;
        hence thesis by A2, A10, NAT_1:2;
      end;
      suppose G.x <> 0;
        then X.(G.x) < G.x by A3, NAT_1:3;
        then A11: X.(G.x) + 1 <= G.x by NAT_1:13;
        G.x <= k + 1 by A8;
        then X.(G.x) + 1 <= k + 1 by A11, XXREAL_0:2;
        hence thesis by A10, XREAL_1:6;
      end;
    end;
    hence thesis by A7, A9;
  end;
  A11: for k holds P[k] from NAT_1:sch 2(A4,A6);
  assume G in clos(I,U,{opComp}) & for x holds G.x <= k;
  hence thesis by A11;
end;

:: recovering iteration from 0 out of iteration from a (cf. Remark 5.10):
:: F^box = P^a (S^a F P^a)^box(a)
theorem BoxFromBoxA:
  (for y holds W.(y+a) = y) & (for x holds X.x = x + a) implies
  W*((opBoxA a).(X*F*W)) = opBox.F
proof
  assume that A1: for y holds W.(y+a) = y and A2: for x holds X.x = x + a;
  set T = (opBoxA a).(X*F*W);
  defpred P[Nat] means T.$1 = (opBox.F).$1 + a;
  T.0 = 0 + a by DefBoxA;
  then A3: P[0] by DefBox;
  A4: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A5: P[n];
    thus T.(n+1) = (X*F*W).((opBox.F).n + a) by A5, DefBoxA
      .= (X*F).(W.((opBox.F).n + a)) by CompVal
      .= (X*F).((opBox.F).n) by A1
      .= X.(F.((opBox.F).n)) by CompVal
      .= F.((opBox.F).n) + a by A2
      .= (opBox.F).(n+1) + a by DefBox;
  end;
  A6: for n holds P[n] from NAT_1:sch 2(A3,A4);
  now
    let n;
    thus (W*T).n = W.(T.n) by CompVal
      .= W.((opBox.F).n + a) by A6
      .= (opBox.F).n by A1;
  end;
  hence thesis by UFunExt;
end;

:: soundness: clos F is closed under F^box(a).  As in Box1In,
:: F^box(a) = P^ T^box S with T(0) = a+1, T(y+1) = F(y) + 1,
:: T = Sgn . (S F P^) + M_(a+1) O
theorem BoxAIn:
  F in C6 implies (opBoxA a).F in C6
proof
  assume A1: F in C6;
  set T = opPlus.(opOtimes.(funSgn, funS*F*exprPhat), (funM (a+1))*funO);
  set W = opBox.T;
  set u = (opBoxA a).F;
  A2: T.0 = a + 1
  proof
    thus T.0 = (opOtimes.(funSgn, funS*F*exprPhat)).0 + ((funM (a+1))*funO).0
        by DefPlus
      .= funSgn.0 * (funS*F*exprPhat).0 + ((funM (a+1))*funO).0 by DefOtimes
      .= 0 * (funS*F*exprPhat).0 + ((funM (a+1))*funO).0 by DefSgn
      .= (funM (a+1)).(funO.0) by CompVal
      .= (funM (a+1)).1 by DefO
      .= (a+1)*1 by DefM
      .= a + 1;
  end;
  A3: for y holds T.(y+1) = F.y + 1
  proof
    let y;
    thus T.(y+1) = (opOtimes.(funSgn, funS*F*exprPhat)).(y+1)
        + ((funM (a+1))*funO).(y+1) by DefPlus
      .= funSgn.(y+1) * (funS*F*exprPhat).(y+1) + ((funM (a+1))*funO).(y+1)
        by DefOtimes
      .= 1 * (funS*F*exprPhat).(y+1) + ((funM (a+1))*funO).(y+1) by DefSgn
      .= (funS*F*exprPhat).(y+1) + (funM (a+1)).(funO.(y+1)) by CompVal
      .= (funS*F*exprPhat).(y+1) + (funM (a+1)).0 by DefO
      .= (funS*F*exprPhat).(y+1) + (a+1)*0 by DefM
      .= (funS*F).(exprPhat.(y+1)) by CompVal
      .= (funS*F).y by PhatVal
      .= funS.(F.y) by CompVal
      .= F.y + 1 by DefS;
  end;
  defpred P[Nat] means W.($1+1) = u.$1 + 1;
  W.(0+1) = T.(W.0) by DefBox .= T.0 by DefBox .= a + 1 by A2;
  then A4: P[0] by DefBoxA;
  A5: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A6: P[n];
    thus W.(n+1+1) = T.(u.n + 1) by A6, DefBox
      .= F.(u.n) + 1 by A3
      .= u.(n+1) + 1 by DefBoxA;
  end;
  A7: for n holds P[n] from NAT_1:sch 2(A4,A5);
  now
    let n;
    thus (exprPhat*W*funS).n = (exprPhat*W).(funS.n) by CompVal
      .= exprPhat.(W.(funS.n)) by CompVal
      .= exprPhat.(W.(n+1)) by DefS
      .= exprPhat.(u.n + 1) by A7
      .= u.n by PhatVal;
  end;
  then A8: exprPhat*W*funS = u by UFunExt;
  funS*F in C6 by A1, SIn, C6Comp;
  then funS*F*exprPhat in C6 by PhatIn, C6Comp;
  then A9: opOtimes.(funSgn, funS*F*exprPhat) in C6 by SgnIn, TimesIn;
  opPlusI in {opPlusI, opBox} by TARSKI:def 2;
  then funM (a+1) in C6 by ZeroIn, MInClos;
  then (funM (a+1))*funO in C6 by OIn, C6Comp;
  then T in C6 by A9, Lemma66;
  then W in C6 by C6Box;
  then exprPhat*W in C6 by PhatIn, C6Comp;
  hence thesis by A8, SIn, C6Comp;
end;

:: Bases <G, F^+, FG, F^box(a)> for a single initial function G

definition
  let G be Element of Funcs(NAT,NAT), a be Nat;
  func ClosBa(G,a) -> Subset of Funcs(NAT,NAT) equals
  clos({G}, {opPlusI, opBoxA a}, {opComp});
  coherence;
end;

theorem CBaG:
  G1 in ClosBa(G1,a)
proof
  G1 in {G1} by TARSKI:def 1;
  hence thesis by ClosInit;
end;

theorem CBaPlusI:
  F in ClosBa(G1,a) implies opPlusI.F in ClosBa(G1,a)
proof
  assume A1: F in ClosBa(G1,a);
  opPlusI in {opPlusI, opBoxA a} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CBaBoxA:
  F in ClosBa(G1,a) implies (opBoxA a).F in ClosBa(G1,a)
proof
  assume A1: F in ClosBa(G1,a);
  opBoxA a in {opPlusI, opBoxA a} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CBaComp:
  F in ClosBa(G1,a) & G in ClosBa(G1,a) implies F*G in ClosBa(G1,a)
  by CompIn;

theorem CBaB1:
  ClosBa(G1,1) = ClosB1 G1 by BoxA1;

theorem CBaSubC6:
  G1 in C6 implies ClosBa(G1,a) c= C6
proof
  assume A1: G1 in C6;
  C6 is_closed_under {G1}, {opPlusI, opBoxA a}, {opComp}
  proof
    thus {G1} c= C6
    proof
      let z be object;
      assume z in {G1};
      hence thesis by A1, TARSKI:def 1;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBoxA a} & F in C6 holds u.F in C6
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opPlusI, opBoxA a} & F in C6;
      then u = opPlusI or u = opBoxA a by TARSKI:def 2;
      hence thesis by A2, C6PlusI, BoxAIn;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: b in {opComp} & F in C6 & G in C6;
    then b = opComp by TARSKI:def 1;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A3, C6Comp;
  end;
  hence thesis by ClosLeast;
end;

theorem CBaSub:
  G1 in ClosBa(H,a) implies ClosBa(G1,a) c= ClosBa(H,a)
proof
  assume A1: G1 in ClosBa(H,a);
  ClosBa(H,a) is_closed_under {G1}, {opPlusI, opBoxA a}, {opComp}
  proof
    thus {G1} c= ClosBa(H,a)
    proof
      let z be object;
      assume z in {G1};
      hence thesis by A1, TARSKI:def 1;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBoxA a} & F in ClosBa(H,a) holds u.F in ClosBa(H,a)
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opPlusI, opBoxA a} & F in ClosBa(H,a);
      then u = opPlusI or u = opBoxA a by TARSKI:def 2;
      hence thesis by A2, CBaPlusI, CBaBoxA;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: b in {opComp} & F in ClosBa(H,a) & G in ClosBa(H,a);
    then b = opComp by TARSKI:def 1;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A3, CBaComp;
  end;
  hence thesis by ClosLeast;
end;

:: if 1 is generated and the closure is closed under F^box, the basis
:: <1, X, F^+, FG, F^box> is simulated
theorem CBaSup:
  cst 1 in ClosBa(X,a) &
  (for F st F in ClosBa(X,a) holds opBox.F in ClosBa(X,a)) implies
  Clos1 X c= ClosBa(X,a)
proof
  assume that A1: cst 1 in ClosBa(X,a) and
    A2: for F st F in ClosBa(X,a) holds opBox.F in ClosBa(X,a);
  ClosBa(X,a) is_closed_under {cst 1, X}, {opPlusI, opBox}, {opComp}
  proof
    thus {cst 1, X} c= ClosBa(X,a)
    proof
      let z be object;
      assume z in {cst 1, X};
      then z = cst 1 or z = X by TARSKI:def 2;
      hence thesis by A1, CBaG;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBox} & F in ClosBa(X,a) holds u.F in ClosBa(X,a)
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A3: u in {opPlusI, opBox} & F in ClosBa(X,a);
      then u = opPlusI or u = opBox by TARSKI:def 2;
      hence thesis by A2, A3, CBaPlusI;
    end;
    let b be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A4: b in {opComp} & F in ClosBa(X,a) & G in ClosBa(X,a);
    then b = opComp by TARSKI:def 1;
    then b.(F,G) = F*G by DefComp;
    hence thesis by A4, CBaComp;
  end;
  hence thesis by ClosLeast;
end;

:: The common part.  From 0 and multipliers r with X(r(i+1)) = i, the
:: chain N = T_2 ... T_(k+1), T_j = X M_r(j), maps k+1 to 1 and 0 to 0
theorem ExtAChain:
  cst 0 in ClosBa(X,a) & X.0 = 0 &
  (for i st 1 <= i ex r st X.(r*(i+1)) = i) implies
  ex W st W in ClosBa(X,a) & W.(k+1) = 1 & W.0 = 0
proof
  assume that A1: cst 0 in ClosBa(X,a) and A2: X.0 = 0 and
    A3: for i st 1 <= i ex r st X.(r*(i+1)) = i;
  A4: opPlusI in {opPlusI, opBoxA a} by TARSKI:def 2;
  defpred P[Nat] means ex W st W in ClosBa(X,a) & W.($1+1) = 1 & W.0 = 0;
  A5: P[0]
  proof
    take funI;
    funM 1 in ClosBa(X,a) by A1, A4, MInClos;
    hence funI in ClosBa(X,a) by MVals;
    thus funI.(0+1) = 1 by DefI;
    thus thesis by DefI;
  end;
  A6: for k st P[k] holds P[k+1]
  proof
    let k;
    assume P[k];
    then consider W such that A7: W in ClosBa(X,a) and A8: W.(k+1) = 1
      and A9: W.0 = 0;
    1 <= k+1 by NAT_1:11;
    then consider r such that A10: X.(r*(k+1+1)) = k+1 by A3;
    A12: X in ClosBa(X,a) by CBaG;
    funM r in ClosBa(X,a) by A1, A4, MInClos;
    then X*(funM r) in ClosBa(X,a) by A12, CBaComp;
    then A11: W*(X*(funM r)) in ClosBa(X,a) by A7, CBaComp;
    take W*(X*(funM r));
    thus W*(X*(funM r)) in ClosBa(X,a) by A11;
    thus (W*(X*(funM r))).(k+1+1) = W.((X*(funM r)).(k+1+1)) by CompVal
      .= W.(X.((funM r).(k+1+1))) by CompVal
      .= W.(X.(r*(k+1+1))) by DefM
      .= 1 by A8, A10;
    thus (W*(X*(funM r))).0 = W.((X*(funM r)).0) by CompVal
      .= W.(X.((funM r).0)) by CompVal
      .= W.(X.(r*0)) by DefM
      .= 0 by A2, A9;
  end;
  for k holds P[k] from NAT_1:sch 2(A5,A6);
  hence thesis;
end;

:: I = M_1, D = M_2, 1 = N I^box(a) (I^box(a) = cst a), S = 1^+ and the
:: cosignum O = N 0^box(a) (0^box(a) has values a, 0, 0, ...)
theorem ExtABasics:
  2 <= a & cst 0 in ClosBa(X,a) & X.0 = 0 &
  (for i st 1 <= i ex r st X.(r*(i+1)) = i) implies
  funI in ClosBa(X,a) & funD in ClosBa(X,a) & cst 1 in ClosBa(X,a) &
  funS in ClosBa(X,a) & funO in ClosBa(X,a)
proof
  assume that A1: 2 <= a and A2: cst 0 in ClosBa(X,a) and A3: X.0 = 0 and
    A4: for i st 1 <= i ex r st X.(r*(i+1)) = i;
  A5: opPlusI in {opPlusI, opBoxA a} by TARSKI:def 2;
  funM 1 in ClosBa(X,a) by A2, A5, MInClos;
  hence A6: funI in ClosBa(X,a) by MVals;
  funM 2 in ClosBa(X,a) by A2, A5, MInClos;
  hence funD in ClosBa(X,a) by MVals;
  consider c such that A7: a = 2 + c by A1, NAT_1:10;
  consider W such that A8: W in ClosBa(X,a) and A9: W.(c+1+1) = 1 and
    A10: W.0 = 0 by A2, A3, A4, ExtAChain;
  A11: W.a = 1 by A7, A9;
  defpred P[Nat] means ((opBoxA a).funI).$1 = a;
  A12: P[0] by DefBoxA;
  A13: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A14: P[n];
    thus ((opBoxA a).funI).(n+1) = funI.(((opBoxA a).funI).n) by DefBoxA
      .= a by A14, DefI;
  end;
  A15: for n holds P[n] from NAT_1:sch 2(A12,A13);
  now
    let x;
    thus (W*((opBoxA a).funI)).x = W.(((opBoxA a).funI).x) by CompVal
      .= 1 by A11, A15
      .= (cst 1).x by DefCst;
  end;
  then A16: W*((opBoxA a).funI) = cst 1 by UFunExt;
  (opBoxA a).funI in ClosBa(X,a) by A6, CBaBoxA;
  hence A17: cst 1 in ClosBa(X,a) by A8, A16, CBaComp;
  thus funS in ClosBa(X,a) by A17, CBaPlusI, SExpr;
  now
    let x;
    A18: (W*((opBoxA a).(cst 0))).x = W.(((opBoxA a).(cst 0)).x) by CompVal;
    per cases by NAT_1:6;
    suppose A19: x = 0;
      hence (W*((opBoxA a).(cst 0))).x = W.a by A18, DefBoxA
        .= funO.x by A11, A19, DefO;
    end;
    suppose ex y st x = y+1;
      then consider y such that A20: x = y+1;
      thus (W*((opBoxA a).(cst 0))).x
          = W.((cst 0).(((opBoxA a).(cst 0)).y)) by A18, A20, DefBoxA
        .= 0 by A10, DefCst
        .= funO.x by A20, DefO;
    end;
  end;
  then A21: W*((opBoxA a).(cst 0)) = funO by UFunExt;
  (opBoxA a).(cst 0) in ClosBa(X,a) by A2, CBaBoxA;
  hence thesis by A8, A21, CBaComp;
end;

:: with a predecessor in the closure, iteration from 0 is available
theorem ExtABox:
  funI in ClosBa(X,a) & funS in ClosBa(X,a) & W in ClosBa(X,a) &
  (for x holds W.(x+1) = x) & F in ClosBa(X,a) implies
  opBox.F in ClosBa(X,a)
proof
  assume that A1: funI in ClosBa(X,a) and A2: funS in ClosBa(X,a) and
    A3: W in ClosBa(X,a) and A4: for x holds W.(x+1) = x and
    A5: F in ClosBa(X,a);
  A6: for x holds funS.x = x + 1 by DefS;
  consider Sa being Element of Funcs(NAT,NAT) such that
    A7: Sa in ClosBa(X,a) and A8: for x holds Sa.x = funI.x + a*1
    by A1, A2, A6, PowShift;
  consider Pa being Element of Funcs(NAT,NAT) such that
    A9: Pa in ClosBa(X,a) and A10: for x,y st funI.x = y + a holds Pa.x = y
    by A1, A3, A4, PowPred;
  A11: for y holds Pa.(y+a) = y
  proof
    let y;
    funI.(y+a) = y + a by DefI;
    hence thesis by A10;
  end;
  A12: for x holds Sa.x = x + a
  proof
    let x;
    thus Sa.x = funI.x + a*1 by A8 .= x + a by DefI;
  end;
  Sa*F in ClosBa(X,a) by A5, A7, CBaComp;
  then Sa*F*Pa in ClosBa(X,a) by A9, CBaComp;
  then (opBoxA a).(Sa*F*Pa) in ClosBa(X,a) by CBaBoxA;
  then Pa*((opBoxA a).(Sa*F*Pa)) in ClosBa(X,a) by A9, CBaComp;
  hence thesis by A11, A12, BoxFromBoxA;
end;

:: for X with X(0) = 0 and X(y) < y for y > 0: 0 = X^a X^box(a)
theorem BoxABound:
  X.0 = 0 & (for y st 0 < y holds X.y < y) implies ((opBoxA a).X).n <= a
proof
  assume that A1: X.0 = 0 and A2: for y st 0 < y holds X.y < y;
  defpred P[Nat] means ((opBoxA a).X).$1 <= a;
  A3: P[0] by DefBoxA;
  A4: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A5: P[n];
    set v = ((opBoxA a).X).n;
    A6: ((opBoxA a).X).(n+1) = X.v by DefBoxA;
    per cases;
    suppose v = 0;
      hence thesis by A1, A6, NAT_1:2;
    end;
    suppose v <> 0;
      then X.v < v by A2, NAT_1:3;
      hence thesis by A5, A6, XXREAL_0:2;
    end;
  end;
  for n holds P[n] from NAT_1:sch 2(A3,A4);
  hence thesis;
end;

theorem ZeroDec:
  X.0 = 0 & (for y st 0 < y holds X.y < y) implies cst 0 in ClosBa(X,a)
proof
  assume that A1: X.0 = 0 and A2: for y st 0 < y holds X.y < y;
  A3: X in ClosBa(X,a) by CBaG;
  then A4: (opBoxA a).X in ClosBa(X,a) by CBaBoxA;
  for x holds ((opBoxA a).X).x <= a by A1, A2, BoxABound;
  then consider H such that A5: H in ClosBa(X,a) and
    A6: for x holds H.x = 0 by A1, A2, A3, A4, PowDec;
  now
    let x;
    thus H.x = 0 by A6 .= (cst 0).x by DefCst;
  end;
  hence thesis by A5, UFunExt;
end;

:: The case X = E

theorem ELt:
  0 < y implies funE.y < y
proof
  assume A1: 0 < y;
  A2: funE.y + funRt.y * funRt.y = y by EVal;
  funRt.y <> 0
  proof
    assume funRt.y = 0;
    then y < (0+1)*(0+1) by DefRt;
    hence contradiction by A1, NAT_1:14;
  end;
  then 1 <= funRt.y by NAT_1:14;
  then 1*1 <= funRt.y * funRt.y by XREAL_1:66;
  then funE.y + 1 <= y by A2, XREAL_1:6;
  hence thesis by NAT_1:13;
end;

theorem XmE:
  ex r st funE.(r*(i+1)) = i
proof
  take i;
  i <= i + i by NAT_1:11;
  then i <= 2*i;
  then funE.(i*i + i) = i by ESqAdd;
  hence thesis;
end;

theorem RRec:
  funR.(t+1) = 2*(funQ.(funR.t + 4)) + funR.t + 1
proof
  set v = funR.t;
  A1: funS.v = v+1 by DefS;
  thus funR.(t+1) = (opPlusI.(funD*funQ*funS*funS*funS)).(funS.v) by RStep
    .= (funD*funQ*funS*funS*funS).(v+1) + (v+1) by A1, DefPlusI
    .= 2*(funQ.(v+1+3)) + (v+1) by DQSVal
    .= 2*(funQ.(v + 4)) + v + 1;
end;

:: B = (S (D Q S^c)^+)^box(a), c = a^2 + a + 4: B(n) + a^2 + a = R(n + a^2)
theorem BEVal:
  (for x holds W.x = x + (a*a + a + 4)) implies
  ((opBoxA a).(funS*(opPlusI.(funD*funQ*W)))).n + a*a + a = funR.(n + a*a)
proof
  assume A1: for x holds W.x = x + (a*a + a + 4);
  set HE = funS*(opPlusI.(funD*funQ*W));
  set BE = (opBoxA a).HE;
  A2: for y holds HE.y = 2*(funQ.(y + (a*a+a+4))) + y + 1
  proof
    let y;
    thus HE.y = funS.((opPlusI.(funD*funQ*W)).y) by CompVal
      .= (opPlusI.(funD*funQ*W)).y + 1 by DefS
      .= (funD*funQ*W).y + y + 1 by DefPlusI
      .= (funD*funQ).(W.y) + y + 1 by CompVal
      .= funD.(funQ.(W.y)) + y + 1 by CompVal
      .= 2*(funQ.(W.y)) + y + 1 by DefD
      .= 2*(funQ.(y + (a*a+a+4))) + y + 1 by A1;
  end;
  defpred P[Nat] means BE.$1 + a*a + a = funR.($1 + a*a);
  A3: funRt.(a*a) = a by RtSq;
  A4: BE.0 = a by DefBoxA;
  funR.(0 + a*a) = a*a + 2*(funRt.(a*a)) by DefR .= a*a + 2*a by A3;
  then A5: P[0] by A4;
  A6: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A7: P[n];
    set v = funR.(n + a*a);
    A8: BE.n + (a*a + a + 4) = v + 4 by A7;
    BE.(n+1) = HE.(BE.n) by DefBoxA
      .= 2*(funQ.(BE.n + (a*a+a+4))) + BE.n + 1 by A2
      .= 2*(funQ.(v + 4)) + BE.n + 1 by A8;
    hence BE.(n+1) + a*a + a = 2*(funQ.(v + 4)) + v + 1 by A7
      .= funR.(n + a*a + 1) by RRec
      .= funR.(n + 1 + a*a);
  end;
  for n holds P[n] from NAT_1:sch 2(A5,A6);
  hence thesis;
end;

:: G = (S^(a+1) B)^box(a) satisfies G(n) = n^2 + 2an + a
theorem GEVal:
  (for x holds W.x = x + (a*a + a + 4)) & (for x holds X.x = x + (a+1))
  implies
  ((opBoxA a).(X*((opBoxA a).(funS*(opPlusI.(funD*funQ*W)))))).n
    = n*n + 2*a*n + a
proof
  assume that A1: for x holds W.x = x + (a*a + a + 4) and
    A2: for x holds X.x = x + (a+1);
  set BE = (opBoxA a).(funS*(opPlusI.(funD*funQ*W)));
  set GE = (opBoxA a).(X*BE);
  defpred P[Nat] means GE.$1 = $1*$1 + 2*a*$1 + a;
  GE.0 = a by DefBoxA;
  then A3: P[0];
  A4: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A5: P[n];
    set g = n*n + 2*a*n + a;
    a <= a + (2*n + a) by NAT_1:11;
    then a <= 2*(n+a);
    then funRt.((n+a)*(n+a) + a) = n + a by RtSqAdd;
    then A6: funRt.(g + a*a) = n + a;
    BE.g + a*a + a = funR.(g + a*a) by A1, BEVal
      .= g + a*a + 2*(n+a) by A6, DefR;
    then A7: BE.g = g + 2*n + a;
    thus GE.(n+1) = (X*BE).g by A5, DefBoxA
      .= X.(BE.g) by CompVal
      .= BE.g + (a+1) by A2
      .= (n+1)*(n+1) + 2*a*(n+1) + a by A7;
  end;
  for n holds P[n] from NAT_1:sch 2(A3,A4);
  hence thesis;
end;

:: with a = c + 2 and d = a^2 - a - 1 = c^2 + 3c + 1, P^ = E S^d G^+ is
:: a predecessor
theorem PEVal:
  (for n holds G.n = n*n + 2*(c+2)*n + (c+2)) &
  (for x holds H.x = x + (c*c + 3*c + 1)) implies
  (funE*H*(opPlusI.G)).(k+1) = k
proof
  assume that A1: for n holds G.n = n*n + 2*(c+2)*n + (c+2) and
    A2: for x holds H.x = x + (c*c + 3*c + 1);
  k <= k + (k + 2 + 2*(c+2)) by NAT_1:11;
  then k <= 2*(k+1+(c+2));
  then A3: funE.((k+1+(c+2))*(k+1+(c+2)) + k) = k by ESqAdd;
  thus (funE*H*(opPlusI.G)).(k+1) = (funE*H).((opPlusI.G).(k+1)) by CompVal
    .= funE.(H.((opPlusI.G).(k+1))) by CompVal
    .= funE.((opPlusI.G).(k+1) + (c*c + 3*c + 1)) by A2
    .= funE.(G.(k+1) + (k+1) + (c*c + 3*c + 1)) by DefPlusI
    .= funE.((k+1)*(k+1) + 2*(c+2)*(k+1) + (c+2) + (k+1)
      + (c*c + 3*c + 1)) by A1
    .= k by A3;
end;

theorem ExtAE:
  2 <= a implies ClosBa(funE,a) = C6
proof
  assume A1: 2 <= a;
  set C = ClosBa(funE,a);
  consider c such that A2: a = 2 + c by A1, NAT_1:10;
  A3: funE.0 = 0 by ESmall;
  A4: cst 0 in C by A3, ELt, ZeroDec;
  A5: for i st 1 <= i ex r st funE.(r*(i+1)) = i by XmE;
  then A6: funI in C & funD in C & cst 1 in C & funS in C & funO in C
    by A1, A3, A4, ExtABasics;
  A0: funE in C by CBaG;
  funO*funE in C by A0, A6, CBaComp;
  then A7: funQ in C by QExpr;
  A8: for x holds funS.x = x + 1 by DefS;
  consider W such that A9: W in C and
    A10: for x holds W.x = funI.x + (a*a+a+4)*1 by A6, A8, PowShift;
  consider X such that A11: X in C and
    A12: for x holds X.x = funI.x + (a+1)*1 by A6, A8, PowShift;
  consider H such that A13: H in C and
    A14: for x holds H.x = funI.x + (c*c+3*c+1)*1 by A6, A8, PowShift;
  A15: for x holds W.x = x + (a*a+a+4)
  proof
    let x;
    thus W.x = funI.x + (a*a+a+4)*1 by A10 .= x + (a*a+a+4) by DefI;
  end;
  A16: for x holds X.x = x + (a+1)
  proof
    let x;
    thus X.x = funI.x + (a+1)*1 by A12 .= x + (a+1) by DefI;
  end;
  A17: for x holds H.x = x + (c*c+3*c+1)
  proof
    let x;
    thus H.x = funI.x + (c*c+3*c+1)*1 by A14 .= x + (c*c+3*c+1) by DefI;
  end;
  set GE = (opBoxA a).(X*((opBoxA a).(funS*(opPlusI.(funD*funQ*W)))));
  set PE = funE*H*(opPlusI.GE);
  funD*funQ in C by A6, A7, CBaComp;
  then funD*funQ*W in C by A9, CBaComp;
  then opPlusI.(funD*funQ*W) in C by CBaPlusI;
  then funS*(opPlusI.(funD*funQ*W)) in C by A6, CBaComp;
  then (opBoxA a).(funS*(opPlusI.(funD*funQ*W))) in C by CBaBoxA;
  then X*((opBoxA a).(funS*(opPlusI.(funD*funQ*W)))) in C by A11, CBaComp;
  then GE in C by CBaBoxA;
  then A18: opPlusI.GE in C by CBaPlusI;
  funE*H in C by A0, A13, CBaComp;
  then A19: PE in C by A18, CBaComp;
  A20: for n holds GE.n = n*n + 2*(c+2)*n + (c+2)
  proof
    let n;
    thus GE.n = n*n + 2*a*n + a by A15, A16, GEVal
      .= n*n + 2*(c+2)*n + (c+2) by A2;
  end;
  A21: for k holds PE.(k+1) = k by A17, A20, PEVal;
  for F st F in C holds opBox.F in C by A6, A19, A21, ExtABox;
  then Clos1 funE c= C by A6, CBaSup;
  then A22: C6 c= C by C6Eq;
  C c= C6 by C6E, CBaSubC6;
  hence thesis by A22, XBOOLE_0:def 10;
end;

:: The case X = K

theorem AZero:
  funA.0 = 0
proof
  2*(funA.0) = 0*0 + 0 by TwoA;
  hence thesis;
end;

theorem KLt:
  0 < y implies funK.y < y
proof
  assume A1: 0 < y;
  A2: y = funA.(funV.y) + funK.y & funK.y <= funV.y by Decomp;
  funV.y <> 0
  proof
    assume A3: funV.y = 0;
    then funK.y <= 0 & 0 <= funK.y by A2, NAT_1:2;
    then A4: funK.y = 0 by XXREAL_0:1;
    y = funA.0 + 0 by A2, A3, A4 .= 0 by AZero;
    hence contradiction by A1;
  end;
  then 1 <= funV.y by NAT_1:14;
  then funA.1 <= funA.(funV.y) by AMono;
  then 1 <= funA.(funV.y) by AOne;
  then funK.y + 1 <= y by A2, XREAL_1:6;
  hence thesis by NAT_1:13;
end;

theorem XmK:
  ex r st funK.(r*(i+1)) = i
proof
  take 2*i;
  2*(funA.(2*i)) = (2*i)*(2*i) + 2*i by TwoA;
  then A1: (2*i)*(i+1) = funA.(2*i) + i;
  i <= i + i by NAT_1:11;
  then i <= 2*i;
  then funK.(funA.(2*i) + i) = i by Diag;
  hence thesis by A1;
end;

theorem SSVal:
  (funS*funS).x = x + 2
proof
  thus (funS*funS).x = funS.(funS.x) by CompVal
    .= funS.x + 1 by DefS
    .= x + 1 + 1 by DefS
    .= x + 2;
end;

:: with c = A(a), B = (S S (K S^c)^+)^box(a) satisfies
:: B(n) + A(a) + 1 = A(n + a + 1)
theorem BKVal:
  (for x holds W.x = x + funA.a) implies
  ((opBoxA a).(funS*funS*(opPlusI.(funK*W)))).n + funA.a + 1
    = funA.(n + a + 1)
proof
  assume A1: for x holds W.x = x + funA.a;
  set BK = (opBoxA a).(funS*funS*(opPlusI.(funK*W)));
  defpred P[Nat] means BK.$1 + funA.a + 1 = funA.($1 + a + 1);
  BK.0 = a by DefBoxA;
  then A2: P[0] by ASuc;
  A3: for n st P[n] holds P[n+1]
  proof
    let n;
    assume A4: P[n];
    A5: funA.(n+a+1) = funA.(n+a) + (n+a) + 1 by ASuc;
    then A6: BK.n + funA.a = funA.(n+a) + (n+a) by A4;
    n + a <= n + a;
    then A7: funK.(BK.n + funA.a) = n + a by A6, Diag;
    BK.(n+1) = (funS*funS*(opPlusI.(funK*W))).(BK.n) by DefBoxA
      .= (funS*funS).((opPlusI.(funK*W)).(BK.n)) by CompVal
      .= (opPlusI.(funK*W)).(BK.n) + 2 by SSVal
      .= (funK*W).(BK.n) + BK.n + 2 by DefPlusI
      .= funK.(W.(BK.n)) + BK.n + 2 by CompVal
      .= funK.(BK.n + funA.a) + BK.n + 2 by A1
      .= n + a + BK.n + 2 by A7;
    hence BK.(n+1) + funA.a + 1 = funA.(n+a+1) + (n+a+1) + 1 by A4
      .= funA.(n+1+a+1) by ASuc;
  end;
  for n holds P[n] from NAT_1:sch 2(A2,A3);
  hence thesis;
end;

:: P^ = K S^c B^+ is a predecessor
theorem PKVal:
  (for x holds W.x = x + funA.a) &
  G = (opBoxA a).(funS*funS*(opPlusI.(funK*W))) implies
  (funK*W*(opPlusI.G)).(k+1) = k
proof
  assume that A1: for x holds W.x = x + funA.a and
    A2: G = (opBoxA a).(funS*funS*(opPlusI.(funK*W)));
  A3: G.(k+1) + funA.a + 1 = funA.(k+1+a+1) by A1, A2, BKVal;
  k <= k + (a+2) by NAT_1:11;
  then A4: funK.(funA.(k+a+2) + k) = k by Diag;
  thus (funK*W*(opPlusI.G)).(k+1) = (funK*W).((opPlusI.G).(k+1)) by CompVal
    .= funK.(W.((opPlusI.G).(k+1))) by CompVal
    .= funK.((opPlusI.G).(k+1) + funA.a) by A1
    .= funK.(G.(k+1) + (k+1) + funA.a) by DefPlusI
    .= funK.(funA.(k+a+2) + k) by A3
    .= k by A4;
end;

theorem ExtAK:
  2 <= a implies ClosBa(funK,a) = C6
proof
  assume A1: 2 <= a;
  set C = ClosBa(funK,a);
  A2: funK.0 = 0 by KSmall;
  A3: cst 0 in C by A2, KLt, ZeroDec;
  A4: for i st 1 <= i ex r st funK.(r*(i+1)) = i by XmK;
  then A5: funI in C & funD in C & cst 1 in C & funS in C & funO in C
    by A1, A2, A3, ExtABasics;
  A6: funK in C by CBaG;
  A7: for x holds funS.x = x + 1 by DefS;
  consider W such that A8: W in C and
    A9: for x holds W.x = funI.x + (funA.a)*1 by A5, A7, PowShift;
  A10: for x holds W.x = x + funA.a
  proof
    let x;
    thus W.x = funI.x + (funA.a)*1 by A9 .= x + funA.a by DefI;
  end;
  set G = (opBoxA a).(funS*funS*(opPlusI.(funK*W)));
  set PK = funK*W*(opPlusI.G);
  funK*W in C by A6, A8, CBaComp;
  then A11: opPlusI.(funK*W) in C by CBaPlusI;
  funS*funS in C by A5, CBaComp;
  then funS*funS*(opPlusI.(funK*W)) in C by A11, CBaComp;
  then G in C by CBaBoxA;
  then A12: opPlusI.G in C by CBaPlusI;
  funK*W in C by A6, A8, CBaComp;
  then A13: PK in C by A12, CBaComp;
  A14: for k holds PK.(k+1) = k by A10, PKVal;
  for F st F in C holds opBox.F in C by A5, A13, A14, ExtABox;
  then Clos1 funK c= C by A5, CBaSup;
  then A15: C6 c= C by Theorem68;
  C c= C6 by KIn, CBaSubC6;
  hence thesis by A15, XBOOLE_0:def 10;
end;

:: The case X = L: 0 = L L^+, and K = L 1^+ ((1^+)^+ L)^+ as in Theorem 6.8

theorem ZeroExprL:
  funL*(opPlusI.funL) = cst 0
proof
  now
    let x;
    set t = funV.x, k = funK.x;
    A1: x = funA.t + k & k <= t by Decomp;
    A2: funL.x = t -' k by LEq;
    t -' k + k = t by A1, XREAL_1:235;
    then A3: funL.x + x = funA.t + t by A1, A2;
    A4: t <= t;
    thus (funL*(opPlusI.funL)).x = funL.((opPlusI.funL).x) by CompVal
      .= funL.(funL.x + x) by DefPlusI
      .= funL.(funA.t + t) by A3
      .= t -' t by A4, Diag
      .= 0 + t -' t
      .= 0 by NAT_D:34
      .= (cst 0).x by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem XmL:
  ex r st funL.(r*(i+1)) = i
proof
  take 2*(i+1);
  2*(funA.(2*i+1)) = (2*i+1)*(2*i+1) + (2*i+1) by TwoA;
  then A1: (2*(i+1))*(i+1) = funA.(2*i+1) + (i+1);
  i+1 <= i+1 + i by NAT_1:11;
  then i+1 <= 2*i+1;
  then funL.(funA.(2*i+1) + (i+1)) = 2*i+1 -' (i+1) by Diag
    .= i + (i+1) -' (i+1)
    .= i by NAT_D:34;
  hence thesis by A1;
end;

theorem LZero:
  funL.0 = 0
proof
  A1: 0 <= 0;
  funL.(funA.0 + 0) = 0 -' 0 by A1, Diag
    .= 0 + 0 -' 0
    .= 0 by NAT_D:34;
  hence thesis by AZero;
end;

theorem ExtAL:
  2 <= a implies ClosBa(funL,a) = C6
proof
  assume A1: 2 <= a;
  set C = ClosBa(funL,a);
  A2: funL in C by CBaG;
  then opPlusI.funL in C by CBaPlusI;
  then funL*(opPlusI.funL) in C by A2, CBaComp;
  then A3: cst 0 in C by ZeroExprL;
  A4: for i st 1 <= i ex r st funL.(r*(i+1)) = i by XmL;
  A5: cst 1 in C by A1, A3, A4, LZero, ExtABasics;
  then A6: opPlusI.(cst 1) in C by CBaPlusI;
  then opPlusI.(opPlusI.(cst 1)) in C by CBaPlusI;
  then (opPlusI.(opPlusI.(cst 1)))*funL in C by A2, CBaComp;
  then A7: opPlusI.((opPlusI.(opPlusI.(cst 1)))*funL) in C by CBaPlusI;
  funL*(opPlusI.(cst 1)) in C by A2, A6, CBaComp;
  then funK in C by A7, CBaComp, KExprL;
  then ClosBa(funK,a) c= C by CBaSub;
  then A8: C6 c= C by A1, ExtAK;
  C c= C6 by LIn, CBaSubC6;
  hence thesis by A8, XBOOLE_0:def 10;
end;

:: Every starting value a >= 1 (a = 1 is Remark 6.9)
theorem ExtA:
  1 <= a implies
  ClosBa(funE,a) = C6 & ClosBa(funK,a) = C6 & ClosBa(funL,a) = C6
proof
  assume A1: 1 <= a;
  per cases;
  suppose A2: a = 1;
    hence ClosBa(funE,a) = ClosB1 funE by CBaB1 .= C6 by Remark69;
    thus ClosBa(funK,a) = ClosB1 funK by A2, CBaB1 .= C6 by Remark69;
    thus ClosBa(funL,a) = ClosB1 funL by A2, CBaB1 .= C6 by Remark69;
  end;
  suppose a <> 1;
    then 1 < a by A1, XXREAL_0:1;
    then 1 + 1 <= a by NAT_1:13;
    hence thesis by ExtAE, ExtAK, ExtAL;
  end;
end;

:: The shifted operator F^+b(x) = F(x) + x + b

definition
  let b be Nat;
  func opPlusIb b -> UnOp of Funcs(NAT,NAT) means :DefPlusIb:
  for F being Element of Funcs(NAT,NAT), x being Nat holds
    (it.F).x = F.x + x + b;
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = $1.$2 + $2 + b;
    thus ex u being UnOp of Funcs(NAT,NAT) st
      for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) from UOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = $1.$2 + $2 + b;
    let u,v be UnOp of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) and
    A2: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (v.F).x = T(F,x);
    thus u = v from UOpUq(A1,A2);
  end;
end;

:: the basis <E, F^+b, FG, F^box>
definition
  let b be Nat;
  func ClosVb b -> Subset of Funcs(NAT,NAT) equals
  clos({funE}, {opPlusIb b, opBox}, {opComp});
  coherence;
end;

theorem CVbE:
  funE in ClosVb b
proof
  funE in {funE} by TARSKI:def 1;
  hence thesis by ClosInit;
end;

theorem CVbPlusIb:
  F in ClosVb b implies (opPlusIb b).F in ClosVb b
proof
  assume A1: F in ClosVb b;
  opPlusIb b in {opPlusIb b, opBox} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CVbBox:
  F in ClosVb b implies opBox.F in ClosVb b
proof
  assume A1: F in ClosVb b;
  opBox in {opPlusIb b, opBox} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CVbComp:
  F in ClosVb b & G in ClosVb b implies F*G in ClosVb b
  by CompIn;

:: soundness: F^+b = F^+ + M_b 1
theorem PlusIbIn:
  F in C6 implies (opPlusIb b).F in C6
proof
  assume A1: F in C6;
  opPlusI in {opPlusI, opBox} by TARSKI:def 2;
  then funM b in C6 by ZeroIn, MInClos;
  then A2: (funM b)*(cst 1) in C6 by C6One, C6Comp;
  opPlusI.F in C6 by A1, C6PlusI;
  then A3: opPlus.(opPlusI.F, (funM b)*(cst 1)) in C6 by A2, Lemma66;
  now
    let x;
    thus (opPlus.(opPlusI.F, (funM b)*(cst 1))).x
        = (opPlusI.F).x + ((funM b)*(cst 1)).x by DefPlus
      .= F.x + x + ((funM b)*(cst 1)).x by DefPlusI
      .= F.x + x + (funM b).((cst 1).x) by CompVal
      .= F.x + x + (funM b).1 by DefCst
      .= F.x + x + b*1 by DefM
      .= ((opPlusIb b).F).x by DefPlusIb;
  end;
  hence thesis by A3, UFunExt;
end;

theorem CVbSubC6:
  ClosVb b c= C6
proof
  C6 is_closed_under {funE}, {opPlusIb b, opBox}, {opComp}
  proof
    thus {funE} c= C6
    proof
      let z be object;
      assume z in {funE};
      hence thesis by C6E, TARSKI:def 1;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusIb b, opBox} & F in C6 holds u.F in C6
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A1: u in {opPlusIb b, opBox} & F in C6;
      then u = opPlusIb b or u = opBox by TARSKI:def 2;
      hence thesis by A1, PlusIbIn, C6Box;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A2: c in {opComp} & F in C6 & G in C6;
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A2, C6Comp;
  end;
  hence thesis by ClosLeast;
end;

:: For b = c + 1 >= 1:  0 = E^box, A = 0^+b (A(x) = x + b),
:: C = E A^c 0 (the constant c), B = C^+b (B(x) = x + 2c + 1),
:: T = B^(2c) A A (T(x) = x + 4c^2 + 4c + 2), G = (A^3 (E T)^+b)^box
:: (G(n) = n^2 + 4bn), P^ = E A^(4b+1) ((G^+b)^+b)^+b (a predecessor),
:: S = P^^c A, 1 = S 0 and F^+ = P^^b F^+b
theorem ExtVb:
  1 <= b implies ClosVb b = C6
proof
  assume A1: 1 <= b;
  consider c such that A2: b = 1 + c by A1, NAT_1:10;
  set C = ClosVb b;
  A3: funE in C by CVbE;
  set Z = opBox.funE;
  A4: Z in C by A3, CVbBox;
  defpred P[Nat] means Z.$1 = 0;
  A5: P[0] by DefBox;
  A6: for n st P[n] holds P[n+1]
  proof
    let n;
    assume P[n];
    then Z.(n+1) = funE.0 by DefBox;
    hence thesis by ESmall;
  end;
  A0: for n holds P[n] from NAT_1:sch 2(A5,A6);
  A7: for x holds Z.x = 0 by A0;
  set Ab = (opPlusIb b).Z;
  A8: Ab in C by A4, CVbPlusIb;
  A9: for x holds Ab.x = x + b
  proof
    let x;
    Z.x = 0 by A7;
    hence Ab.x = 0 + x + b by DefPlusIb .= x + b;
  end;
  consider H0 being Element of Funcs(NAT,NAT) such that
    A10: H0 in C and A11: for x holds H0.x = Z.x + c*b by A4, A8, A9, PowShift;
  set Cb = funE*H0;
  A12: Cb in C by A3, A10, CVbComp;
  c <= c + c by NAT_1:11;
  then c <= 2*c;
  then A13: funE.(c*c + c) = c by ESqAdd;
  A14: for x holds Cb.x = c
  proof
    let x;
    thus Cb.x = funE.(H0.x) by CompVal
      .= funE.(Z.x + c*b) by A11
      .= funE.(0 + c*(1+c)) by A2, A7
      .= c by A13;
  end;
  set Bb = (opPlusIb b).Cb;
  A15: Bb in C by A12, CVbPlusIb;
  A16: for x holds Bb.x = x + (2*c+1)
  proof
    let x;
    thus Bb.x = Cb.x + x + b by DefPlusIb .= c + x + b by A14
      .= x + (2*c+1) by A2;
  end;
  A17: Ab*Ab in C by A8, CVbComp;
  consider Tb being Element of Funcs(NAT,NAT) such that
    A18: Tb in C and A19: for x holds Tb.x = (Ab*Ab).x + (2*c)*(2*c+1)
    by A15, A16, A17, PowShift;
  A20: for x holds Tb.x = x + (4*c*c + 4*c + 2)
  proof
    let x;
    thus Tb.x = (Ab*Ab).x + (2*c)*(2*c+1) by A19
      .= Ab.(Ab.x) + (2*c)*(2*c+1) by CompVal
      .= Ab.(x + b) + (2*c)*(2*c+1) by A9
      .= x + b + b + (2*c)*(2*c+1) by A9
      .= x + (4*c*c + 4*c + 2) by A2;
  end;
  set Hp = (opPlusIb b).(funE*Tb);
  funE*Tb in C by A3, A18, CVbComp;
  then A21: Hp in C by CVbPlusIb;
  consider Hb being Element of Funcs(NAT,NAT) such that
    A22: Hb in C and A23: for x holds Hb.x = Hp.x + 3*b
    by A8, A9, A21, PowShift;
  A24: for y holds Hb.y = funE.(Tb.y) + y + 4*b
  proof
    let y;
    thus Hb.y = Hp.y + 3*b by A23
      .= (funE*Tb).y + y + b + 3*b by DefPlusIb
      .= funE.(Tb.y) + y + b + 3*b by CompVal
      .= funE.(Tb.y) + y + 4*b;
  end;
  set Gb = opBox.Hb;
  A25: Gb in C by A22, CVbBox;
  defpred Q[Nat] means Gb.$1 = $1*$1 + 4*b*$1;
  Gb.0 = 0 by DefBox;
  then A26: Q[0];
  A27: for n st Q[n] holds Q[n+1]
  proof
    let n;
    assume A28: Q[n];
    set g = n*n + 4*b*n;
    2*n+1 <= (2*n+1) + (4*c+1) by NAT_1:11;
    then 2*n+1 <= 2*(n+2*c+1);
    then A29: funE.((n+2*c+1)*(n+2*c+1) + (2*n+1)) = 2*n+1 by ESqAdd;
    A30: funE.(Tb.g) = funE.(g + (4*c*c + 4*c + 2)) by A20
      .= funE.((n+2*c+1)*(n+2*c+1) + (2*n+1)) by A2
      .= 2*n+1 by A29;
    thus Gb.(n+1) = Hb.(Gb.n) by DefBox
      .= funE.(Tb.g) + g + 4*b by A24, A28
      .= (n+1)*(n+1) + 4*b*(n+1) by A30;
  end;
  A31: for n holds Q[n] from NAT_1:sch 2(A26,A27);
  set G3 = (opPlusIb b).((opPlusIb b).((opPlusIb b).Gb));
  (opPlusIb b).Gb in C by A25, CVbPlusIb;
  then (opPlusIb b).((opPlusIb b).Gb) in C by CVbPlusIb;
  then A32: G3 in C by CVbPlusIb;
  A33: for x holds G3.x = Gb.x + 3*x + 3*b
  proof
    let x;
    thus G3.x = ((opPlusIb b).((opPlusIb b).Gb)).x + x + b by DefPlusIb
      .= ((opPlusIb b).Gb).x + x + b + x + b by DefPlusIb
      .= Gb.x + x + b + x + b + x + b by DefPlusIb
      .= Gb.x + 3*x + 3*b;
  end;
  consider P4 being Element of Funcs(NAT,NAT) such that
    A34: P4 in C and A35: for x holds P4.x = G3.x + (4*b+1)*b
    by A8, A9, A32, PowShift;
  set Pb = funE*P4;
  A36: Pb in C by A3, A34, CVbComp;
  A37: for k holds Pb.(k+1) = k
  proof
    let k;
    k <= k + (k + 4*b + 4) by NAT_1:11;
    then k <= 2*(k + 2*b + 2);
    then A38: funE.((k + 2*b + 2)*(k + 2*b + 2) + k) = k by ESqAdd;
    thus Pb.(k+1) = funE.(P4.(k+1)) by CompVal
      .= funE.(G3.(k+1) + (4*b+1)*b) by A35
      .= funE.(Gb.(k+1) + 3*(k+1) + 3*b + (4*b+1)*b) by A33
      .= funE.((k+1)*(k+1) + 4*b*(k+1) + 3*(k+1) + 3*b + (4*b+1)*b) by A31
      .= k by A38;
  end;
  consider Sb being Element of Funcs(NAT,NAT) such that
    A39: Sb in C and A40: for x,y st Ab.x = y + c holds Sb.x = y
    by A8, A36, A37, PowPred;
  now
    let x;
    Ab.x = x + b by A9 .= (x+1) + c by A2;
    hence Sb.x = x + 1 by A40 .= funS.x by DefS;
  end;
  then A41: funS in C by A39, UFunExt;
  now
    let x;
    thus (funS*Z).x = funS.(Z.x) by CompVal .= Z.x + 1 by DefS
      .= 0 + 1 by A7 .= (cst 1).x by DefCst;
  end;
  then funS*Z = cst 1 by UFunExt;
  then A42: cst 1 in C by A4, A41, CVbComp;
  A43: for F st F in C holds opPlusI.F in C
  proof
    let F;
    assume F in C;
    then A44: (opPlusIb b).F in C by CVbPlusIb;
    then consider Q1 being Element of Funcs(NAT,NAT) such that
      A45: Q1 in C and
      A46: for x,y st ((opPlusIb b).F).x = y + b holds Q1.x = y
      by A36, A37, PowPred;
    now
      let x;
      ((opPlusIb b).F).x = (F.x + x) + b by DefPlusIb;
      hence Q1.x = F.x + x by A46 .= (opPlusI.F).x by DefPlusI;
    end;
    hence thesis by A45, UFunExt;
  end;
  C is_closed_under {cst 1, funE}, {opPlusI, opBox}, {opComp}
  proof
    thus {cst 1, funE} c= C
    proof
      let z be object;
      assume z in {cst 1, funE};
      then z = cst 1 or z = funE by TARSKI:def 2;
      hence thesis by A3, A42;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opBox} & F in C holds u.F in C
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A47: u in {opPlusI, opBox} & F in C;
      then u = opPlusI or u = opBox by TARSKI:def 2;
      hence thesis by A43, A47, CVbBox;
    end;
    let d be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A48: d in {opComp} & F in C & G in C;
    then d = opComp by TARSKI:def 1;
    then d.(F,G) = F*G by DefComp;
    hence thesis by A48, CVbComp;
  end;
  then A49: C6 c= C by ClosLeast;
  C c= C6 by CVbSubC6;
  hence thesis by A49, XBOOLE_0:def 10;
end;

:: b = 0: every function generated by <E, F^+, FG, F^box> fixes 0, so the
:: constant 1 is not generated
theorem ExtVb0:
  ClosVb 0 <> C6
proof
  defpred P[object] means ex F st F = $1 & F.0 = 0;
  consider Y being Subset of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT) holds F in Y iff P[F]
    from SUBSET_1:sch 3;
  A2: for F holds F in Y iff F.0 = 0
  proof
    let F;
    thus F in Y implies F.0 = 0
    proof
      assume F in Y;
      then ex G st G = F & G.0 = 0 by A1;
      hence thesis;
    end;
    assume F.0 = 0;
    hence thesis by A1;
  end;
  Y is_closed_under {funE}, {opPlusIb 0, opBox}, {opComp}
  proof
    thus {funE} c= Y
    proof
      let z be object;
      assume z in {funE};
      then z = funE by TARSKI:def 1;
      hence thesis by A2, ESmall;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusIb 0, opBox} & F in Y holds u.F in Y
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A3: u in {opPlusIb 0, opBox} & F in Y;
      then A4: F.0 = 0 by A2;
      per cases by A3, TARSKI:def 2;
      suppose A5: u = opPlusIb 0;
        (u.F).0 = F.0 + 0 + 0 by A5, DefPlusIb .= 0 by A4;
        hence thesis by A2;
      end;
      suppose u = opBox;
        then (u.F).0 = 0 by DefBox;
        hence thesis by A2;
      end;
    end;
    let d be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A6: d in {opComp} & F in Y & G in Y;
    then d = opComp by TARSKI:def 1;
    then A7: d.(F,G) = F*G by DefComp;
    (F*G).0 = F.(G.0) by CompVal .= F.0 by A2, A6 .= 0 by A2, A6;
    hence thesis by A2, A7;
  end;
  then A8: ClosVb 0 c= Y by ClosLeast;
  (cst 1).0 = 1 by DefCst;
  then not cst 1 in Y by A2;
  hence thesis by A8, C6One;
end;

theorem ExtVbIff:
  ClosVb b = C6 iff 1 <= b
proof
  thus ClosVb b = C6 implies 1 <= b
  proof
    assume A1: ClosVb b = C6;
    b <> 0 by A1, ExtVb0;
    hence thesis by NAT_1:14;
  end;
  thus thesis by ExtVb;
end;

begin

:: Open problem 3.2 of the README: general recursive functions.
:: J. Robinson (Proc. AMS 1 (1950), Sec. 4, Thm. 3) proved that the unary
:: general recursive functions are the closure of <S, E, F + G, FG, F^-1>,
:: F^-1(x) = min y [F(y) = x] (for F onto).  Here F + G is replaced by F^+:
:: for X in {E, K, L}, <1, X, F^+, FG, F^-1> has the same closure.

reserve e,h,p,z for Nat;
reserve Y for Subset of Funcs(NAT,NAT);

definition
  let F be Element of Funcs(NAT,NAT);
  attr F is surj means :DefSurj:
  for x being Nat ex y being Nat st F.y = x;
end;

:: the least preimage of x (F.x when F is not onto)
definition
  let F be Element of Funcs(NAT,NAT), x be Nat;
  func linv(F,x) -> Nat means :DefLinv:
  F.it = x & for y being Nat st F.y = x holds it <= y if F is surj
  otherwise it = F.x;
  existence
  proof
    thus F is surj implies ex k being Nat st F.k = x &
      for y being Nat st F.y = x holds k <= y
    proof
      assume F is surj;
      then A1: ex y being Nat st F.y = x by DefSurj;
      defpred P[Nat] means F.$1 = x;
      A2: ex k being Nat st P[k] by A1;
      consider k being Nat such that
        A3: P[k] & for n being Nat st P[n] holds k <= n from NAT_1:sch 5(A2);
      take k;
      thus thesis by A3;
    end;
    thus not F is surj implies ex k being Nat st k = F.x;
  end;
  uniqueness
  proof
    let k1,k2 be Nat;
    thus F is surj &
      (F.k1 = x & for y being Nat st F.y = x holds k1 <= y) &
      (F.k2 = x & for y being Nat st F.y = x holds k2 <= y) implies k1 = k2
    proof
      assume that F is surj and
        A1: F.k1 = x & for y being Nat st F.y = x holds k1 <= y and
        A2: F.k2 = x & for y being Nat st F.y = x holds k2 <= y;
      k1 <= k2 & k2 <= k1 by A1, A2;
      hence thesis by XXREAL_0:1;
    end;
    thus thesis;
  end;
  consistency;
end;

:: inversion: F^-1(x) = min y [F(y) = x] if F is onto, F^-1 = F otherwise
:: (so a closure under opInv is a closure under Robinson's inversion)
definition
  func opInv -> UnOp of Funcs(NAT,NAT) means :DefInv:
  for F being Element of Funcs(NAT,NAT), x being Nat holds
    (it.F).x = linv(F,x);
  existence
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = linv($1,$2);
    thus ex u being UnOp of Funcs(NAT,NAT) st
      for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) from UOpEx;
  end;
  uniqueness
  proof
    deffunc T(Element of Funcs(NAT,NAT), Nat) = linv($1,$2);
    let u,v be UnOp of Funcs(NAT,NAT) such that
    A1: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (u.F).x = T(F,x) and
    A2: for F being Element of Funcs(NAT,NAT), x being Nat holds
      (v.F).x = T(F,x);
    thus u = v from UOpUq(A1,A2);
  end;
end;

theorem InvRight:
  F is surj implies F.((opInv.F).x) = x
proof
  assume A1: F is surj;
  (opInv.F).x = linv(F,x) by DefInv;
  hence thesis by A1, DefLinv;
end;

theorem InvLeast:
  F is surj & F.y = x implies (opInv.F).x <= y
proof
  assume A1: F is surj & F.y = x;
  (opInv.F).x = linv(F,x) by DefInv;
  hence thesis by A1, DefLinv;
end;

theorem InvNot:
  not F is surj implies opInv.F = F
proof
  assume A1: not F is surj;
  now
    let x;
    thus (opInv.F).x = linv(F,x) by DefInv .= F.x by A1, DefLinv;
  end;
  hence thesis by UFunExt;
end;

:: the bases <S, E, F + G, FG, F^-1> (Robinson) and <1, X, F^+, FG, F^-1>
definition
  func ClosJR -> Subset of Funcs(NAT,NAT) equals
  clos({funS, funE}, {opInv}, {opPlus, opComp});
  coherence;
end;

definition
  let X be Element of Funcs(NAT,NAT);
  func ClosGR X -> Subset of Funcs(NAT,NAT) equals
  clos({cst 1, X}, {opPlusI, opInv}, {opComp});
  coherence;
end;

theorem JRBasic:
  funS in ClosJR & funE in ClosJR
proof
  funS in {funS, funE} & funE in {funS, funE} by TARSKI:def 2;
  hence thesis by ClosInit;
end;

theorem JRInv:
  F in ClosJR implies opInv.F in ClosJR
proof
  assume A1: F in ClosJR;
  opInv in {opInv} by TARSKI:def 1;
  hence thesis by A1, ClosUnop;
end;

theorem JRComp:
  F in ClosJR & G in ClosJR implies F*G in ClosJR
proof
  assume A1: F in ClosJR & G in ClosJR;
  A2: opComp in {opPlus, opComp} by TARSKI:def 2;
  opComp.(F,G) = F*G by DefComp;
  hence thesis by A1, A2, ClosBinop;
end;

theorem JRPlus:
  F in ClosJR & G in ClosJR implies opPlus.(F,G) in ClosJR
proof
  assume A1: F in ClosJR & G in ClosJR;
  opPlus in {opPlus, opComp} by TARSKI:def 2;
  hence thesis by A1, ClosBinop;
end;

theorem CGOne:
  cst 1 in ClosGR X & X in ClosGR X
proof
  cst 1 in {cst 1, X} & X in {cst 1, X} by TARSKI:def 2;
  hence thesis by ClosInit;
end;

theorem CGPlusI:
  F in ClosGR X implies opPlusI.F in ClosGR X
proof
  assume A1: F in ClosGR X;
  opPlusI in {opPlusI, opInv} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CGInv:
  F in ClosGR X implies opInv.F in ClosGR X
proof
  assume A1: F in ClosGR X;
  opInv in {opPlusI, opInv} by TARSKI:def 2;
  hence thesis by A1, ClosUnop;
end;

theorem CGComp:
  F in ClosGR X & G in ClosGR X implies F*G in ClosGR X
  by CompIn;

theorem CGSub:
  X in ClosGR W implies ClosGR X c= ClosGR W
proof
  assume A1: X in ClosGR W;
  ClosGR W is_closed_under {cst 1, X}, {opPlusI, opInv}, {opComp}
  proof
    thus {cst 1, X} c= ClosGR W
    proof
      let z be object;
      assume z in {cst 1, X};
      then z = cst 1 or z = X by TARSKI:def 2;
      hence thesis by A1, CGOne;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opInv} & F in ClosGR W holds u.F in ClosGR W
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opPlusI, opInv} & F in ClosGR W;
      then u = opPlusI or u = opInv by TARSKI:def 2;
      hence thesis by A2, CGPlusI, CGInv;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: c in {opComp} & F in ClosGR W & G in ClosGR W;
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A3, CGComp;
  end;
  hence thesis by ClosLeast;
end;

:: Lemmas 6.2-6.6 only use I, E, S, D, M3, Sq, Hf, Rt, F^+ and FG
definition
  let Y be Subset of Funcs(NAT,NAT);
  attr Y is rich means :DefRich:
  funI in Y & funE in Y & funS in Y & funD in Y & funM3 in Y &
  funSq in Y & funHf in Y & funRt in Y &
  (for F being Element of Funcs(NAT,NAT) st F in Y holds opPlusI.F in Y) &
  (for F,G being Element of Funcs(NAT,NAT) st F in Y & G in Y
     holds F*G in Y);
end;

theorem RBasic:
  Y is rich implies funI in Y & funE in Y & funS in Y & funD in Y &
  funM3 in Y & funSq in Y & funHf in Y & funRt in Y
  by DefRich;

theorem RPlusI:
  Y is rich & F in Y implies opPlusI.F in Y
  by DefRich;

theorem RComp:
  Y is rich & F in Y & G in Y implies F*G in Y
  by DefRich;

theorem RMinusIIn:
  Y is rich & F in Y implies exprMinusI F in Y
proof
  assume that A0: Y is rich and A1: F in Y;
  A5: funE in Y & funS in Y & funM3 in Y & funSq in Y by A0, RBasic;
  then A2: funE*funS in Y by A0, RComp;
  funM3*F in Y by A0, A1, A5, RComp;
  then funM3*F*funE in Y by A0, A5, RComp;
  then opPlusI.(funM3*F*funE) in Y by A0, RPlusI;
  then A3: funE*funS*(opPlusI.(funM3*F*funE)) in Y by A0, A2, RComp;
  opPlusI.F in Y by A0, A1, RPlusI;
  then funSq*(opPlusI.F) in Y by A0, A5, RComp;
  then opPlusI.(funSq*(opPlusI.F)) in Y by A0, RPlusI;
  hence thesis by A0, A3, RComp;
end;

theorem ROplusIn:
  Y is rich & F in Y & G in Y implies exprOplus(F,G) in Y
proof
  assume that A0: Y is rich and A1: F in Y & G in Y;
  A5: funE in Y & funSq in Y by A0, RBasic;
  exprMinusI F in Y by A0, A1, RMinusIIn;
  then (exprMinusI F)*funE in Y by A0, A5, RComp;
  then A2: opPlusI.((exprMinusI F)*funE) in Y by A0, RPlusI;
  funSq*G in Y by A0, A1, A5, RComp;
  then opPlusI.(funSq*G) in Y by A0, RPlusI;
  hence thesis by A0, A2, RComp;
end;

theorem ROminusIn:
  Y is rich & F in Y & G in Y implies exprOminus(F,G) in Y
proof
  assume that A0: Y is rich and A1: F in Y & G in Y;
  A5: funE in Y & funSq in Y by A0, RBasic;
  opPlusI.F in Y by A0, A1, RPlusI;
  then (opPlusI.F)*funE in Y by A0, A5, RComp;
  then A2: exprMinusI((opPlusI.F)*funE) in Y by A0, RMinusIIn;
  funSq*G in Y by A0, A1, A5, RComp;
  then opPlusI.(funSq*G) in Y by A0, RPlusI;
  hence thesis by A0, A2, RComp;
end;

theorem RPhatIn:
  Y is rich implies exprPhat in Y
proof
  assume A0: Y is rich;
  then A5: funSq in Y & funS in Y by RBasic;
  then opPlusI.funSq in Y by A0, RPlusI;
  then opPlusI.(opPlusI.funSq) in Y by A0, RPlusI;
  then opPlusI.(opPlusI.(opPlusI.funSq)) in Y by A0, RPlusI;
  hence thesis by A0, A5, ROminusIn;
end;

theorem ROtimesIn:
  Y is rich & F in Y & G in Y implies exprOtimes(F,G) in Y
proof
  assume that A0: Y is rich and A1: F in Y & G in Y;
  A6: funSq in Y & funS in Y & funHf in Y & funRt in Y by A0, RBasic;
  A2: funSq*F in Y by A0, A1, A6, RComp;
  A3: funSq*G in Y by A0, A1, A6, RComp;
  funSq*funS in Y by A0, A6, RComp;
  then funSq*funS*funSq in Y by A0, A6, RComp;
  then funSq*funS*funSq*F in Y by A0, A1, RComp;
  then exprOplus(funSq*funS*funSq*F, G) in Y by A0, A1, ROplusIn;
  then A4: exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F) in Y
    by A0, A2, ROminusIn;
  exprPhat in Y by A0, RPhatIn;
  then funSq*exprPhat in Y by A0, A6, RComp;
  then funSq*exprPhat*exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F)
    in Y by A0, A4, RComp;
  then A5: exprOminus(funSq*exprPhat*
    exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F), funSq*G) in Y
    by A0, A3, ROminusIn;
  funHf*funHf in Y by A0, A6, RComp;
  then funHf*funHf*exprOminus(funSq*exprPhat*
    exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F), funSq*G) in Y
    by A0, A5, RComp;
  then exprOminus(funHf*funHf*exprOminus(funSq*exprPhat*
    exprOminus(exprOplus(funSq*funS*funSq*F, G), funSq*F), funSq*G),
    funSq*F) in Y by A0, A2, ROminusIn;
  hence thesis by A0, A6, RComp;
end;

theorem RPlusExprIn:
  Y is rich & F in Y & G in Y implies exprPlus(F,G) in Y
proof
  assume that A0: Y is rich and A1: F in Y & G in Y;
  A6: funD in Y & funRt in Y by A0, RBasic;
  A2: opPlusI.F in Y & opPlusI.G in Y by A0, A1, RPlusI;
  then exprOtimes(opPlusI.F, opPlusI.G) in Y by A0, ROtimesIn;
  then funD*exprOtimes(opPlusI.F, opPlusI.G) in Y by A0, A6, RComp;
  then exprOplus(funD*exprOtimes(opPlusI.F, opPlusI.G), opPlusI.F) in Y
    by A0, A2, ROplusIn;
  then exprOplus(exprOplus(funD*exprOtimes(opPlusI.F, opPlusI.G),
    opPlusI.F), opPlusI.G) in Y by A0, A2, ROplusIn;
  then funRt*exprOplus(exprOplus(funD*exprOtimes(opPlusI.F, opPlusI.G),
    opPlusI.F), opPlusI.G) in Y by A0, A6, RComp;
  then exprMinusI(funRt*exprOplus(exprOplus(funD*exprOtimes(
    opPlusI.F, opPlusI.G), opPlusI.F), opPlusI.G)) in Y by A0, RMinusIIn;
  hence thesis by A0, RMinusIIn;
end;

theorem RMinusExprIn:
  Y is rich & F in Y & G in Y implies exprMinus(F,G) in Y
proof
  assume that A0: Y is rich and A1: F in Y & G in Y;
  A6: funSq in Y & funM3 in Y & funE in Y & funS in Y by A0, RBasic;
  exprPlus(F,G) in Y by A0, A1, RPlusExprIn;
  then A2: funSq*exprPlus(F,G) in Y by A0, A6, RComp;
  funM3*F in Y by A0, A1, A6, RComp;
  then exprPlus(funSq*exprPlus(F,G), funM3*F) in Y by A0, A2, RPlusExprIn;
  then A3: exprPlus(exprPlus(funSq*exprPlus(F,G), funM3*F), G) in Y
    by A0, A1, RPlusExprIn;
  funE*funS in Y by A0, A6, RComp;
  hence thesis by A0, A3, RComp;
end;

:: Lemma 6.6 in a rich set
theorem RLemma66:
  Y is rich & F in Y & G in Y implies opPlus.(F,G) in Y &
  ((for x holds G.x <= F.x) implies opMinus.(F,G) in Y)
proof
  assume A1: Y is rich & F in Y & G in Y;
  then exprPlus(F,G) in Y by RPlusExprIn;
  hence opPlus.(F,G) in Y by PlusExprEq;
  exprMinus(F,G) in Y by A1, RMinusExprIn;
  then A2: opDiffE.(F,G) in Y by MinusExprEq;
  assume A3: for x holds G.x <= F.x;
  now
    let x;
    thus (opDiffE.(F,G)).x = F.x -' G.x by A3, DiffEIsDifference
      .= (opMinus.(F,G)).x by DefMinus;
  end;
  hence thesis by A2, UFunExt;
end;

:: The case X = E.  Arithmetic facts

theorem EBound:
  funE.y <= 2*funRt.y
proof
  set r = funRt.y;
  A1: funE.y + r*r = y by EVal;
  y < (r+1)*(r+1) by DefRt;
  then funE.y + r*r < r*r + (2*r + 1) by A1;
  then funE.y < 2*r + 1 by XREAL_1:6;
  hence thesis by NAT_1:13;
end;

theorem TwoELe:
  2*funE.y <= y + 1
proof
  set r = funRt.y, e = funE.y;
  A1: e + r*r = y by EVal;
  A2: e <= 2*r by EBound;
  per cases by NAT_1:14;
  suppose r = 0;
    then e <= 0 by A2;
    then e = 0;
    hence thesis;
  end;
  suppose 1 <= r;
    then consider r1 being Nat such that A3: r = 1 + r1 by NAT_1:10;
    A4: r*r + 1 = 2*r + r1*r1 by A3;
    2*r <= 2*r + r1*r1 by NAT_1:11;
    then e + 2*r <= e + (r*r + 1) by A4, XREAL_1:6;
    then A5: e + 2*r <= y + 1 by A1;
    e + e <= e + 2*r by A2, XREAL_1:6;
    hence thesis by A5, XXREAL_0:2;
  end;
end;

theorem Parity:
  ex q st y = 2*q or y = 2*q + 1
proof
  set q = y div 2;
  A1: y = 2*q + (y mod 2) by NAT_D:2;
  take q;
  y mod 2 = 0 or y mod 2 = 1 by NAT_D:12;
  hence thesis by A1;
end;

theorem DivTwo:
  (2*q) div 2 = q & (2*q + 1) div 2 = q
proof
  thus (2*q) div 2 = q by NAT_D:18;
  2*q + 1 = 2*q + 1 & 1 < 2;
  hence thesis by NAT_D:def 1;
end;

theorem ESurj:
  funE is surj
proof
  let x;
  take x*x + x;
  2*x = x + x;
  then x <= 2*x by NAT_1:11;
  hence thesis by ESqAdd;
end;

:: E^-1(x) = c^2 + x where c = ceil(x/2)
theorem EinvVal:
  x <= 2*c & 2*c <= x + 1 implies (opInv.funE).x = c*c + x
proof
  assume that A1: x <= 2*c and A2: 2*c <= x + 1;
  set y = (opInv.funE).x, r = funRt.y;
  funE.(c*c + x) = x by A1, ESqAdd;
  then A3: y <= c*c + x by ESurj, InvLeast;
  A4: funE.y = x by ESurj, InvRight;
  then x <= 2*r by EBound;
  then x + 1 <= 2*r + 1 by XREAL_1:6;
  then 2*c <= 2*r + 1 by A2, XXREAL_0:2;
  then 2*c < 2*r + 1 + 1 by NAT_1:13;
  then 2*c < 2*(r + 1);
  then c < r + 1 by XREAL_1:64;
  then c <= r by NAT_1:13;
  then A5: c*c <= r*r by XREAL_1:66;
  funE.y + r*r = y by EVal;
  then c*c + x <= y by A4, A5, XREAL_1:6;
  hence thesis by A3, XXREAL_0:1;
end;

theorem EinvD:
  (opInv.funE).(2*z) = z*z + 2*z
proof
  2*z <= 2*z & 2*z <= 2*z + 1 by NAT_1:11;
  hence thesis by EinvVal;
end;

:: The basis <1, E, F^+, FG, F^-1>: first functions

theorem IExpr0:
  opPlusI.(cst 0) = funI
proof
  opPlusI.(funM 0) = funM (0+1) by MVals;
  hence thesis by MVals;
end;

theorem GEFirst:
  funS in ClosGR funE & cst 0 in ClosGR funE & funI in ClosGR funE &
  funD in ClosGR funE & funM3 in ClosGR funE
proof
  A1: cst 1 in ClosGR funE & funE in ClosGR funE by CGOne;
  hence funS in ClosGR funE by CGPlusI, SExpr;
  thus A2: cst 0 in ClosGR funE by A1, CGComp, ZeroExpr;
  hence funI in ClosGR funE by CGPlusI, IExpr0;
  opPlusI.(cst 0) in ClosGR funE by A2, CGPlusI;
  hence A3: funD in ClosGR funE by CGPlusI, DExpr;
  thus thesis by A3, CGPlusI, M3Expr;
end;

:: F^- = E (S S S M3 F E)^+ S (E^-1 D F^+)^+ (without Sq)
definition
  let F be Element of Funcs(NAT,NAT);
  func exprMinusIE F -> Element of Funcs(NAT,NAT) equals
  funE*(opPlusI.(funS*funS*funS*funM3*F*funE))*funS*
    (opPlusI.((opInv.funE)*funD*(opPlusI.F)));
  coherence;
end;

theorem MinusIEIn:
  F in ClosGR funE implies exprMinusIE F in ClosGR funE
proof
  assume A1: F in ClosGR funE;
  A2: funS in ClosGR funE & funD in ClosGR funE & funM3 in ClosGR funE
    by GEFirst;
  A3: funE in ClosGR funE by CGOne;
  funS*funS in ClosGR funE by A2, CGComp;
  then funS*funS*funS in ClosGR funE by A2, CGComp;
  then funS*funS*funS*funM3 in ClosGR funE by A2, CGComp;
  then funS*funS*funS*funM3*F in ClosGR funE by A1, CGComp;
  then funS*funS*funS*funM3*F*funE in ClosGR funE by A3, CGComp;
  then opPlusI.(funS*funS*funS*funM3*F*funE) in ClosGR funE by CGPlusI;
  then funE*(opPlusI.(funS*funS*funS*funM3*F*funE)) in ClosGR funE
    by A3, CGComp;
  then A4: funE*(opPlusI.(funS*funS*funS*funM3*F*funE))*funS in ClosGR funE
    by A2, CGComp;
  opInv.funE in ClosGR funE by A3, CGInv;
  then A5: (opInv.funE)*funD in ClosGR funE by A2, CGComp;
  opPlusI.F in ClosGR funE by A1, CGPlusI;
  then (opInv.funE)*funD*(opPlusI.F) in ClosGR funE by A5, CGComp;
  then opPlusI.((opInv.funE)*funD*(opPlusI.F)) in ClosGR funE by CGPlusI;
  hence thesis by A4, CGComp;
end;

theorem MinusIEVal:
  x <= F.x implies (exprMinusIE F).x = F.x -' x
proof
  assume A1: x <= F.x;
  set d = F.x -' x;
  A2: F.x = d + x by A1, XREAL_1:235;
  set s = F.x + x;
  set G1 = (opInv.funE)*funD*(opPlusI.F);
  set G2 = funS*funS*funS*funM3*F*funE;
  set v = (s+1)*(s+1) + x;
  A3: G1.x = ((opInv.funE)*funD).((opPlusI.F).x) by CompVal
    .= ((opInv.funE)*funD).s by DefPlusI
    .= (opInv.funE).(funD.s) by CompVal
    .= (opInv.funE).(2*s) by DefD
    .= s*s + 2*s by EinvD;
  A4: funS.((opPlusI.G1).x) = (opPlusI.G1).x + 1 by DefS
    .= G1.x + x + 1 by DefPlusI
    .= v by A3;
  2*(s+1) = x + (2*F.x + x + 2);
  then x <= 2*(s+1) by NAT_1:11;
  then A5: funE.v = x by ESqAdd;
  A6: G2.v = (funS*funS*funS*funM3*F).(funE.v) by CompVal
    .= (funS*funS*funS*funM3).(F.x) by A5, CompVal
    .= (funS*funS*funS).(funM3.(F.x)) by CompVal
    .= (funS*funS*funS).(3*F.x) by DefM3
    .= (funS*funS).(funS.(3*F.x)) by CompVal
    .= (funS*funS).(3*F.x + 1) by DefS
    .= funS.(funS.(3*F.x + 1)) by CompVal
    .= funS.(3*F.x + 1 + 1) by DefS
    .= 3*F.x + 1 + 1 + 1 by DefS;
  A7: (opPlusI.G2).v = G2.v + v by DefPlusI
    .= (s+2)*(s+2) + d by A2, A6;
  2*(s+2) = d + (d + 4*x + 4) by A2;
  then d <= 2*(s+2) by NAT_1:11;
  then A8: funE.((s+2)*(s+2) + d) = d by ESqAdd;
  thus (exprMinusIE F).x
      = (funE*(opPlusI.G2)*funS).((opPlusI.G1).x) by CompVal
     .= (funE*(opPlusI.G2)).(funS.((opPlusI.G1).x)) by CompVal
     .= funE.((opPlusI.G2).v) by A4, CompVal
     .= d by A7, A8;
end;

theorem SqExprGE:
  exprMinusIE (exprMinusIE ((opInv.funE)*funD)) = funSq
proof
  set G = (opInv.funE)*funD;
  now
    let x;
    A1: G.x = (opInv.funE).(funD.x) by CompVal
      .= (opInv.funE).(2*x) by DefD
      .= x*x + 2*x by EinvD;
    then G.x = x + (x*x + x);
    then x <= G.x by NAT_1:11;
    then A2: (exprMinusIE G).x = x*x + x + x -' x by A1, MinusIEVal
      .= x*x + x by NAT_D:34;
    then x <= (exprMinusIE G).x by NAT_1:11;
    hence (exprMinusIE (exprMinusIE G)).x = x*x + x -' x by A2, MinusIEVal
      .= x*x by NAT_D:34
      .= funSq.x by DefSq;
  end;
  hence thesis by UFunExt;
end;

theorem GESq:
  funSq in ClosGR funE
proof
  funE in ClosGR funE by CGOne;
  then A1: opInv.funE in ClosGR funE by CGInv;
  funD in ClosGR funE by GEFirst;
  then (opInv.funE)*funD in ClosGR funE by A1, CGComp;
  then exprMinusIE ((opInv.funE)*funD) in ClosGR funE by MinusIEIn;
  then exprMinusIE (exprMinusIE ((opInv.funE)*funD)) in ClosGR funE
    by MinusIEIn;
  hence thesis by SqExprGE;
end;

:: I - F = E (S (F^+)^+ E)^+ (Sq F^+)^+ (if F(x) <= x)
definition
  let F be Element of Funcs(NAT,NAT);
  func exprIminusE F -> Element of Funcs(NAT,NAT) equals
  funE*(opPlusI.(funS*(opPlusI.(opPlusI.F))*funE))*
    (opPlusI.(funSq*(opPlusI.F)));
  coherence;
end;

theorem IminusEIn:
  F in ClosGR funE implies exprIminusE F in ClosGR funE
proof
  assume A1: F in ClosGR funE;
  A2: funS in ClosGR funE by GEFirst;
  A3: funE in ClosGR funE by CGOne;
  A4: funSq in ClosGR funE by GESq;
  A5: opPlusI.F in ClosGR funE by A1, CGPlusI;
  then opPlusI.(opPlusI.F) in ClosGR funE by CGPlusI;
  then funS*(opPlusI.(opPlusI.F)) in ClosGR funE by A2, CGComp;
  then funS*(opPlusI.(opPlusI.F))*funE in ClosGR funE by A3, CGComp;
  then opPlusI.(funS*(opPlusI.(opPlusI.F))*funE) in ClosGR funE by CGPlusI;
  then A6: funE*(opPlusI.(funS*(opPlusI.(opPlusI.F))*funE)) in ClosGR funE
    by A3, CGComp;
  funSq*(opPlusI.F) in ClosGR funE by A4, A5, CGComp;
  then opPlusI.(funSq*(opPlusI.F)) in ClosGR funE by CGPlusI;
  hence thesis by A6, CGComp;
end;

theorem IminusEVal:
  F.x <= x implies (exprIminusE F).x = x -' F.x
proof
  assume A1: F.x <= x;
  set a = F.x;
  set y = (a + x)*(a + x) + x;
  set G = funS*(opPlusI.(opPlusI.F))*funE;
  A2: (opPlusI.(funSq*(opPlusI.F))).x = (funSq*(opPlusI.F)).x + x
      by DefPlusI
    .= funSq.((opPlusI.F).x) + x by CompVal
    .= funSq.(a + x) + x by DefPlusI
    .= y by DefSq;
  2*(a + x) = x + (2*a + x);
  then x <= 2*(a + x) by NAT_1:11;
  then A3: funE.y = x by ESqAdd;
  A4: G.y = (funS*(opPlusI.(opPlusI.F))).(funE.y) by CompVal
    .= funS.((opPlusI.(opPlusI.F)).x) by A3, CompVal
    .= (opPlusI.(opPlusI.F)).x + 1 by DefS
    .= (opPlusI.F).x + x + 1 by DefPlusI
    .= a + x + x + 1 by DefPlusI;
  A5: (opPlusI.G).y = G.y + y by DefPlusI
    .= (x + a)*(x + a) + 3*x + a + 1 by A4;
  thus (exprIminusE F).x = (funE*(opPlusI.G)).y by A2, CompVal
    .= funE.((opPlusI.G).y) by CompVal
    .= x -' a by A1, A5, RobDiffE;
end;

:: W = E (S S D E E)^+ E^-1, W(2q) = 2E(2q) + 1 and W(2q+1) = 2E(2q+1)
definition
  func exprW -> Element of Funcs(NAT,NAT) equals
  funE*(opPlusI.(funS*funS*funD*funE*funE))*(opInv.funE);
  coherence;
end;

theorem WIn:
  exprW in ClosGR funE
proof
  A1: funS in ClosGR funE & funD in ClosGR funE by GEFirst;
  A2: funE in ClosGR funE by CGOne;
  funS*funS in ClosGR funE by A1, CGComp;
  then funS*funS*funD in ClosGR funE by A1, CGComp;
  then funS*funS*funD*funE in ClosGR funE by A2, CGComp;
  then funS*funS*funD*funE*funE in ClosGR funE by A2, CGComp;
  then opPlusI.(funS*funS*funD*funE*funE) in ClosGR funE by CGPlusI;
  then A3: funE*(opPlusI.(funS*funS*funD*funE*funE)) in ClosGR funE
    by A2, CGComp;
  opInv.funE in ClosGR funE by A2, CGInv;
  hence thesis by A3, CGComp;
end;

:: if E(y) = e and E(c^2 + y) = y then W-like step value
theorem WStep:
  funE.(c*c + y) = y implies
  (opPlusI.(funS*funS*funD*funE*funE)).(c*c + y) = 2*funE.y + 2 + (c*c + y)
proof
  assume A1: funE.(c*c + y) = y;
  set w = c*c + y;
  (funS*funS*funD*funE*funE).w = (funS*funS*funD*funE).(funE.w) by CompVal
    .= (funS*funS*funD).(funE.y) by A1, CompVal
    .= (funS*funS).(funD.(funE.y)) by CompVal
    .= (funS*funS).(2*funE.y) by DefD
    .= funS.(funS.(2*funE.y)) by CompVal
    .= funS.(2*funE.y + 1) by DefS
    .= 2*funE.y + 1 + 1 by DefS;
  hence thesis by DefPlusI;
end;

theorem WVal:
  exprW.(2*q) = 2*funE.(2*q) + 1 & exprW.(2*q + 1) = 2*funE.(2*q + 1)
proof
  set G = opPlusI.(funS*funS*funD*funE*funE);
  thus exprW.(2*q) = 2*funE.(2*q) + 1
  proof
    set y = 2*q, e = funE.y;
    A1: (opInv.funE).y = q*q + y by EinvD;
    A2: funE.(q*q + y) = y by ESqAdd;
    then A3: G.(q*q + y) = 2*e + 2 + (q*q + y) by WStep
      .= (q+1)*(q+1) + (2*e + 1);
    2*e <= y + 1 by TwoELe;
    then 2*e + 1 <= 2*q + 1 + 1 by XREAL_1:6;
    then 2*e + 1 <= 2*(q+1);
    then A4: funE.((q+1)*(q+1) + (2*e + 1)) = 2*e + 1 by ESqAdd;
    thus exprW.y = (funE*G).((opInv.funE).y) by CompVal
      .= funE.(G.(q*q + y)) by A1, CompVal
      .= 2*e + 1 by A3, A4;
  end;
  set y = 2*q + 1, e = funE.y;
  set c = q + 1;
  A0: 2*c = y + 1;
  then A01: y <= 2*c by NAT_1:11;
  then A1: (opInv.funE).y = c*c + y by A0, EinvVal;
  funE.(c*c + y) = y by A01, ESqAdd;
  then A3: G.(c*c + y) = 2*e + 2 + (c*c + y) by WStep
    .= (c+1)*(c+1) + 2*e;
  2*e <= y + 1 by TwoELe;
  then A02: 2*e <= 2*c by A0;
  2*(c+1) = 2*c + 2;
  then 2*c <= 2*(c+1) by NAT_1:11;
  then 2*e <= 2*(c+1) by A02, XXREAL_0:2;
  then A4: funE.((c+1)*(c+1) + 2*e) = 2*e by ESqAdd;
  thus exprW.y = (funE*G).((opInv.funE).y) by CompVal
    .= funE.(G.(c*c + y)) by A1, CompVal
    .= 2*e by A3, A4;
end;

theorem WSurj:
  exprW is surj
proof
  let x;
  consider k such that A1: x = 2*k or x = 2*k + 1 by Parity;
  per cases by A1;
  suppose A2: x = 2*k;
    take y = 2*(funZ.k) + 1;
    A3: y = k*(k+3) + 1 by TwoZ
      .= (k+1)*(k+1) + k;
    2*(k+1) = k + (k+2);
    then k <= 2*(k+1) by NAT_1:11;
    then funE.y = k by A3, ESqAdd;
    hence exprW.y = x by A2, WVal;
  end;
  suppose A2: x = 2*k + 1;
    take y = 2*(funH.k);
    A3: y = (k+1)*(k+4) by TwoH
      .= (k+2)*(k+2) + k;
    2*(k+2) = k + (k+4);
    then k <= 2*(k+2) by NAT_1:11;
    then funE.y = k by A3, ESqAdd;
    hence exprW.y = x by A2, WVal;
  end;
end;

theorem HfExprGE:
  funE*(opInv.exprW) = funHf
proof
  now
    let x;
    set y = (opInv.exprW).x;
    A1: exprW.y = x by WSurj, InvRight;
    consider q such that A2: y = 2*q or y = 2*q + 1 by Parity;
    A3: (funE*(opInv.exprW)).x = funE.y by CompVal;
    per cases by A2;
    suppose y = 2*q;
      then x = 2*funE.y + 1 by A1, WVal;
      then x div 2 = funE.y by DivTwo;
      hence (funE*(opInv.exprW)).x = funHf.x by A3, DefHf;
    end;
    suppose y = 2*q + 1;
      then x = 2*funE.y by A1, WVal;
      then x div 2 = funE.y by DivTwo;
      hence (funE*(opInv.exprW)).x = funHf.x by A3, DefHf;
    end;
  end;
  hence thesis by UFunExt;
end;

theorem GEHf:
  funHf in ClosGR funE
proof
  funE in ClosGR funE by CGOne;
  then A1: funE in ClosGR funE & opInv.exprW in ClosGR funE by WIn, CGInv;
  then funE*(opInv.exprW) in ClosGR funE by CGComp;
  hence thesis by HfExprGE;
end;

:: Rt(4x+1) is 2 Rt(x) or 2 Rt(x) + 1
theorem Rt4:
  funRt.(4*x + 1) = 2*funRt.x or funRt.(4*x + 1) = 2*funRt.x + 1
proof
  set m = funRt.x, z = 4*x + 1;
  A1: m*m <= x & x < (m+1)*(m+1) by DefRt;
  then 4*(m*m) <= 4*x by XREAL_1:64;
  then A2: (2*m)*(2*m) <= z by NAT_1:13;
  x + 1 <= (m+1)*(m+1) by A1, NAT_1:13;
  then 4*(x + 1) <= 4*((m+1)*(m+1)) by XREAL_1:64;
  then A3: z + 3 <= (2*m+1+1)*(2*m+1+1);
  z < z + 3 by XREAL_1:29;
  then A4: z < (2*m+1+1)*(2*m+1+1) by A3, XXREAL_0:2;
  per cases;
  suppose z < (2*m+1)*(2*m+1);
    hence thesis by A2, RtI;
  end;
  suppose (2*m+1)*(2*m+1) <= z;
    hence thesis by A4, RtI;
  end;
end;

:: Rt = Hf Hf S S E (I - 1) (I - E) S M4, with M4 = M3^+
definition
  func exprRtGE -> Element of Funcs(NAT,NAT) equals
  funHf*funHf*funS*funS*funE*(exprIminusE (cst 1))*(exprIminusE funE)*
    funS*(opPlusI.funM3);
  coherence;
end;

theorem RtExprGE:
  exprRtGE = funRt
proof
  now
    let x;
    set z = 4*x + 1, n = funRt.z, m = funRt.x;
    set H4 = funHf*funHf*funS*funS*funE;
    A1: funS.((opPlusI.funM3).x) = (opPlusI.funM3).x + 1 by DefS
      .= funM3.x + x + 1 by DefPlusI
      .= 3*x + x + 1 by DefM3
      .= z;
    n <> 0
    proof
      assume n = 0;
      then z < (0+1)*(0+1) by DefRt;
      hence contradiction by NAT_1:11;
    end;
    then 1 <= n by NAT_1:14;
    then consider n1 being Nat such that A2: n = 1 + n1 by NAT_1:10;
    A3: funE.z + n*n = z by EVal;
    then funE.z <= z by NAT_1:11;
    then A4: (exprIminusE funE).z = z -' funE.z by IminusEVal
      .= n*n by A3, NAT_D:34;
    A5: (cst 1).(n*n) = 1 by DefCst;
    n*n = 1 + (n1*n1 + 2*n1) by A2;
    then 1 <= n*n by NAT_1:11;
    then (cst 1).(n*n) <= n*n by A5;
    then A6: (exprIminusE (cst 1)).(n*n) = n*n -' 1 by A5, IminusEVal
      .= n1*n1 + 2*n1 + 1 -' 1 by A2
      .= n1*n1 + 2*n1 by NAT_D:34;
    2*n1 <= 2*n1;
    then A7: funE.(n1*n1 + 2*n1) = 2*n1 by ESqAdd;
    A8: H4.(n1*n1 + 2*n1) = (funHf*funHf*funS*funS).(funE.(n1*n1 + 2*n1))
        by CompVal
      .= (funHf*funHf*funS).(funS.(2*n1)) by A7, CompVal
      .= (funHf*funHf*funS).(2*n1 + 1) by DefS
      .= (funHf*funHf).(funS.(2*n1 + 1)) by CompVal
      .= (funHf*funHf).(2*n1 + 1 + 1) by DefS
      .= funHf.(funHf.(2*n)) by A2, CompVal
      .= funHf.((2*n) div 2) by DefHf
      .= funHf.n by DivTwo
      .= n div 2 by DefHf;
    A9: n div 2 = m
    proof
      per cases by Rt4;
      suppose n = 2*m;
        hence thesis by DivTwo;
      end;
      suppose n = 2*m + 1;
        hence thesis by DivTwo;
      end;
    end;
    thus exprRtGE.x
        = (H4*(exprIminusE (cst 1))*(exprIminusE funE)*funS).
          ((opPlusI.funM3).x) by CompVal
      .= (H4*(exprIminusE (cst 1))*(exprIminusE funE)).
          (funS.((opPlusI.funM3).x)) by CompVal
      .= (H4*(exprIminusE (cst 1))).((exprIminusE funE).z) by A1, CompVal
      .= H4.((exprIminusE (cst 1)).(n*n)) by A4, CompVal
      .= funRt.x by A6, A8, A9;
  end;
  hence thesis by UFunExt;
end;

theorem GERt:
  funRt in ClosGR funE
proof
  A1: funHf in ClosGR funE by GEHf;
  A2: funS in ClosGR funE & cst 1 in ClosGR funE & funE in ClosGR funE &
    funM3 in ClosGR funE by GEFirst, CGOne;
  funHf*funHf in ClosGR funE by A1, CGComp;
  then funHf*funHf*funS in ClosGR funE by A2, CGComp;
  then funHf*funHf*funS*funS in ClosGR funE by A2, CGComp;
  then A3: funHf*funHf*funS*funS*funE in ClosGR funE by A2, CGComp;
  exprIminusE (cst 1) in ClosGR funE by A2, IminusEIn;
  then A4: funHf*funHf*funS*funS*funE*(exprIminusE (cst 1)) in ClosGR funE
    by A3, CGComp;
  exprIminusE funE in ClosGR funE by A2, IminusEIn;
  then funHf*funHf*funS*funS*funE*(exprIminusE (cst 1))*(exprIminusE funE)
    in ClosGR funE by A4, CGComp;
  then A5: funHf*funHf*funS*funS*funE*(exprIminusE (cst 1))*
    (exprIminusE funE)*funS in ClosGR funE by A2, CGComp;
  opPlusI.funM3 in ClosGR funE by A2, CGPlusI;
  then exprRtGE in ClosGR funE by A5, CGComp;
  hence thesis by RtExprGE;
end;

theorem GERich:
  ClosGR funE is rich
proof
  thus funI in ClosGR funE & funE in ClosGR funE & funS in ClosGR funE &
    funD in ClosGR funE & funM3 in ClosGR funE & funSq in ClosGR funE &
    funHf in ClosGR funE & funRt in ClosGR funE
    by GEFirst, CGOne, GESq, GEHf, GERt;
  thus thesis by CGPlusI, CGComp;
end;

:: A, V, K and L are in every rich set (as in AIn ... LIn)
theorem RichAVKL:
  Y is rich implies funA in Y & funV in Y & funK in Y & funL in Y
proof
  assume A0: Y is rich;
  then A10: funI in Y & funS in Y & funD in Y & funSq in Y & funHf in Y &
    funRt in Y by RBasic;
  now
    let x;
    thus (funHf*(opPlusI.funSq)).x = funHf.((opPlusI.funSq).x) by CompVal
      .= funHf.(funSq.x + x) by DefPlusI
      .= funHf.(x*x + x) by DefSq
      .= (x*x + x) div 2 by DefHf
      .= funA.x by DefA;
  end;
  then A1: funHf*(opPlusI.funSq) = funA by UFunExt;
  opPlusI.funSq in Y by A0, A10, RPlusI;
  hence A11: funA in Y by A0, A1, A10, RComp;
  set G = funHf*exprPhat*funRt*funS*funD*funD*funD;
  now
    let x;
    set s = funRt.(8*x + 1);
    A2: (funD*funD*funD).x = (funD*funD).(funD.x) by CompVal
      .= funD.(funD.(funD.x)) by CompVal
      .= funD.(funD.(2*x)) by DefD
      .= funD.(2*(2*x)) by DefD
      .= 2*(2*(2*x)) by DefD
      .= 8*x;
    A3: G.x = (funHf*exprPhat*funRt*funS*funD*funD).(funD.x) by CompVal
      .= (funHf*exprPhat*funRt*funS*funD).(funD.(funD.x)) by CompVal
      .= (funHf*exprPhat*funRt*funS).(funD.(funD.(funD.x))) by CompVal
      .= (funHf*exprPhat*funRt*funS).((funD*funD).(funD.x)) by CompVal
      .= (funHf*exprPhat*funRt*funS).(8*x) by A2, CompVal
      .= (funHf*exprPhat*funRt).(funS.(8*x)) by CompVal
      .= (funHf*exprPhat*funRt).(8*x + 1) by DefS
      .= (funHf*exprPhat).s by CompVal
      .= funHf.(exprPhat.s) by CompVal;
    s <> 0
    proof
      assume s = 0;
      then 8*x + 1 < (0+1)*(0+1) by DefRt;
      hence contradiction by NAT_1:11;
    end;
    then 1 <= s by NAT_1:14;
    then A4: (s -' 1) + 1 = s by XREAL_1:235;
    thus G.x = funHf.(exprPhat.((s -' 1) + 1)) by A3, A4
      .= funHf.(s -' 1) by PhatVal
      .= (s -' 1) div 2 by DefHf
      .= funV.x by DefV;
  end;
  then A5: G = funV by UFunExt;
  exprPhat in Y by A0, RPhatIn;
  then funHf*exprPhat in Y by A0, A10, RComp;
  then funHf*exprPhat*funRt in Y by A0, A10, RComp;
  then funHf*exprPhat*funRt*funS in Y by A0, A10, RComp;
  then funHf*exprPhat*funRt*funS*funD in Y by A0, A10, RComp;
  then funHf*exprPhat*funRt*funS*funD*funD in Y by A0, A10, RComp;
  hence A12: funV in Y by A0, A5, A10, RComp;
  A6: funA*funV in Y by A0, A11, A12, RComp;
  A7: for x holds (funA*funV).x <= funI.x
  proof
    let x;
    A8: (funA*funV).x = funA.(funV.x) by CompVal;
    funI.x = x by DefI .= funA.(funV.x) + funK.x by Decomp;
    hence thesis by A8, NAT_1:11;
  end;
  now
    let x;
    thus (opMinus.(funI, funA*funV)).x = funI.x -' (funA*funV).x by DefMinus
      .= x -' (funA*funV).x by DefI
      .= x -' funA.(funV.x) by CompVal
      .= funK.x by DefK;
  end;
  then opMinus.(funI, funA*funV) = funK by UFunExt;
  hence A13: funK in Y by A0, A6, A7, A10, RLemma66;
  A9: for x holds funK.x <= funV.x by Decomp;
  now
    let x;
    thus (opMinus.(funV, funK)).x = funV.x -' funK.x by DefMinus
      .= funL.x by LEq;
  end;
  then opMinus.(funV, funK) = funL by UFunExt;
  hence thesis by A0, A9, A12, A13, RLemma66;
end;

:: Inclusions between <1, E, F^+, FG, F^-1> and Robinson's basis

theorem JRFirst:
  funI in ClosJR & cst 0 in ClosJR & cst 1 in ClosJR
proof
  A1: funS in ClosJR & funE in ClosJR by JRBasic;
  then A2: opInv.funE in ClosJR by JRInv;
  now
    let x;
    thus (funE*(opInv.funE)).x = funE.((opInv.funE).x) by CompVal
      .= x by ESurj, InvRight
      .= funI.x by DefI;
  end;
  then A3: funE*(opInv.funE) = funI by UFunExt;
  hence A4: funI in ClosJR by A1, A2, JRComp;
  set G = funE*funS*(opInv.funE);
  now
    let x;
    A5: (opPlus.(funI,funI)).x = funI.x + funI.x by DefPlus
      .= x + funI.x by DefI
      .= x + x by DefI
      .= 2*x;
    0 <= 2*(x+1);
    then A6: funE.((x+1)*(x+1) + 0) = 0 by ESqAdd;
    thus (G*(opPlus.(funI,funI))).x = G.(2*x) by A5, CompVal
      .= (funE*funS).((opInv.funE).(2*x)) by CompVal
      .= (funE*funS).(x*x + 2*x) by EinvD
      .= funE.(funS.(x*x + 2*x)) by CompVal
      .= funE.(x*x + 2*x + 1) by DefS
      .= 0 by A6
      .= (cst 0).x by DefCst;
  end;
  then A7: G*(opPlus.(funI,funI)) = cst 0 by UFunExt;
  funE*funS in ClosJR by A1, JRComp;
  then A8: G in ClosJR by A2, JRComp;
  opPlus.(funI,funI) in ClosJR by A4, JRPlus;
  hence A9: cst 0 in ClosJR by A7, A8, JRComp;
  thus thesis by A1, A9, JRComp, OneExpr;
end;

theorem GESubJR:
  ClosGR funE c= ClosJR
proof
  ClosJR is_closed_under {cst 1, funE}, {opPlusI, opInv}, {opComp}
  proof
    thus {cst 1, funE} c= ClosJR
    proof
      let z be object;
      assume z in {cst 1, funE};
      then z = cst 1 or z = funE by TARSKI:def 2;
      hence thesis by JRBasic, JRFirst;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opInv} & F in ClosJR holds u.F in ClosJR
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A1: u in {opPlusI, opInv} & F in ClosJR;
      then A2: u = opPlusI or u = opInv by TARSKI:def 2;
      opPlus.(F, funI) in ClosJR by A1, JRFirst, JRPlus;
      then opPlusI.F in ClosJR by PlusIEq;
      hence thesis by A1, A2, JRInv;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: c in {opComp} & F in ClosJR & G in ClosJR;
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A3, JRComp;
  end;
  hence thesis by ClosLeast;
end;

:: a rich closure under inversion containing S and E contains ClosJR
theorem JRSubRich:
  Y is rich & (for F st F in Y holds opInv.F in Y) implies ClosJR c= Y
proof
  assume that A0: Y is rich and A1: for F st F in Y holds opInv.F in Y;
  Y is_closed_under {funS, funE}, {opInv}, {opPlus, opComp}
  proof
    thus {funS, funE} c= Y
    proof
      let z be object;
      assume z in {funS, funE};
      then z = funS or z = funE by TARSKI:def 2;
      hence thesis by A0, RBasic;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opInv} & F in Y holds u.F in Y
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opInv} & F in Y;
      then u = opInv by TARSKI:def 1;
      hence thesis by A1, A2;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: c in {opPlus, opComp} & F in Y & G in Y;
    then A4: c = opPlus or c = opComp by TARSKI:def 2;
    A5: opComp.(F,G) = F*G by DefComp;
    F*G in Y by A0, A3, RComp;
    hence thesis by A0, A3, A4, A5, RLemma66;
  end;
  hence thesis by ClosLeast;
end;

theorem GREqJRE:
  ClosGR funE = ClosJR
proof
  for F st F in ClosGR funE holds opInv.F in ClosGR funE by CGInv;
  then ClosJR c= ClosGR funE by GERich, JRSubRich;
  hence thesis by GESubJR, XBOOLE_0:def 10;
end;

:: The case X = K: Z = K^-1, A = K S S S ((Z Z^+ K)^+ Z K)^+ Z,
:: F^- = K (S S S M3 F K)^+ (A F^+)^+, Sq = (((D Z)^-)^-)^-, P = K (K S)^-1,
:: U = I - A K P (I - K) (U = V + K), Hf = K U^-1,
:: B = I - (I - Sq (I - Hf) U) (I - K) (B = K + ceil(V/2)^2), E = K B^-1

theorem GKFirst:
  funS in ClosGR funK & cst 0 in ClosGR funK & funI in ClosGR funK &
  funD in ClosGR funK & funM3 in ClosGR funK
proof
  A1: cst 1 in ClosGR funK & funK in ClosGR funK by CGOne;
  hence funS in ClosGR funK by CGPlusI, SExpr;
  thus A2: cst 0 in ClosGR funK by A1, CGComp, ZeroExprK;
  hence funI in ClosGR funK by CGPlusI, IExpr0;
  opPlusI.(cst 0) in ClosGR funK by A2, CGPlusI;
  hence A3: funD in ClosGR funK by CGPlusI, DExpr;
  thus thesis by A3, CGPlusI, M3Expr;
end;

theorem KSurj:
  funK is surj
proof
  let x;
  take funA.x + x;
  thus thesis by Diag;
end;

theorem KZ:
  funK.(funZ.x) = x
proof
  funZ.x = funA.x + x by DefZ;
  hence thesis by Diag;
end;

theorem KinvZ:
  opInv.funK = funZ
proof
  now
    let x;
    set y = (opInv.funK).x;
    funK.(funA.x + x) = x by Diag;
    then A1: y <= funA.x + x by KSurj, InvLeast;
    A2: funK.y = x by KSurj, InvRight;
    A3: y = funA.(funV.y) + funK.y & funK.y <= funV.y by Decomp;
    then funA.x <= funA.(funV.y) by A2, AMono;
    then funA.x + x <= y by A2, A3, XREAL_1:6;
    hence y = funA.x + x by A1, XXREAL_0:1
      .= funZ.x by DefZ;
  end;
  hence thesis by UFunExt;
end;

theorem GKZ:
  funZ in ClosGR funK
proof
  funK in ClosGR funK by CGOne;
  then opInv.funK in ClosGR funK by CGInv;
  hence thesis by KinvZ;
end;

definition
  func exprAK -> Element of Funcs(NAT,NAT) equals
  funK*funS*funS*funS*
    (opPlusI.((opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ*funK))*funZ;
  coherence;
end;

theorem AExprK:
  exprAK = funA
proof
  now
    let x;
    set z = funZ.x;
    set G0 = funZ*(opPlusI.funZ)*funK;
    set G1 = (opPlusI.G0)*funZ*funK;
    A1: z = funA.x + x by DefZ;
    A2: G0.z = (funZ*(opPlusI.funZ)).(funK.z) by CompVal
      .= (funZ*(opPlusI.funZ)).x by KZ
      .= funZ.((opPlusI.funZ).x) by CompVal
      .= funZ.(z + x) by DefPlusI;
    A3: G1.z = ((opPlusI.G0)*funZ).(funK.z) by CompVal
      .= ((opPlusI.G0)*funZ).x by KZ
      .= (opPlusI.G0).z by CompVal
      .= funZ.(z + x) + z by A2, DefPlusI;
    A4: (opPlusI.G1).z = G1.z + z by DefPlusI
      .= funZ.(z + x) + 2*z by A3;
    x <= z by A1, NAT_1:11;
    then A5: funK.(funZ.(z + x) + 2*z + 3) = z -' x by RobDiffK;
    thus exprAK.x = (funK*funS*funS*funS*(opPlusI.G1)).z by CompVal
      .= (funK*funS*funS*funS).((opPlusI.G1).z) by CompVal
      .= funK.(funZ.(z + x) + 2*z + 3) by A4, KSSSVal
      .= funA.x by A1, A5, NAT_D:34;
  end;
  hence thesis by UFunExt;
end;

theorem GKA:
  funA in ClosGR funK
proof
  A1: funZ in ClosGR funK by GKZ;
  A2: funK in ClosGR funK & funS in ClosGR funK by CGOne, GKFirst;
  opPlusI.funZ in ClosGR funK by A1, CGPlusI;
  then funZ*(opPlusI.funZ) in ClosGR funK by A1, CGComp;
  then funZ*(opPlusI.funZ)*funK in ClosGR funK by A2, CGComp;
  then opPlusI.(funZ*(opPlusI.funZ)*funK) in ClosGR funK by CGPlusI;
  then (opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ in ClosGR funK
    by A1, CGComp;
  then (opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ*funK in ClosGR funK
    by A2, CGComp;
  then A3: opPlusI.((opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ*funK)
    in ClosGR funK by CGPlusI;
  funK*funS in ClosGR funK by A2, CGComp;
  then funK*funS*funS in ClosGR funK by A2, CGComp;
  then funK*funS*funS*funS in ClosGR funK by A2, CGComp;
  then funK*funS*funS*funS*
    (opPlusI.((opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ*funK))
    in ClosGR funK by A3, CGComp;
  then exprAK in ClosGR funK by A1, CGComp;
  hence thesis by AExprK;
end;

definition
  let F be Element of Funcs(NAT,NAT);
  func exprMinusIK F -> Element of Funcs(NAT,NAT) equals
  funK*(opPlusI.(funS*funS*funS*funM3*F*funK))*
    (opPlusI.(funA*(opPlusI.F)));
  coherence;
end;

theorem MinusIKIn:
  F in ClosGR funK implies exprMinusIK F in ClosGR funK
proof
  assume A1: F in ClosGR funK;
  A2: funS in ClosGR funK & funM3 in ClosGR funK by GKFirst;
  A3: funK in ClosGR funK & funA in ClosGR funK by CGOne, GKA;
  funS*funS in ClosGR funK by A2, CGComp;
  then funS*funS*funS in ClosGR funK by A2, CGComp;
  then funS*funS*funS*funM3 in ClosGR funK by A2, CGComp;
  then funS*funS*funS*funM3*F in ClosGR funK by A1, CGComp;
  then funS*funS*funS*funM3*F*funK in ClosGR funK by A3, CGComp;
  then opPlusI.(funS*funS*funS*funM3*F*funK) in ClosGR funK by CGPlusI;
  then A4: funK*(opPlusI.(funS*funS*funS*funM3*F*funK)) in ClosGR funK
    by A3, CGComp;
  opPlusI.F in ClosGR funK by A1, CGPlusI;
  then funA*(opPlusI.F) in ClosGR funK by A3, CGComp;
  then opPlusI.(funA*(opPlusI.F)) in ClosGR funK by CGPlusI;
  hence thesis by A4, CGComp;
end;

theorem MinusIKVal:
  x <= F.x implies (exprMinusIK F).x = F.x -' x
proof
  assume A1: x <= F.x;
  set d = F.x -' x;
  A2: F.x = d + x by A1, XREAL_1:235;
  set s = F.x + x;
  set G2 = funS*funS*funS*funM3*F*funK;
  set w = funA.s + x;
  A3: (opPlusI.(funA*(opPlusI.F))).x = (funA*(opPlusI.F)).x + x by DefPlusI
    .= funA.((opPlusI.F).x) + x by CompVal
    .= w by DefPlusI;
  x <= s by NAT_1:11;
  then A4: funK.w = x by Diag;
  A5: G2.w = (funS*funS*funS*funM3*F).(funK.w) by CompVal
    .= (funS*funS*funS*funM3).(F.x) by A4, CompVal
    .= (funS*funS*funS).(funM3.(F.x)) by CompVal
    .= (funS*funS*funS).(3*F.x) by DefM3
    .= (funS*funS).(funS.(3*F.x)) by CompVal
    .= (funS*funS).(3*F.x + 1) by DefS
    .= funS.(funS.(3*F.x + 1)) by CompVal
    .= funS.(3*F.x + 1 + 1) by DefS
    .= 3*F.x + 1 + 1 + 1 by DefS;
  A6: funA.(s+1+1) = funA.(s+1) + (s+1) + 1 by ASuc
    .= funA.s + s + 1 + (s+1) + 1 by ASuc;
  A7: (opPlusI.G2).w = G2.w + w by DefPlusI
    .= funA.(s+1+1) + d by A2, A5, A6;
  s+1+1 = d + (2*x + 2) by A2;
  then d <= s+1+1 by NAT_1:11;
  then A8: funK.(funA.(s+1+1) + d) = d by Diag;
  thus (exprMinusIK F).x
      = (funK*(opPlusI.G2)).((opPlusI.(funA*(opPlusI.F))).x) by CompVal
     .= funK.((opPlusI.G2).w) by A3, CompVal
     .= d by A7, A8;
end;

theorem SqExprGK:
  exprMinusIK (exprMinusIK (exprMinusIK (funD*funZ))) = funSq
proof
  set G = funD*funZ;
  now
    let x;
    A1: G.x = funD.(funZ.x) by CompVal
      .= 2*(funZ.x) by DefD
      .= x*(x+3) by TwoZ
      .= x + (x*x + 2*x);
    then x <= G.x by NAT_1:11;
    then A2: (exprMinusIK G).x = x + (x*x + 2*x) -' x by A1, MinusIKVal
      .= x*x + 2*x by NAT_D:34
      .= x + (x*x + x);
    then x <= (exprMinusIK G).x by NAT_1:11;
    then A3: (exprMinusIK (exprMinusIK G)).x = x + (x*x + x) -' x
        by A2, MinusIKVal
      .= x*x + x by NAT_D:34;
    then x <= (exprMinusIK (exprMinusIK G)).x by NAT_1:11;
    hence (exprMinusIK (exprMinusIK (exprMinusIK G))).x = x*x + x -' x
        by A3, MinusIKVal
      .= x*x by NAT_D:34
      .= funSq.x by DefSq;
  end;
  hence thesis by UFunExt;
end;

theorem GKSq:
  funSq in ClosGR funK
proof
  funD in ClosGR funK & funZ in ClosGR funK by GKFirst, GKZ;
  then funD*funZ in ClosGR funK by CGComp;
  then exprMinusIK (funD*funZ) in ClosGR funK by MinusIKIn;
  then exprMinusIK (exprMinusIK (funD*funZ)) in ClosGR funK by MinusIKIn;
  then exprMinusIK (exprMinusIK (exprMinusIK (funD*funZ))) in ClosGR funK
    by MinusIKIn;
  hence thesis by SqExprGK;
end;

:: the predecessor P = K (K S)^-1
definition
  func exprPK -> Element of Funcs(NAT,NAT) equals
  funK*(opInv.(funK*funS));
  coherence;
end;

theorem KSSurj:
  funK*funS is surj
proof
  let x;
  take y = funA.x + 2*x;
  funA.(x+1) = funA.x + x + 1 by ASuc;
  then A1: y + 1 = funA.(x+1) + x;
  x <= x + 1 by NAT_1:11;
  then A2: funK.(funA.(x+1) + x) = x by Diag;
  thus (funK*funS).y = funK.(funS.y) by CompVal
    .= x by A1, A2, DefS;
end;

theorem PKVal:
  exprPK.0 = 0 & exprPK.(x+1) = x
proof
  set Q = opInv.(funK*funS);
  (funK*funS).0 = funK.(funS.0) by CompVal
    .= funK.(0 + 1) by DefS
    .= 0 by KSmall;
  then Q.0 <= 0 by KSSurj, InvLeast;
  then A1: Q.0 = 0;
  thus exprPK.0 = funK.(Q.0) by CompVal .= 0 by A1, KSmall;
  set y = Q.(x+1);
  A2: (funK*funS).y = x + 1 by KSSurj, InvRight;
  A3: funK.(y + 1) = funK.(funS.y) by DefS
    .= x + 1 by A2, CompVal;
  set t = funV.(y+1);
  A4: y + 1 = funA.t + funK.(y+1) & funK.(y+1) <= t by Decomp;
  then A5: y = funA.t + x by A3;
  x <= x + 1 by NAT_1:11;
  then x <= t by A3, A4, XXREAL_0:2;
  then funK.(funA.t + x) = x by Diag;
  hence thesis by A5, CompVal;
end;

theorem GKP:
  exprPK in ClosGR funK
proof
  A1: funK in ClosGR funK & funS in ClosGR funK by CGOne, GKFirst;
  then funK*funS in ClosGR funK by CGComp;
  then opInv.(funK*funS) in ClosGR funK by CGInv;
  hence thesis by A1, CGComp;
end;

theorem GKIminusF:
  F in ClosGR funK implies exprIminusF F in ClosGR funK
proof
  assume A1: F in ClosGR funK;
  A2: funK in ClosGR funK & funS in ClosGR funK & funZ in ClosGR funK
    by CGOne, GKFirst, GKZ;
  opPlusI.F in ClosGR funK by A1, CGPlusI;
  then funZ*(opPlusI.F) in ClosGR funK by A2, CGComp;
  then opPlusI.(funZ*(opPlusI.F)) in ClosGR funK by CGPlusI;
  then A3: opPlusI.(opPlusI.(funZ*(opPlusI.F))) in ClosGR funK by CGPlusI;
  funK*funS in ClosGR funK by A2, CGComp;
  then funK*funS*funS in ClosGR funK by A2, CGComp;
  then funK*funS*funS*funS in ClosGR funK by A2, CGComp;
  hence thesis by A3, CGComp;
end;

theorem IminusKVal:
  (exprIminusF funK).y = funA.(funV.y)
proof
  A1: y = funA.(funV.y) + funK.y by Decomp;
  then funK.y <= y by NAT_1:11;
  hence (exprIminusF funK).y = y -' funK.y by IminusFVal
    .= funA.(funV.y) by A1, NAT_D:34;
end;

definition
  func exprU -> Element of Funcs(NAT,NAT) equals
  exprIminusF (funA*funK*exprPK*(exprIminusF funK));
  coherence;
end;

theorem UIn:
  exprU in ClosGR funK
proof
  A1: funA in ClosGR funK & funK in ClosGR funK & exprPK in ClosGR funK
    by GKA, CGOne, GKP;
  then funA*funK in ClosGR funK by CGComp;
  then A2: funA*funK*exprPK in ClosGR funK by A1, CGComp;
  exprIminusF funK in ClosGR funK by A1, GKIminusF;
  then funA*funK*exprPK*(exprIminusF funK) in ClosGR funK by A2, CGComp;
  hence thesis by GKIminusF;
end;

theorem UVal:
  exprU.y = funV.y + funK.y
proof
  set t = funV.y, k = funK.y;
  set Q = funA*funK*exprPK*(exprIminusF funK);
  A1: y = funA.t + k & k <= t by Decomp;
  A2: Q.y = (funA*funK*exprPK).((exprIminusF funK).y) by CompVal
    .= (funA*funK*exprPK).(funA.t) by IminusKVal
    .= (funA*funK).(exprPK.(funA.t)) by CompVal
    .= funA.(funK.(exprPK.(funA.t))) by CompVal;
  per cases by NAT_1:14;
  suppose A3: t = 0;
    then A4: funA.t = 0 by AZero;
    then A5: Q.y = 0 by A2, PKVal, KSmall, AZero;
    A7: k = 0 by A1, A3;
    then A6: y = 0 by A1, A4;
    Q.y <= y by A5;
    hence exprU.y = y -' Q.y by IminusFVal
      .= 0 -' 0 by A5, A6
      .= 0 by XREAL_1:232
      .= t + k by A3, A7;
  end;
  suppose 1 <= t;
    then consider t1 being Nat such that A3: t = 1 + t1 by NAT_1:10;
    A4: funA.t = funA.t1 + t1 + 1 by A3, ASuc;
    t1 <= t1;
    then A5: funK.(funA.t1 + t1) = t1 by Diag;
    A6: Q.y = funA.t1 by A2, A4, A5, PKVal;
    A7: y = funA.t1 + (t + k) by A1, A3, A4;
    then Q.y <= y by A6, NAT_1:11;
    hence exprU.y = y -' Q.y by IminusFVal
      .= t + k by A6, A7, NAT_D:34;
  end;
end;

theorem UPair:
  k <= t implies exprU.(funA.t + k) = t + k
proof
  assume k <= t;
  then funV.(funA.t + k) = t & funK.(funA.t + k) = k by Diag;
  hence thesis by UVal;
end;

theorem USurj:
  exprU is surj
proof
  let x;
  consider h such that A1: x = 2*h or x = 2*h + 1 by Parity;
  per cases by A1;
  suppose A2: x = 2*h;
    take funA.h + h;
    h <= h;
    then exprU.(funA.h + h) = h + h by UPair;
    hence thesis by A2;
  end;
  suppose A2: x = 2*h + 1;
    take funA.(h+1) + h;
    h <= h + 1 by NAT_1:11;
    then exprU.(funA.(h+1) + h) = h + 1 + h by UPair;
    hence thesis by A2;
  end;
end;

:: Hf = K U^-1: the least y = A(t) + k with t + k = x has k = floor(x/2)
theorem HfExprK:
  funK*(opInv.exprU) = funHf
proof
  now
    let x;
    set y = (opInv.exprU).x, t = funV.y, k = funK.y;
    A0: exprU.y = x by USurj, InvRight;
    A1: t + k = x by A0, UVal;
    A2: y = funA.t + k & k <= t by Decomp;
    consider h such that A3: x = 2*h or x = 2*h + 1 by Parity;
    ex r st (r = 0 or r = 1) & x = 2*h + r
    proof
      per cases by A3;
      suppose A31: x = 2*h;
        take 0;
        thus thesis by A31;
      end;
      suppose A31: x = 2*h + 1;
        take 1;
        thus thesis by A31;
      end;
    end;
    then consider r such that A4: (r = 0 or r = 1) & x = 2*h + r;
    A5: funHf.x = x div 2 by DefHf .= h by A3, DivTwo;
    A6: k <= h
    proof
      assume not k <= h;
      then h + 1 <= k by NAT_1:13;
      then 2*(h + 1) <= 2*k by XREAL_1:64;
      then A7: 2*h + 2 <= 2*k;
      k + k <= t + k by A2, XREAL_1:6;
      then 2*h + 2 <= 2*h + r by A1, A4, A7, XXREAL_0:2;
      then 2 <= r by XREAL_1:6;
      hence contradiction by A4;
    end;
    h <= k
    proof
      assume not h <= k;
      then k + 1 <= h by NAT_1:13;
      then t + (k + 1) <= t + h by XREAL_1:6;
      then (h + r + 1) + h <= t + h by A1, A4;
      then A8: h + r + 1 <= t by XREAL_1:6;
      set y0 = funA.(h + r) + h;
      h <= h + r by NAT_1:11;
      then exprU.y0 = h + r + h by UPair .= x by A4;
      then A9: y <= y0 by USurj, InvLeast;
      A10: funA.(h + r + 1) = funA.(h + r) + (h + r) + 1 by ASuc;
      h <= h + r by NAT_1:11;
      then A13: h < h + r + 1 by NAT_1:13;
      funA.(h + r) <= funA.(h + r);
      then funA.(h + r) + h < funA.(h + r) + (h + r + 1) by A13, XREAL_1:8;
      then A11: y0 < funA.(h + r + 1) by A10;
      A12: funA.(h + r + 1) <= funA.t by A8, AMono;
      funA.t <= y by A2, NAT_1:11;
      then funA.(h + r + 1) <= y by A12, XXREAL_0:2;
      hence contradiction by A9, A11, XXREAL_0:2;
    end;
    then k = h by A6, XXREAL_0:1;
    hence (funK*(opInv.exprU)).x = funHf.x by A5, CompVal;
  end;
  hence thesis by UFunExt;
end;

theorem GKHf:
  funHf in ClosGR funK
proof
  funK in ClosGR funK & opInv.exprU in ClosGR funK by CGOne, UIn, CGInv;
  then funK*(opInv.exprU) in ClosGR funK by CGComp;
  hence thesis by HfExprK;
end;

definition
  func exprB -> Element of Funcs(NAT,NAT) equals
  exprIminusF ((exprIminusF (funSq*(exprIminusF funHf)*exprU))*
    (exprIminusF funK));
  coherence;
end;

theorem BIn:
  exprB in ClosGR funK
proof
  A1: funSq in ClosGR funK & funHf in ClosGR funK & funK in ClosGR funK &
    exprU in ClosGR funK by GKSq, GKHf, CGOne, UIn;
  then exprIminusF funHf in ClosGR funK by GKIminusF;
  then funSq*(exprIminusF funHf) in ClosGR funK by A1, CGComp;
  then funSq*(exprIminusF funHf)*exprU in ClosGR funK by A1, CGComp;
  then A2: exprIminusF (funSq*(exprIminusF funHf)*exprU) in ClosGR funK
    by GKIminusF;
  exprIminusF funK in ClosGR funK by A1, GKIminusF;
  then (exprIminusF (funSq*(exprIminusF funHf)*exprU))*(exprIminusF funK)
    in ClosGR funK by A2, CGComp;
  hence thesis by GKIminusF;
end;

theorem AHalf:
  (r = 0 or r = 1) implies funA.(2*h + r) = (h + r)*(h + r) + (h*h + h)
proof
  assume A1: r = 0 or r = 1;
  set t = 2*h + r;
  A2: 2*(funA.t) = t*t + t by TwoA;
  per cases by A1;
  suppose r = 0;
    then 2*(funA.t) = 2*((h + r)*(h + r) + (h*h + h)) by A2;
    hence thesis;
  end;
  suppose r = 1;
    then 2*(funA.t) = 2*((h + r)*(h + r) + (h*h + h)) by A2;
    hence thesis;
  end;
end;

:: B(y) = K(y) + ceil(V(y)/2)^2
theorem BVal:
  (r = 0 or r = 1) & funV.y = 2*h + r implies
  exprB.y = funK.y + (h + r)*(h + r)
proof
  assume that A1: r = 0 or r = 1 and A2: funV.y = 2*h + r;
  set t = funV.y, k = funK.y, c = h + r;
  set Q = funSq*(exprIminusF funHf)*exprU;
  A3: y = funA.t + k by Decomp;
  A4: funA.t = c*c + (h*h + h) by A1, A2, AHalf;
  A5: exprU.(funA.t + 0) = t + 0 by UPair;
  A6: funHf.t = t div 2 by DefHf .= h by A1, A2, DivTwo;
  A12: t = c + h by A2;
  then h <= t by NAT_1:11;
  then funHf.t <= t by A6;
  then A7: (exprIminusF funHf).t = t -' h by A6, IminusFVal
    .= c by A12, NAT_D:34;
  A8: Q.(funA.t) = (funSq*(exprIminusF funHf)).t by A5, CompVal
    .= funSq.((exprIminusF funHf).t) by CompVal
    .= c*c by A7, DefSq;
  then Q.(funA.t) <= funA.t by A4, NAT_1:11;
  then A9: (exprIminusF Q).(funA.t) = funA.t -' c*c by A8, IminusFVal
    .= h*h + h by A4, NAT_D:34;
  A10: ((exprIminusF Q)*(exprIminusF funK)).y
      = (exprIminusF Q).((exprIminusF funK).y) by CompVal
    .= h*h + h by A9, IminusKVal;
  A11: y = (h*h + h) + (k + c*c) by A3, A4;
  then h*h + h <= y by NAT_1:11;
  hence exprB.y = y -' (h*h + h) by A10, IminusFVal
    .= k + c*c by A11, NAT_D:34;
end;

theorem BSurj:
  exprB is surj
proof
  let x;
  set m = funRt.x, e = funE.x;
  take y = funA.(2*m + 0) + e;
  e <= 2*m by EBound;
  then A1: funV.y = 2*m + 0 & funK.y = e by Diag;
  thus exprB.y = e + (m + 0)*(m + 0) by A1, BVal
    .= x by EVal;
end;

theorem EExprK:
  funK*(opInv.exprB) = funE
proof
  now
    let x;
    set y = (opInv.exprB).x, t = funV.y, k = funK.y;
    A1: exprB.y = x by BSurj, InvRight;
    A2: k <= t by Decomp;
    consider h such that A3: t = 2*h or t = 2*h + 1 by Parity;
    ex r st (r = 0 or r = 1) & t = 2*h + r
    proof
      per cases by A3;
      suppose A31: t = 2*h;
        take 0;
        thus thesis by A31;
      end;
      suppose A31: t = 2*h + 1;
        take 1;
        thus thesis by A31;
      end;
    end;
    then consider r such that A4: (r = 0 or r = 1) & t = 2*h + r;
    A5: x = k + (h + r)*(h + r) by A1, A4, BVal;
    2*(h + r) = t + r by A4;
    then t <= 2*(h + r) by NAT_1:11;
    then k <= 2*(h + r) by A2, XXREAL_0:2;
    then funE.((h + r)*(h + r) + k) = k by ESqAdd;
    hence (funK*(opInv.exprB)).x = funE.x by A5, CompVal;
  end;
  hence thesis by UFunExt;
end;

theorem GKE:
  funE in ClosGR funK
proof
  funK in ClosGR funK & opInv.exprB in ClosGR funK by CGOne, BIn, CGInv;
  then funK*(opInv.exprB) in ClosGR funK by CGComp;
  hence thesis by EExprK;
end;

theorem GREqJR:
  ClosGR funE = ClosJR & ClosGR funK = ClosJR & ClosGR funL = ClosJR
proof
  thus A1: ClosGR funE = ClosJR by GREqJRE;
  A2: funK in ClosGR funE & funL in ClosGR funE by GERich, RichAVKL;
  then A3: ClosGR funK c= ClosGR funE by CGSub;
  A4: ClosGR funE c= ClosGR funK by GKE, CGSub;
  hence ClosGR funK = ClosJR by A1, A3, XBOOLE_0:def 10;
  A5: cst 1 in ClosGR funL & funL in ClosGR funL by CGOne;
  then A6: opPlusI.(cst 1) in ClosGR funL by CGPlusI;
  then opPlusI.(opPlusI.(cst 1)) in ClosGR funL by CGPlusI;
  then (opPlusI.(opPlusI.(cst 1)))*funL in ClosGR funL by A5, CGComp;
  then A7: opPlusI.((opPlusI.(opPlusI.(cst 1)))*funL) in ClosGR funL
    by CGPlusI;
  funL*(opPlusI.(cst 1)) in ClosGR funL by A5, A6, CGComp;
  then funK in ClosGR funL by A7, CGComp, KExprL;
  then ClosGR funK c= ClosGR funL by CGSub;
  then A8: ClosGR funE c= ClosGR funL by A4, XBOOLE_1:1;
  ClosGR funL c= ClosGR funE by A2, CGSub;
  hence thesis by A1, A8, XBOOLE_0:def 10;
end;

:: The constant 1 cannot be dropped: when every initial function fixes 0
:: and every operator preserves this, so does every generated function.

theorem Fix0Clos:
  I c= Funcs(NAT,NAT) & (for F st F in I holds F.0 = 0) &
  (for u being UnOp of Funcs(NAT,NAT), F st u in U & F.0 = 0
     holds (u.F).0 = 0) &
  F in clos(I,U,{opComp}) implies F.0 = 0
proof
  assume that A1: I c= Funcs(NAT,NAT) and
    A2: for F st F in I holds F.0 = 0 and
    A3: for u being UnOp of Funcs(NAT,NAT), F st u in U & F.0 = 0
      holds (u.F).0 = 0 and
    A4: F in clos(I,U,{opComp});
  defpred P[object] means ex G st G = $1 & G.0 = 0;
  consider Y such that
    A5: for G holds G in Y iff P[G] from SUBSET_1:sch 3;
  A6: for G holds G in Y iff G.0 = 0
  proof
    let G;
    thus G in Y implies G.0 = 0
    proof
      assume G in Y;
      then ex H st H = G & H.0 = 0 by A5;
      hence thesis;
    end;
    assume G.0 = 0;
    hence thesis by A5;
  end;
  Y is_closed_under I, U, {opComp}
  proof
    thus I c= Y
    proof
      let z be object;
      assume A7: z in I;
      then reconsider G = z as Element of Funcs(NAT,NAT) by A1;
      G.0 = 0 by A2, A7;
      hence thesis by A6;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), G being Element of Funcs(NAT,NAT)
      st u in U & G in Y holds u.G in Y
    proof
      let u be UnOp of Funcs(NAT,NAT), G be Element of Funcs(NAT,NAT);
      assume A8: u in U & G in Y;
      then G.0 = 0 by A6;
      then (u.G).0 = 0 by A3, A8;
      hence thesis by A6;
    end;
    let d be BinOp of Funcs(NAT,NAT), G,H be Element of Funcs(NAT,NAT);
    assume A9: d in {opComp} & G in Y & H in Y;
    then d = opComp by TARSKI:def 1;
    then A10: d.(G,H) = G*H by DefComp;
    (G*H).0 = G.(H.0) by CompVal .= G.0 by A6, A9 .= 0 by A6, A9;
    hence thesis by A6, A10;
  end;
  then clos(I,U,{opComp}) c= Y by ClosLeast;
  hence thesis by A4, A6;
end;

theorem InvFix0:
  F.0 = 0 implies (opInv.F).0 = 0
proof
  assume A1: F.0 = 0;
  per cases;
  suppose F is surj;
    then (opInv.F).0 <= 0 by A1, InvLeast;
    hence thesis;
  end;
  suppose not F is surj;
    hence thesis by A1, InvNot;
  end;
end;

theorem PlusIFix0:
  F.0 = 0 implies (opPlusI.F).0 = 0
proof
  assume A1: F.0 = 0;
  thus (opPlusI.F).0 = F.0 + 0 by DefPlusI .= 0 by A1;
end;

theorem BoxFix0:
  (opBox.F).0 = 0 by DefBox;

theorem SingleFuncs:
  {X} c= Funcs(NAT,NAT) & {W, X} c= Funcs(NAT,NAT)
proof
  thus {X} c= Funcs(NAT,NAT)
  proof
    let z be object;
    assume z in {X};
    then z = X by TARSKI:def 1;
    hence thesis;
  end;
  let z be object;
  assume z in {W, X};
  then z = W or z = X by TARSKI:def 2;
  hence thesis;
end;

theorem XFix0:
  funE.0 = 0 & funK.0 = 0 & funL.0 = 0
  by ESmall, KSmall, LZero;

:: the basis <X, F^+, FG, F^-1>
definition
  let X be Element of Funcs(NAT,NAT);
  func ClosGR0 X -> Subset of Funcs(NAT,NAT) equals
  clos({X}, {opPlusI, opInv}, {opComp});
  coherence;
end;

theorem GR0Fix:
  X.0 = 0 & F in ClosGR0 X implies F.0 = 0
proof
  assume that A1: X.0 = 0 and A2: F in ClosGR0 X;
  A3: for G st G in {X} holds G.0 = 0 by A1, TARSKI:def 1;
  A4: for u being UnOp of Funcs(NAT,NAT), G st u in {opPlusI, opInv} &
    G.0 = 0 holds (u.G).0 = 0
  proof
    let u be UnOp of Funcs(NAT,NAT), G;
    assume A5: u in {opPlusI, opInv} & G.0 = 0;
    then u = opPlusI or u = opInv by TARSKI:def 2;
    hence thesis by A5, PlusIFix0, InvFix0;
  end;
  {X} c= Funcs(NAT,NAT) by SingleFuncs;
  hence thesis by A2, A3, A4, Fix0Clos;
end;

theorem GR0Neq:
  ClosGR0 funE <> ClosJR & ClosGR0 funK <> ClosJR & ClosGR0 funL <> ClosJR
proof
  A1: (cst 1).0 = 1 by DefCst;
  A2: cst 1 in ClosJR by JRFirst;
  thus ClosGR0 funE <> ClosJR by A1, A2, XFix0, GR0Fix;
  thus ClosGR0 funK <> ClosJR by A1, A2, XFix0, GR0Fix;
  thus thesis by A1, A2, XFix0, GR0Fix;
end;

:: Remark: 1 and S are interchangeable: <S, X, F^+, FG, F^-1> with
:: 0 = (E S E^-1)(E S E^-1), 0 = K S K^-1 and 0 = L (L S)^-1 S
definition
  let X be Element of Funcs(NAT,NAT);
  func ClosGRS X -> Subset of Funcs(NAT,NAT) equals
  clos({funS, X}, {opPlusI, opInv}, {opComp});
  coherence;
end;

theorem CSBasic:
  funS in ClosGRS X & X in ClosGRS X &
  (F in ClosGRS X implies opPlusI.F in ClosGRS X & opInv.F in ClosGRS X) &
  (F in ClosGRS X & G in ClosGRS X implies F*G in ClosGRS X)
proof
  funS in {funS, X} & X in {funS, X} by TARSKI:def 2;
  hence funS in ClosGRS X & X in ClosGRS X by ClosInit;
  thus F in ClosGRS X implies opPlusI.F in ClosGRS X & opInv.F in ClosGRS X
  proof
    assume A1: F in ClosGRS X;
    opPlusI in {opPlusI, opInv} & opInv in {opPlusI, opInv} by TARSKI:def 2;
    hence thesis by A1, ClosUnop;
  end;
  thus thesis by CompIn;
end;

theorem GRSOne:
  cst 0 in ClosGRS X implies ClosGRS X = ClosGR X
proof
  assume A1: cst 0 in ClosGRS X;
  ClosGR X is_closed_under {funS, X}, {opPlusI, opInv}, {opComp}
  proof
    thus {funS, X} c= ClosGR X
    proof
      let z be object;
      assume z in {funS, X};
      then A2: z = funS or z = X by TARSKI:def 2;
      cst 1 in ClosGR X by CGOne;
      then funS in ClosGR X by CGPlusI, SExpr;
      hence thesis by A2, CGOne;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opInv} & F in ClosGR X holds u.F in ClosGR X
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A3: u in {opPlusI, opInv} & F in ClosGR X;
      then u = opPlusI or u = opInv by TARSKI:def 2;
      hence thesis by A3, CGPlusI, CGInv;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A4: c in {opComp} & F in ClosGR X & G in ClosGR X;
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A4, CGComp;
  end;
  then A5: ClosGRS X c= ClosGR X by ClosLeast;
  ClosGRS X is_closed_under {cst 1, X}, {opPlusI, opInv}, {opComp}
  proof
    thus {cst 1, X} c= ClosGRS X
    proof
      let z be object;
      assume z in {cst 1, X};
      then A6: z = cst 1 or z = X by TARSKI:def 2;
      funS in ClosGRS X by CSBasic;
      then funS*(cst 0) in ClosGRS X by A1, CSBasic;
      hence thesis by A6, CSBasic, OneExpr;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opInv} & F in ClosGRS X holds u.F in ClosGRS X
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A7: u in {opPlusI, opInv} & F in ClosGRS X;
      then u = opPlusI or u = opInv by TARSKI:def 2;
      hence thesis by A7, CSBasic;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A8: c in {opComp} & F in ClosGRS X & G in ClosGRS X;
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A8, CSBasic;
  end;
  then ClosGR X c= ClosGRS X by ClosLeast;
  hence thesis by A5, XBOOLE_0:def 10;
end;

:: (E S E^-1)(2q) = 0 and (E S E^-1)(2q+1) = 2q+2
theorem ESEinvVal:
  (funE*funS*(opInv.funE)).(2*q) = 0 &
  (funE*funS*(opInv.funE)).(2*q + 1) = 2*(q + 1)
proof
  set G = funE*funS*(opInv.funE);
  0 <= 2*(q + 1);
  then A1: funE.((q+1)*(q+1) + 0) = 0 by ESqAdd;
  thus G.(2*q) = (funE*funS).((opInv.funE).(2*q)) by CompVal
    .= (funE*funS).(q*q + 2*q) by EinvD
    .= funE.(funS.(q*q + 2*q)) by CompVal
    .= funE.(q*q + 2*q + 1) by DefS
    .= 0 by A1;
  set y = 2*q + 1, c = q + 1;
  A2: 2*c = y + 1;
  then y <= 2*c by NAT_1:11;
  then A3: (opInv.funE).y = c*c + y by A2, EinvVal;
  2*c <= 2*c;
  then A4: funE.(c*c + 2*c) = 2*c by ESqAdd;
  thus G.y = (funE*funS).((opInv.funE).y) by CompVal
    .= funE.(funS.(c*c + y)) by A3, CompVal
    .= funE.(c*c + y + 1) by DefS
    .= 2*c by A2, A4;
end;

theorem LSSurj:
  funL*funS is surj
proof
  let x;
  take funA.(x+1);
  1 <= x + 1 by NAT_1:11;
  then A1: funL.(funA.(x+1) + 1) = x + 1 -' 1 by Diag;
  thus (funL*funS).(funA.(x+1)) = funL.(funS.(funA.(x+1))) by CompVal
    .= funL.(funA.(x+1) + 1) by DefS
    .= x by A1, NAT_D:34;
end;

theorem LSinvSuc:
  (opInv.(funL*funS)).(x+1) = funA.x + x
proof
  set y = (opInv.(funL*funS)).(x+1);
  A1: funA.(x+1) = funA.x + x + 1 by ASuc;
  0 <= x + 1;
  then funL.(funA.(x+1) + 0) = x + 1 -' 0 by Diag;
  then A2: funL.(funA.(x+1)) = x + 1 by NAT_D:40;
  (funL*funS).(funA.x + x) = funL.(funS.(funA.x + x)) by CompVal
    .= funL.(funA.x + x + 1) by DefS
    .= x + 1 by A1, A2;
  then A3: y <= funA.x + x by LSSurj, InvLeast;
  (funL*funS).y = x + 1 by LSSurj, InvRight;
  then A4: funL.(funS.y) = x + 1 by CompVal;
  set t = funV.(y+1), k = funK.(y+1);
  A5: y + 1 = funA.t + k & k <= t by Decomp;
  funL.(funS.y) = funL.(y+1) by DefS
    .= t -' k by A5, Diag;
  then x + 1 <= t by A4, NAT_D:35;
  then A6: funA.(x+1) <= funA.t by AMono;
  funA.t <= y + 1 by A5, NAT_1:11;
  then funA.x + x + 1 <= y + 1 by A1, A6, XXREAL_0:2;
  then funA.x + x <= y by XREAL_1:6;
  hence thesis by A3, XXREAL_0:1;
end;

theorem GRSZero:
  cst 0 in ClosGRS funE & cst 0 in ClosGRS funK & cst 0 in ClosGRS funL
proof
  set G = funE*funS*(opInv.funE);
  now
    let x;
    consider q such that A1: x = 2*q or x = 2*q + 1 by Parity;
    per cases by A1;
    suppose x = 2*q;
      then A2: G.x = 2*0 by ESEinvVal;
      thus (G*G).x = G.(G.x) by CompVal .= 0 by A2, ESEinvVal
        .= (cst 0).x by DefCst;
    end;
    suppose x = 2*q + 1;
      then A2: G.x = 2*(q + 1) by ESEinvVal;
      thus (G*G).x = G.(G.x) by CompVal .= 0 by A2, ESEinvVal
        .= (cst 0).x by DefCst;
    end;
  end;
  then A3: G*G = cst 0 by UFunExt;
  A4: funS in ClosGRS funE & funE in ClosGRS funE by CSBasic;
  then A5: funE*funS in ClosGRS funE by CSBasic;
  opInv.funE in ClosGRS funE by A4, CSBasic;
  then G in ClosGRS funE by A5, CSBasic;
  hence cst 0 in ClosGRS funE by A3, CSBasic;
  now
    let x;
    A6: funA.(x+1) = funA.x + x + 1 by ASuc;
    0 <= x + 1;
    then A7: funK.(funA.(x+1) + 0) = 0 by Diag;
    thus (funK*funS*(opInv.funK)).x = (funK*funS).((opInv.funK).x) by CompVal
      .= (funK*funS).(funZ.x) by KinvZ
      .= funK.(funS.(funZ.x)) by CompVal
      .= funK.(funZ.x + 1) by DefS
      .= funK.(funA.x + x + 1) by DefZ
      .= 0 by A6, A7
      .= (cst 0).x by DefCst;
  end;
  then A8: funK*funS*(opInv.funK) = cst 0 by UFunExt;
  A9: funS in ClosGRS funK & funK in ClosGRS funK by CSBasic;
  then A10: funK*funS in ClosGRS funK by CSBasic;
  opInv.funK in ClosGRS funK by A9, CSBasic;
  hence cst 0 in ClosGRS funK by A8, A10, CSBasic;
  now
    let x;
    x <= x;
    then A11: funL.(funA.x + x) = x -' x by Diag;
    thus (funL*(opInv.(funL*funS))*funS).x
        = (funL*(opInv.(funL*funS))).(funS.x) by CompVal
      .= (funL*(opInv.(funL*funS))).(x + 1) by DefS
      .= funL.((opInv.(funL*funS)).(x + 1)) by CompVal
      .= funL.(funA.x + x) by LSinvSuc
      .= 0 by A11, XREAL_1:232
      .= (cst 0).x by DefCst;
  end;
  then A12: funL*(opInv.(funL*funS))*funS = cst 0 by UFunExt;
  A13: funS in ClosGRS funL & funL in ClosGRS funL by CSBasic;
  then funL*funS in ClosGRS funL by CSBasic;
  then opInv.(funL*funS) in ClosGRS funL by CSBasic;
  then funL*(opInv.(funL*funS)) in ClosGRS funL by A13, CSBasic;
  hence thesis by A12, A13, CSBasic;
end;

theorem GRSEq:
  ClosGRS funE = ClosJR & ClosGRS funK = ClosJR & ClosGRS funL = ClosJR
proof
  ClosGRS funE = ClosGR funE & ClosGRS funK = ClosGR funK &
    ClosGRS funL = ClosGR funL by GRSZero, GRSOne;
  hence thesis by GREqJR;
end;

:: The shifted operator with inversion: <X, F^+b, FG, F^-1> generates
:: ClosJR if and only if b >= 1 (X in {E, K, L}).  A successor S is generated
:: first; a predecessor P then gives F^+ = P^b F^+b and the constant 1.

reserve g,v,n1,c1 for Nat;

definition
  let X be Element of Funcs(NAT,NAT), b be Nat;
  func ClosGRb(X,b) -> Subset of Funcs(NAT,NAT) equals
  clos({X}, {opPlusIb b, opInv}, {opComp});
  coherence;
end;

theorem CbBasic:
  X in ClosGRb(X,b) &
  (F in ClosGRb(X,b) implies
     (opPlusIb b).F in ClosGRb(X,b) & opInv.F in ClosGRb(X,b)) &
  (F in ClosGRb(X,b) & G in ClosGRb(X,b) implies F*G in ClosGRb(X,b))
proof
  X in {X} by TARSKI:def 1;
  hence X in ClosGRb(X,b) by ClosInit;
  thus F in ClosGRb(X,b) implies
     (opPlusIb b).F in ClosGRb(X,b) & opInv.F in ClosGRb(X,b)
  proof
    assume A1: F in ClosGRb(X,b);
    opPlusIb b in {opPlusIb b, opInv} & opInv in {opPlusIb b, opInv}
      by TARSKI:def 2;
    hence thesis by A1, ClosUnop;
  end;
  thus thesis by CompIn;
end;

:: F^+ = P^b F^+b for a predecessor P
theorem CbPlusI:
  W in ClosGRb(X,b) & (for x holds W.(x+1) = x) & F in ClosGRb(X,b)
  implies opPlusI.F in ClosGRb(X,b)
proof
  assume that A1: W in ClosGRb(X,b) and A2: for x holds W.(x+1) = x and
    A3: F in ClosGRb(X,b);
  (opPlusIb b).F in ClosGRb(X,b) by A3, CbBasic;
  then consider H such that A4: H in ClosGRb(X,b) and
    A5: for x,y st ((opPlusIb b).F).x = y + b holds H.x = y
    by A1, A2, PowPred;
  now
    let x;
    ((opPlusIb b).F).x = (F.x + x) + b by DefPlusIb;
    hence H.x = F.x + x by A5
      .= (opPlusI.F).x by DefPlusI;
  end;
  hence thesis by A4, UFunExt;
end;

theorem CbSub:
  cst 1 in ClosGRb(X,b) & W in ClosGRb(X,b) & (for x holds W.(x+1) = x)
  implies ClosGR X c= ClosGRb(X,b)
proof
  assume that A1: cst 1 in ClosGRb(X,b) and A2: W in ClosGRb(X,b) and
    A3: for x holds W.(x+1) = x;
  ClosGRb(X,b) is_closed_under {cst 1, X}, {opPlusI, opInv}, {opComp}
  proof
    thus {cst 1, X} c= ClosGRb(X,b)
    proof
      let z be object;
      assume z in {cst 1, X};
      then z = cst 1 or z = X by TARSKI:def 2;
      hence thesis by A1, CbBasic;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusI, opInv} & F in ClosGRb(X,b) holds u.F in ClosGRb(X,b)
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A4: u in {opPlusI, opInv} & F in ClosGRb(X,b);
      then A5: u = opPlusI or u = opInv by TARSKI:def 2;
      opPlusI.F in ClosGRb(X,b) by A2, A3, A4, CbPlusI;
      hence thesis by A4, A5, CbBasic;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A6: c in {opComp} & F in ClosGRb(X,b) & G in ClosGRb(X,b);
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A6, CbBasic;
  end;
  hence thesis by ClosLeast;
end;

:: soundness: F^+b = F^+ + M_b 1
theorem GEPlusIb:
  F in ClosGR funE implies (opPlusIb b).F in ClosGR funE
proof
  assume A1: F in ClosGR funE;
  opPlusI in {opPlusI, opInv} by TARSKI:def 2;
  then A0: funM b in ClosGR funE by GEFirst, MInClos;
  cst 1 in ClosGR funE by CGOne;
  then A2: (funM b)*(cst 1) in ClosGR funE by A0, CGComp;
  opPlusI.F in ClosGR funE by A1, CGPlusI;
  then A3: opPlus.(opPlusI.F, (funM b)*(cst 1)) in ClosGR funE
    by A2, GERich, RLemma66;
  now
    let x;
    thus (opPlus.(opPlusI.F, (funM b)*(cst 1))).x
        = (opPlusI.F).x + ((funM b)*(cst 1)).x by DefPlus
      .= F.x + x + ((funM b)*(cst 1)).x by DefPlusI
      .= F.x + x + (funM b).((cst 1).x) by CompVal
      .= F.x + x + (funM b).1 by DefCst
      .= F.x + x + b*1 by DefM
      .= ((opPlusIb b).F).x by DefPlusIb;
  end;
  hence thesis by A3, UFunExt;
end;

theorem GRbSubGE:
  X in ClosGR funE implies ClosGRb(X,b) c= ClosGR funE
proof
  assume A1: X in ClosGR funE;
  ClosGR funE is_closed_under {X}, {opPlusIb b, opInv}, {opComp}
  proof
    thus {X} c= ClosGR funE
    proof
      let z be object;
      assume z in {X};
      hence thesis by A1, TARSKI:def 1;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in {opPlusIb b, opInv} & F in ClosGR funE holds u.F in ClosGR funE
    proof
      let u be UnOp of Funcs(NAT,NAT), F be Element of Funcs(NAT,NAT);
      assume A2: u in {opPlusIb b, opInv} & F in ClosGR funE;
      then u = opPlusIb b or u = opInv by TARSKI:def 2;
      hence thesis by A2, GEPlusIb, CGInv;
    end;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A3: c in {opComp} & F in ClosGR funE & G in ClosGR funE;
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A3, CGComp;
  end;
  hence thesis by ClosLeast;
end;

theorem TVal:
  ((opPlusIb b).funI).x = 2*x + b
proof
  thus ((opPlusIb b).funI).x = funI.x + x + b by DefPlusIb
    .= x + x + b by DefI
    .= 2*x + b;
end;

theorem EEinv:
  funE*(opInv.funE) = funI
proof
  now
    let x;
    thus (funE*(opInv.funE)).x = funE.((opInv.funE).x) by CompVal
      .= x by ESurj, InvRight
      .= funI.x by DefI;
  end;
  hence thesis by UFunExt;
end;

theorem EinvOdd:
  (opInv.funE).(2*m + 1) = (m+1)*(m+1) + (2*m + 1)
proof
  A1: 2*(m+1) = (2*m + 1) + 1;
  then 2*m + 1 <= 2*(m+1) by NAT_1:11;
  hence thesis by A1, EinvVal;
end;

:: subtraction by inversion: if V(y) = y + c then E (E V)^-1 subtracts c
theorem ESubInv:
  (for y holds W.y = y + c) & c <= x implies
  funE*W is surj & funE.((opInv.(funE*W)).x) = x -' c
proof
  assume that A1: for y holds W.y = y + c and A2: c <= x;
  thus A3: funE*W is surj
  proof
    let x;
    set n = x + c;
    A4: n <= n*n by LeSq;
    c <= n by NAT_1:11;
    then c <= n*n by A4, XXREAL_0:2;
    then A5: c <= n*n + x by NAT_1:12;
    take y = n*n + x -' c;
    A6: W.y = y + c by A1 .= n*n + x by A5, XREAL_1:235;
    2*n = x + (x + 2*c);
    then A7: x <= 2*n by NAT_1:11;
    thus (funE*W).y = funE.(W.y) by CompVal .= x by A6, A7, ESqAdd;
  end;
  set y = (opInv.(funE*W)).x;
  (funE*W).y = x by A3, InvRight;
  then A8: funE.(W.y) = x by CompVal;
  set r = funRt.(y + c);
  A9: funE.(y + c) = x by A1, A8;
  then A10: x + r*r = y + c by EVal;
  A11: x <= 2*r by A9, EBound;
  set d = x -' c;
  A12: x = d + c by A2, XREAL_1:235;
  then A13: y = r*r + d by A10;
  d <= x by A12, NAT_1:11;
  then d <= 2*r by A11, XXREAL_0:2;
  hence thesis by A13, ESqAdd;
end;

:: E(E^-1(2m) + x + c + 1) = x + c and E(E^-1(2m+1) + x + c + 2) = x + c
theorem EShift:
  (x + c <= 2*(m+1) implies
     funE.((opInv.funE).(2*m) + x + (c + 1)) = x + c) &
  (x + c <= 2*(m+2) implies
     funE.((opInv.funE).(2*m + 1) + x + (c + 2)) = x + c)
proof
  thus x + c <= 2*(m+1) implies
     funE.((opInv.funE).(2*m) + x + (c + 1)) = x + c
  proof
    assume A1: x + c <= 2*(m+1);
    (opInv.funE).(2*m) + x + (c + 1) = m*m + 2*m + x + (c + 1) by EinvD
      .= (m+1)*(m+1) + (x + c);
    hence thesis by A1, ESqAdd;
  end;
  assume A1: x + c <= 2*(m+2);
  (opInv.funE).(2*m + 1) + x + (c + 2)
      = (m+1)*(m+1) + (2*m + 1) + x + (c + 2) by EinvOdd
    .= (m+2)*(m+2) + (x + c);
  hence thesis by A1, ESqAdd;
end;

:: b >= 2: W1 = E (E^-1 T)^+b and W2 = E (E^-1 W1 T)^+b (T = I^+b) are the
:: shifts x + b - 1 and x + b - 2 in an order given by the parity of b
definition
  let b be Nat;
  func exprW1 b -> Element of Funcs(NAT,NAT) equals
  funE*((opPlusIb b).((opInv.funE)*((opPlusIb b).funI)));
  coherence;
end;

definition
  let b be Nat;
  func exprW2 b -> Element of Funcs(NAT,NAT) equals
  funE*((opPlusIb b).((opInv.funE)*(exprW1 b)*((opPlusIb b).funI)));
  coherence;
end;

theorem W12Unfold:
  (exprW1 b).x = funE.((opInv.funE).(2*x + b) + x + b) &
  (exprW2 b).x = funE.((opInv.funE).((exprW1 b).(2*x + b)) + x + b)
proof
  set T = (opPlusIb b).funI;
  thus (exprW1 b).x = funE.(((opPlusIb b).((opInv.funE)*T)).x) by CompVal
    .= funE.(((opInv.funE)*T).x + x + b) by DefPlusIb
    .= funE.((opInv.funE).(T.x) + x + b) by CompVal
    .= funE.((opInv.funE).(2*x + b) + x + b) by TVal;
  thus (exprW2 b).x
      = funE.(((opPlusIb b).((opInv.funE)*(exprW1 b)*T)).x) by CompVal
    .= funE.(((opInv.funE)*(exprW1 b)*T).x + x + b) by DefPlusIb
    .= funE.(((opInv.funE)*(exprW1 b)).(T.x) + x + b) by CompVal
    .= funE.((opInv.funE).((exprW1 b).(T.x)) + x + b) by CompVal
    .= funE.((opInv.funE).((exprW1 b).(2*x + b)) + x + b) by TVal;
end;

theorem W12Val:
  (b = 2*p + 2 implies
     (exprW1 b).x = x + (2*p + 1) & (exprW2 b).x = x + 2*p) &
  (b = 2*p + 3 implies
     (exprW1 b).x = x + (2*p + 1) & (exprW2 b).x = x + (2*p + 2))
proof
  thus b = 2*p + 2 implies
     (exprW1 b).x = x + (2*p + 1) & (exprW2 b).x = x + 2*p
  proof
    assume A1: b = 2*p + 2;
    A10: for x holds (exprW1 b).x = x + (2*p + 1)
    proof
      let x;
      A2: 2*x + b = 2*(x + p + 1) by A1;
      2*(x + p + 1 + 1) = (x + (2*p + 1)) + (x + 3);
      then A3: x + (2*p + 1) <= 2*(x + p + 1 + 1) by NAT_1:11;
      thus (exprW1 b).x = funE.((opInv.funE).(2*x + b) + x + b) by W12Unfold
        .= funE.((opInv.funE).(2*(x + p + 1)) + x + ((2*p + 1) + 1))
          by A1, A2
        .= x + (2*p + 1) by A3, EShift;
    end;
    hence (exprW1 b).x = x + (2*p + 1);
    A4: (exprW1 b).(2*x + b) = 2*x + b + (2*p + 1) by A10
      .= 2*(x + 2*p + 1) + 1 by A1;
    2*(x + 2*p + 1 + 2) = (x + 2*p) + (x + 2*p + 6);
    then A5: x + 2*p <= 2*(x + 2*p + 1 + 2) by NAT_1:11;
    thus (exprW2 b).x
        = funE.((opInv.funE).((exprW1 b).(2*x + b)) + x + b) by W12Unfold
      .= funE.((opInv.funE).(2*(x + 2*p + 1) + 1) + x + (2*p + 2)) by A1, A4
      .= x + 2*p by A5, EShift;
  end;
  assume A1: b = 2*p + 3;
  A10: for x holds (exprW1 b).x = x + (2*p + 1)
  proof
    let x;
    A2: 2*x + b = 2*(x + p + 1) + 1 by A1;
    2*(x + p + 1 + 2) = (x + (2*p + 1)) + (x + 5);
    then A3: x + (2*p + 1) <= 2*(x + p + 1 + 2) by NAT_1:11;
    thus (exprW1 b).x = funE.((opInv.funE).(2*x + b) + x + b) by W12Unfold
      .= funE.((opInv.funE).(2*(x + p + 1) + 1) + x + ((2*p + 1) + 2))
        by A1, A2
      .= x + (2*p + 1) by A3, EShift;
  end;
  hence (exprW1 b).x = x + (2*p + 1);
  A4: (exprW1 b).(2*x + b) = 2*x + b + (2*p + 1) by A10
    .= 2*(x + 2*p + 2) by A1;
  2*(x + 2*p + 2 + 1) = (x + (2*p + 2)) + (x + 2*p + 4);
  then A5: x + (2*p + 2) <= 2*(x + 2*p + 2 + 1) by NAT_1:11;
  thus (exprW2 b).x
      = funE.((opInv.funE).((exprW1 b).(2*x + b)) + x + b) by W12Unfold
    .= funE.((opInv.funE).(2*(x + 2*p + 2)) + x + ((2*p + 2) + 1)) by A1, A4
    .= x + (2*p + 2) by A5, EShift;
end;

theorem CbEFirst:
  funI in ClosGRb(funE,b) & exprW1 b in ClosGRb(funE,b) &
  exprW2 b in ClosGRb(funE,b)
proof
  A1: funE in ClosGRb(funE,b) by CbBasic;
  then A2: opInv.funE in ClosGRb(funE,b) by CbBasic;
  hence A3: funI in ClosGRb(funE,b) by A1, CbBasic, EEinv;
  then A4: (opPlusIb b).funI in ClosGRb(funE,b) by CbBasic;
  then (opInv.funE)*((opPlusIb b).funI) in ClosGRb(funE,b) by A2, CbBasic;
  then (opPlusIb b).((opInv.funE)*((opPlusIb b).funI)) in ClosGRb(funE,b)
    by CbBasic;
  hence A5: exprW1 b in ClosGRb(funE,b) by A1, CbBasic;
  (opInv.funE)*(exprW1 b) in ClosGRb(funE,b) by A2, A5, CbBasic;
  then (opInv.funE)*(exprW1 b)*((opPlusIb b).funI) in ClosGRb(funE,b)
    by A4, CbBasic;
  then (opPlusIb b).((opInv.funE)*(exprW1 b)*((opPlusIb b).funI))
    in ClosGRb(funE,b) by CbBasic;
  hence thesis by A1, CbBasic;
end;

theorem CbEShifts:
  b = d + 2 implies ex G,H st G in ClosGRb(funE,b) & H in ClosGRb(funE,b) &
  for x holds G.x = x + (d + 1) & H.x = x + d
proof
  assume A1: b = d + 2;
  consider p such that A2: d = 2*p or d = 2*p + 1 by Parity;
  A3: exprW1 b in ClosGRb(funE,b) & exprW2 b in ClosGRb(funE,b) by CbEFirst;
  per cases by A2;
  suppose A4: d = 2*p;
    then A5: b = 2*p + 2 by A1;
    take exprW1 b, exprW2 b;
    thus exprW1 b in ClosGRb(funE,b) & exprW2 b in ClosGRb(funE,b) by A3;
    let x;
    (exprW1 b).x = x + (2*p + 1) & (exprW2 b).x = x + 2*p by A5, W12Val;
    hence thesis by A4;
  end;
  suppose A4: d = 2*p + 1;
    then A5: b = 2*p + 3 by A1;
    take exprW2 b, exprW1 b;
    thus exprW2 b in ClosGRb(funE,b) & exprW1 b in ClosGRb(funE,b) by A3;
    let x;
    (exprW1 b).x = x + (2*p + 1) & (exprW2 b).x = x + (2*p + 2) by A5, W12Val;
    hence thesis by A4;
  end;
end;

:: b = 1: P^ = E (E^-1 T)^+1 (P^(y+1) = y, P^(0) = 2) and
:: S = E P^^-1 (E^-1 P^ T)^+1
definition
  func exprPE1 -> Element of Funcs(NAT,NAT) equals
  exprW1 1;
  coherence;
end;

definition
  func exprSE1 -> Element of Funcs(NAT,NAT) equals
  funE*(opInv.exprPE1)*((opPlusIb 1).((opInv.funE)*exprPE1*
    ((opPlusIb 1).funI)));
  coherence;
end;

theorem PE1Val:
  exprPE1.0 = 2 & exprPE1.(y+1) = y
proof
  A1: for x holds exprPE1.x = funE.((opInv.funE).(2*x + 1) + x + 1)
    by W12Unfold;
  thus exprPE1.0 = funE.((opInv.funE).(2*0 + 1) + 0 + 1) by A1
    .= funE.((0+1)*(0+1) + (2*0 + 1) + 0 + 1) by EinvOdd
    .= 2 by ESmall;
  2*(y + 3) = y + (y + 6);
  then A2: y <= 2*(y + 3) by NAT_1:11;
  thus exprPE1.(y+1) = funE.((opInv.funE).(2*(y+1) + 1) + (y+1) + 1) by A1
    .= funE.((y+1+1)*(y+1+1) + (2*(y+1) + 1) + (y+1) + 1) by EinvOdd
    .= funE.((y+3)*(y+3) + y)
    .= y by A2, ESqAdd;
end;

theorem PE1Inv:
  v <> 2 implies (opInv.exprPE1).v = v + 1
proof
  assume A1: v <> 2;
  A2: exprPE1 is surj
  proof
    let x;
    take x + 1;
    thus thesis by PE1Val;
  end;
  set y = (opInv.exprPE1).v;
  A3: exprPE1.y = v by A2, InvRight;
  per cases by NAT_1:14;
  suppose y = 0;
    hence thesis by A1, A3, PE1Val;
  end;
  suppose 1 <= y;
    then consider y1 being Nat such that A4: y = 1 + y1 by NAT_1:10;
    thus thesis by A3, A4, PE1Val;
  end;
end;

theorem SE1Val:
  exprSE1 = funS
proof
  now
    let x;
    set G = (opInv.funE)*exprPE1*((opPlusIb 1).funI);
    set v = x*x + 3*x + 1;
    A1: exprPE1.(2*x + 1) = 2*x by PE1Val;
    A2: ((opPlusIb 1).G).x = G.x + x + 1 by DefPlusIb
      .= ((opInv.funE)*exprPE1).(((opPlusIb 1).funI).x) + x + 1 by CompVal
      .= ((opInv.funE)*exprPE1).(2*x + 1) + x + 1 by TVal
      .= (opInv.funE).(exprPE1.(2*x + 1)) + x + 1 by CompVal
      .= x*x + 2*x + x + 1 by A1, EinvD
      .= v;
    A3: v <> 2
    proof
      assume A4: v = 2;
      per cases by NAT_1:14;
      suppose x = 0;
        hence contradiction by A4;
      end;
      suppose 1 <= x;
        then 3*1 <= 3*x by XREAL_1:64;
        then 3 + 1 <= 3*x + 1 by XREAL_1:6;
        then 4 <= x*x + (3*x + 1) by NAT_1:12;
        hence contradiction by A4;
      end;
    end;
    2*(x+1) = (x+1) + (x+1);
    then A5: x + 1 <= 2*(x+1) by NAT_1:11;
    thus exprSE1.x = (funE*(opInv.exprPE1)).(((opPlusIb 1).G).x) by CompVal
      .= funE.((opInv.exprPE1).v) by A2, CompVal
      .= funE.(v + 1) by A3, PE1Inv
      .= funE.((x+1)*(x+1) + (x+1))
      .= x + 1 by A5, ESqAdd
      .= funS.x by DefS;
  end;
  hence thesis by UFunExt;
end;

theorem CbES:
  1 <= b implies funS in ClosGRb(funE,b)
proof
  assume A1: 1 <= b;
  A2: funE in ClosGRb(funE,b) & funI in ClosGRb(funE,b) by CbBasic, CbEFirst;
  then A3: opInv.funE in ClosGRb(funE,b) by CbBasic;
  per cases by A1, XXREAL_0:1;
  suppose A4: b = 1;
    A9: (opPlusIb 1).funI in ClosGRb(funE,b) by A2, A4, CbBasic;
    then A5: (opInv.funE)*((opPlusIb 1).funI) in ClosGRb(funE,b)
      by A3, CbBasic;
    then A6: (opPlusIb 1).((opInv.funE)*((opPlusIb 1).funI))
      in ClosGRb(funE,b) by A4, CbBasic;
    then A7: exprPE1 in ClosGRb(funE,b) by A2, CbBasic;
    then opInv.exprPE1 in ClosGRb(funE,b) by CbBasic;
    then A8: funE*(opInv.exprPE1) in ClosGRb(funE,b) by A2, CbBasic;
    (opInv.funE)*exprPE1 in ClosGRb(funE,b) by A3, A7, CbBasic;
    then (opInv.funE)*exprPE1*((opPlusIb 1).funI) in ClosGRb(funE,b)
      by A9, CbBasic;
    then (opPlusIb 1).((opInv.funE)*exprPE1*((opPlusIb 1).funI))
      in ClosGRb(funE,b) by A4, CbBasic;
    then exprSE1 in ClosGRb(funE,b) by A8, CbBasic;
    hence thesis by SE1Val;
  end;
  suppose 1 < b;
    then 1 + 1 <= b by NAT_1:13;
    then consider d such that A4: b = 2 + d by NAT_1:10;
    consider G,H such that A5: G in ClosGRb(funE,b) & H in ClosGRb(funE,b)
      and A6: for x holds G.x = x + (d + 1) & H.x = x + d by A4, CbEShifts;
    A7: for y holds H.y = y + d by A6;
    funE*H in ClosGRb(funE,b) by A2, A5, CbBasic;
    then opInv.(funE*H) in ClosGRb(funE,b) by CbBasic;
    then funE*(opInv.(funE*H)) in ClosGRb(funE,b) by A2, CbBasic;
    then A8: funE*(opInv.(funE*H))*G in ClosGRb(funE,b) by A5, CbBasic;
    now
      let x;
      d <= x + 1 + d by NAT_1:11;
      then A9: funE.((opInv.(funE*H)).(x + 1 + d)) = x + 1 + d -' d
        by A7, ESubInv;
      thus (funE*(opInv.(funE*H))*G).x = (funE*(opInv.(funE*H))).(G.x)
          by CompVal
        .= (funE*(opInv.(funE*H))).(x + (d + 1)) by A6
        .= funE.((opInv.(funE*H)).(x + 1 + d)) by CompVal
        .= x + 1 by A9, NAT_D:34
        .= funS.x by DefS;
    end;
    hence thesis by A8, UFunExt;
  end;
end;

theorem ZeroExprE:
  funE*funS*(opInv.funE)*(opPlusI.funI) = cst 0
proof
  now
    let x;
    A1: (opPlusI.funI).x = funI.x + x by DefPlusI .= x + x by DefI
      .= 2*x;
    0 <= 2*(x+1);
    then A2: funE.((x+1)*(x+1) + 0) = 0 by ESqAdd;
    thus (funE*funS*(opInv.funE)*(opPlusI.funI)).x
        = (funE*funS*(opInv.funE)).(2*x) by A1, CompVal
      .= (funE*funS).((opInv.funE).(2*x)) by CompVal
      .= (funE*funS).(x*x + 2*x) by EinvD
      .= funE.(funS.(x*x + 2*x)) by CompVal
      .= funE.(x*x + 2*x + 1) by DefS
      .= 0 by A2
      .= (cst 0).x by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem GRbE:
  1 <= b implies ClosGRb(funE,b) = ClosJR
proof
  assume A1: 1 <= b;
  A2: funS in ClosGRb(funE,b) & funE in ClosGRb(funE,b) &
    funI in ClosGRb(funE,b) by A1, CbES, CbBasic, CbEFirst;
  then funE*funS in ClosGRb(funE,b) by CbBasic;
  then opInv.(funE*funS) in ClosGRb(funE,b) by CbBasic;
  then A3: funE*(opInv.(funE*funS)) in ClosGRb(funE,b) by A2, CbBasic;
  A4: for y holds funS.y = y + 1 by DefS;
  A5: for x holds (funE*(opInv.(funE*funS))).(x+1) = x
  proof
    let x;
    1 <= x + 1 by NAT_1:11;
    then funE.((opInv.(funE*funS)).(x+1)) = x + 1 -' 1 by A4, ESubInv;
    hence (funE*(opInv.(funE*funS))).(x+1) = x + 1 -' 1 by CompVal
      .= x by NAT_D:34;
  end;
  then A6: opPlusI.funI in ClosGRb(funE,b) by A2, A3, CbPlusI;
  A9: opInv.funE in ClosGRb(funE,b) by A2, CbBasic;
  funE*funS in ClosGRb(funE,b) by A2, CbBasic;
  then A7: funE*funS*(opInv.funE) in ClosGRb(funE,b) by A9, CbBasic;
  then funE*funS*(opInv.funE)*(opPlusI.funI) in ClosGRb(funE,b)
    by A6, CbBasic;
  then funS*(cst 0) in ClosGRb(funE,b) by A2, CbBasic, ZeroExprE;
  then ClosGR funE c= ClosGRb(funE,b) by A3, A5, OneExpr, CbSub;
  then A8: ClosJR c= ClosGRb(funE,b) by GREqJR;
  ClosGRb(funE,b) c= ClosGR funE by CGOne, GRbSubGE;
  then ClosGRb(funE,b) c= ClosJR by GREqJR;
  hence thesis by A8, XBOOLE_0:def 10;
end;

:: The case X = K.  Z = K^-1, U = K (Z T)^+b (U(x) = x + b - 1);
:: b >= 2: P1 = K (K U)^-1 subtracts b - 1, C = K (Z P1)^+b U U U is the
:: constant 2b - 4 and S = K (K C^+b)^-1 U U U;
:: b = 1: P^ = K (Z^+1)^+1 (P^(y+1) = y, P^(0) = 1), S = K P^^-1 (Z T)^+1

theorem ALe:
  n <= funA.n
proof
  A1: n <= n*n by LeSq;
  2*(funA.n) = n*n + n by TwoA;
  then n + n <= 2*(funA.n) by A1, XREAL_1:6;
  then 2*n <= 2*(funA.n);
  hence thesis by XREAL_1:68;
end;

:: subtraction by inversion: if V(y) = y + c then K (K V)^-1 subtracts c
theorem KSubInv:
  (for y holds W.y = y + c) & c <= x implies
  funK*W is surj & funK.((opInv.(funK*W)).x) = x -' c
proof
  assume that A1: for y holds W.y = y + c and A2: c <= x;
  thus A3: funK*W is surj
  proof
    let x;
    set n = x + c;
    A4: c <= n by NAT_1:11;
    n <= funA.n by ALe;
    then c <= funA.n by A4, XXREAL_0:2;
    then A5: c <= funA.n + x by NAT_1:12;
    take y = funA.n + x -' c;
    A6: W.y = y + c by A1 .= funA.n + x by A5, XREAL_1:235;
    x <= n by NAT_1:11;
    then A7: funK.(funA.n + x) = x by Diag;
    thus (funK*W).y = funK.(W.y) by CompVal .= x by A6, A7;
  end;
  set y = (opInv.(funK*W)).x;
  (funK*W).y = x by A3, InvRight;
  then A8: funK.(W.y) = x by CompVal;
  set t = funV.(y + c);
  A9: funK.(y + c) = x by A1, A8;
  then A10: y + c = funA.t + x & x <= t by Decomp;
  set d = x -' c;
  A11: x = d + c by A2, XREAL_1:235;
  then A12: y = funA.t + d by A10;
  d <= x by A11, NAT_1:11;
  then d <= t by A10, XXREAL_0:2;
  hence thesis by A12, Diag;
end;

definition
  let b be Nat;
  func exprUK b -> Element of Funcs(NAT,NAT) equals
  funK*((opPlusIb b).(funZ*((opPlusIb b).funI)));
  coherence;
end;

theorem UKVal:
  b = c + 1 implies (exprUK b).x = x + c
proof
  assume A1: b = c + 1;
  set n = 2*x + b;
  A2: funA.(n+1) = funA.n + n + 1 by ASuc;
  A3: (exprUK b).x = funK.(((opPlusIb b).(funZ*((opPlusIb b).funI))).x)
      by CompVal
    .= funK.((funZ*((opPlusIb b).funI)).x + x + b) by DefPlusIb
    .= funK.(funZ.(((opPlusIb b).funI).x) + x + b) by CompVal
    .= funK.(funZ.n + x + b) by TVal
    .= funK.(funA.n + n + x + b) by DefZ
    .= funK.(funA.(n+1) + (x + c)) by A1, A2;
  n + 1 = (x + c) + (x + 2) by A1;
  then x + c <= n + 1 by NAT_1:11;
  hence thesis by A3, Diag;
end;

theorem CbKFirst:
  funZ in ClosGRb(funK,b) & funI in ClosGRb(funK,b) &
  exprUK b in ClosGRb(funK,b)
proof
  A1: funK in ClosGRb(funK,b) by CbBasic;
  then opInv.funK in ClosGRb(funK,b) by CbBasic;
  hence A2: funZ in ClosGRb(funK,b) by KinvZ;
  now
    let x;
    thus (funK*funZ).x = funK.(funZ.x) by CompVal .= x by KZ
      .= funI.x by DefI;
  end;
  then funK*funZ = funI by UFunExt;
  hence funI in ClosGRb(funK,b) by A1, A2, CbBasic;
  then (opPlusIb b).funI in ClosGRb(funK,b) by CbBasic;
  then funZ*((opPlusIb b).funI) in ClosGRb(funK,b) by A2, CbBasic;
  then (opPlusIb b).(funZ*((opPlusIb b).funI)) in ClosGRb(funK,b)
    by CbBasic;
  hence thesis by A1, CbBasic;
end;

definition
  let b be Nat;
  func exprP1K b -> Element of Funcs(NAT,NAT) equals
  funK*(opInv.(funK*(exprUK b)));
  coherence;
end;

definition
  let b be Nat;
  func exprCK b -> Element of Funcs(NAT,NAT) equals
  funK*((opPlusIb b).(funZ*(exprP1K b)))*(exprUK b)*(exprUK b)*(exprUK b);
  coherence;
end;

theorem U3Val:
  b = c + 1 implies
  ((exprUK b)*(exprUK b)*(exprUK b)).x = x + 3*c &
  for G holds (G*(exprUK b)*(exprUK b)*(exprUK b)).x = G.(x + 3*c)
proof
  assume A1: b = c + 1;
  set U = exprUK b;
  A2: (U*U*U).x = (U*U).(U.x) by CompVal
    .= U.(U.(U.x)) by CompVal
    .= U.(U.(x + c)) by A1, UKVal
    .= U.(x + c + c) by A1, UKVal
    .= x + c + c + c by A1, UKVal;
  hence (U*U*U).x = x + 3*c;
  let G;
  thus (G*U*U*U).x = (G*U*U).(U.x) by CompVal
    .= (G*U).(U.(U.x)) by CompVal
    .= G.(U.(U.(U.x))) by CompVal
    .= G.((U*U).(U.x)) by CompVal
    .= G.(x + 3*c) by A2, CompVal;
end;

theorem CKVal:
  b = d + 2 implies (exprCK b).x = 2*d
proof
  assume A1: b = d + 2;
  set c = d + 1;
  A2: b = c + 1 by A1;
  set y = x + 3*c, g = x + 2*c;
  set G = funK*((opPlusIb b).(funZ*(exprP1K b)));
  A3: for y holds (exprUK b).y = y + c by A2, UKVal;
  y = c + (x + 2*c);
  then c <= y by NAT_1:11;
  then funK.((opInv.(funK*(exprUK b))).y) = y -' c by A3, KSubInv;
  then A4: (exprP1K b).y = y -' c by CompVal
    .= g + c -' c
    .= g by NAT_D:34;
  A5: funA.(g+1+1) = funA.(g+1) + (g+1) + 1 by ASuc
    .= funA.g + g + 1 + (g+1) + 1 by ASuc;
  A6: G.y = funK.(((opPlusIb b).(funZ*(exprP1K b))).y) by CompVal
    .= funK.((funZ*(exprP1K b)).y + y + b) by DefPlusIb
    .= funK.(funZ.((exprP1K b).y) + y + b) by CompVal
    .= funK.(funA.g + g + y + b) by A4, DefZ
    .= funK.(funA.(g+1+1) + 2*d) by A1, A5;
  g+1+1 = 2*d + (x + 4);
  then 2*d <= g+1+1 by NAT_1:11;
  then A7: funK.(funA.(g+1+1) + 2*d) = 2*d by Diag;
  thus (exprCK b).x = G.y by A2, U3Val .= 2*d by A6, A7;
end;

definition
  let b be Nat;
  func exprSK2 b -> Element of Funcs(NAT,NAT) equals
  funK*(opInv.(funK*((opPlusIb b).(exprCK b))))*
    (exprUK b)*(exprUK b)*(exprUK b);
  coherence;
end;

theorem SK2Val:
  b = d + 2 implies exprSK2 b = funS
proof
  assume A1: b = d + 2;
  set c = d + 1;
  A2: b = c + 1 by A1;
  set V = (opPlusIb b).(exprCK b);
  A3: for y holds V.y = y + (3*d + 2)
  proof
    let y;
    thus V.y = (exprCK b).y + y + b by DefPlusIb
      .= 2*d + y + b by A1, CKVal
      .= y + (3*d + 2) by A1;
  end;
  now
    let x;
    3*d + 2 <= 3*d + 2 + (x + 1) by NAT_1:11;
    then A4: funK.((opInv.(funK*V)).(x + 1 + (3*d + 2))) =
      x + 1 + (3*d + 2) -' (3*d + 2) by A3, KSubInv;
    thus (exprSK2 b).x = (funK*(opInv.(funK*V))).(x + 3*c) by A2, U3Val
      .= funK.((opInv.(funK*V)).(x + 1 + (3*d + 2))) by CompVal
      .= x + 1 by A4, NAT_D:34
      .= funS.x by DefS;
  end;
  hence thesis by UFunExt;
end;

definition
  func exprPK1 -> Element of Funcs(NAT,NAT) equals
  funK*((opPlusIb 1).((opPlusIb 1).funZ));
  coherence;
end;

definition
  func exprSK1 -> Element of Funcs(NAT,NAT) equals
  funK*(opInv.exprPK1)*((opPlusIb 1).(funZ*((opPlusIb 1).funI)));
  coherence;
end;

theorem PK1Val:
  exprPK1.0 = 1 & exprPK1.(y+1) = y
proof
  A1: for x holds exprPK1.x = funK.(funA.x + 3*x + 2)
  proof
    let x;
    thus exprPK1.x = funK.(((opPlusIb 1).((opPlusIb 1).funZ)).x) by CompVal
      .= funK.(((opPlusIb 1).funZ).x + x + 1) by DefPlusIb
      .= funK.(funZ.x + x + 1 + x + 1) by DefPlusIb
      .= funK.(funA.x + x + x + 1 + x + 1) by DefZ
      .= funK.(funA.x + 3*x + 2);
  end;
  A2: funA.(0+1) = funA.0 + 0 + 1 by ASuc .= 1 by AZero;
  1 <= 1;
  then A3: funK.(funA.1 + 1) = 1 by Diag;
  thus exprPK1.0 = funK.(funA.0 + 3*0 + 2) by A1
    .= funK.(funA.1 + 1) by A2, AZero
    .= 1 by A3;
  A4: funA.(y+1+1) = funA.(y+1) + (y+1) + 1 by ASuc;
  A5: funA.(y+1+1+1) = funA.(y+1+1) + (y+1+1) + 1 by ASuc;
  y + 3 = y + 3;
  then y <= y+1+1+1 by NAT_1:11;
  then A6: funK.(funA.(y+1+1+1) + y) = y by Diag;
  thus exprPK1.(y+1) = funK.(funA.(y+1) + 3*(y+1) + 2) by A1
    .= y by A4, A5, A6;
end;

theorem PK1Inv:
  v <> 1 implies (opInv.exprPK1).v = v + 1
proof
  assume A1: v <> 1;
  A2: exprPK1 is surj
  proof
    let x;
    take x + 1;
    thus thesis by PK1Val;
  end;
  set y = (opInv.exprPK1).v;
  A3: exprPK1.y = v by A2, InvRight;
  per cases by NAT_1:14;
  suppose y = 0;
    hence thesis by A1, A3, PK1Val;
  end;
  suppose 1 <= y;
    then consider y1 being Nat such that A4: y = 1 + y1 by NAT_1:10;
    thus thesis by A3, A4, PK1Val;
  end;
end;

theorem SK1Val:
  exprSK1 = funS
proof
  now
    let x;
    set n = 2*x + 1;
    set v = funA.(n+1) + x;
    A1: funA.(n+1) = funA.n + n + 1 by ASuc;
    A2: ((opPlusIb 1).(funZ*((opPlusIb 1).funI))).x
        = (funZ*((opPlusIb 1).funI)).x + x + 1 by DefPlusIb
      .= funZ.(((opPlusIb 1).funI).x) + x + 1 by CompVal
      .= funZ.n + x + 1 by TVal
      .= funA.n + n + x + 1 by DefZ
      .= v by A1;
    A3: v <> 1
    proof
      assume A4: v = 1;
      A5: n + 1 <= funA.(n+1) by ALe;
      funA.(n+1) <= v by NAT_1:11;
      then n + 1 <= v by A5, XXREAL_0:2;
      then 2*x + 1 + 1 <= 0 + 1 by A4;
      hence contradiction by XREAL_1:6;
    end;
    n + 1 = (x + 1) + (x + 1);
    then A6: x + 1 <= n + 1 by NAT_1:11;
    thus exprSK1.x
        = (funK*(opInv.exprPK1)).(((opPlusIb 1).(funZ*((opPlusIb 1).funI))).x)
          by CompVal
      .= funK.((opInv.exprPK1).v) by A2, CompVal
      .= funK.(v + 1) by A3, PK1Inv
      .= funK.(funA.(n+1) + (x + 1))
      .= x + 1 by A6, Diag
      .= funS.x by DefS;
  end;
  hence thesis by UFunExt;
end;

theorem CbKS:
  1 <= b implies funS in ClosGRb(funK,b)
proof
  assume A1: 1 <= b;
  A2: funK in ClosGRb(funK,b) & funZ in ClosGRb(funK,b) &
    funI in ClosGRb(funK,b) & exprUK b in ClosGRb(funK,b)
    by CbBasic, CbKFirst;
  per cases by A1, XXREAL_0:1;
  suppose A3: b = 1;
    (opPlusIb 1).funZ in ClosGRb(funK,b) by A2, A3, CbBasic;
    then (opPlusIb 1).((opPlusIb 1).funZ) in ClosGRb(funK,b) by A3, CbBasic;
    then exprPK1 in ClosGRb(funK,b) by A2, CbBasic;
    then opInv.exprPK1 in ClosGRb(funK,b) by CbBasic;
    then A4: funK*(opInv.exprPK1) in ClosGRb(funK,b) by A2, CbBasic;
    (opPlusIb 1).funI in ClosGRb(funK,b) by A2, A3, CbBasic;
    then funZ*((opPlusIb 1).funI) in ClosGRb(funK,b) by A2, CbBasic;
    then (opPlusIb 1).(funZ*((opPlusIb 1).funI)) in ClosGRb(funK,b)
      by A3, CbBasic;
    then exprSK1 in ClosGRb(funK,b) by A4, CbBasic;
    hence thesis by SK1Val;
  end;
  suppose 1 < b;
    then 1 + 1 <= b by NAT_1:13;
    then consider d such that A3: b = 2 + d by NAT_1:10;
    set U = exprUK b;
    funK*U in ClosGRb(funK,b) by A2, CbBasic;
    then opInv.(funK*U) in ClosGRb(funK,b) by CbBasic;
    then funK*(opInv.(funK*U)) in ClosGRb(funK,b) by A2, CbBasic;
    then funZ*(exprP1K b) in ClosGRb(funK,b) by A2, CbBasic;
    then (opPlusIb b).(funZ*(exprP1K b)) in ClosGRb(funK,b) by CbBasic;
    then funK*((opPlusIb b).(funZ*(exprP1K b))) in ClosGRb(funK,b)
      by A2, CbBasic;
    then funK*((opPlusIb b).(funZ*(exprP1K b)))*U in ClosGRb(funK,b)
      by A2, CbBasic;
    then funK*((opPlusIb b).(funZ*(exprP1K b)))*U*U in ClosGRb(funK,b)
      by A2, CbBasic;
    then exprCK b in ClosGRb(funK,b) by A2, CbBasic;
    then (opPlusIb b).(exprCK b) in ClosGRb(funK,b) by CbBasic;
    then funK*((opPlusIb b).(exprCK b)) in ClosGRb(funK,b) by A2, CbBasic;
    then opInv.(funK*((opPlusIb b).(exprCK b))) in ClosGRb(funK,b)
      by CbBasic;
    then funK*(opInv.(funK*((opPlusIb b).(exprCK b)))) in ClosGRb(funK,b)
      by A2, CbBasic;
    then funK*(opInv.(funK*((opPlusIb b).(exprCK b))))*U in ClosGRb(funK,b)
      by A2, CbBasic;
    then funK*(opInv.(funK*((opPlusIb b).(exprCK b))))*U*U
      in ClosGRb(funK,b) by A2, CbBasic;
    then exprSK2 b in ClosGRb(funK,b) by A2, CbBasic;
    hence thesis by A3, SK2Val;
  end;
end;

theorem GRbK:
  1 <= b implies ClosGRb(funK,b) = ClosJR
proof
  assume A1: 1 <= b;
  A2: funS in ClosGRb(funK,b) & funK in ClosGRb(funK,b) &
    funZ in ClosGRb(funK,b) by A1, CbKS, CbBasic, CbKFirst;
  funK*funS in ClosGRb(funK,b) by A2, CbBasic;
  then opInv.(funK*funS) in ClosGRb(funK,b) by CbBasic;
  then A3: exprPK in ClosGRb(funK,b) by A2, CbBasic;
  A4: for x holds exprPK.(x+1) = x by PKVal;
  A5: for F st F in ClosGRb(funK,b) holds opPlusI.F in ClosGRb(funK,b)
    by A3, A4, CbPlusI;
  then opPlusI.funZ in ClosGRb(funK,b) by A2;
  then funZ*(opPlusI.funZ) in ClosGRb(funK,b) by A2, CbBasic;
  then funZ*(opPlusI.funZ)*funK in ClosGRb(funK,b) by A2, CbBasic;
  then opPlusI.(funZ*(opPlusI.funZ)*funK) in ClosGRb(funK,b) by A5;
  then (opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ in ClosGRb(funK,b)
    by A2, CbBasic;
  then (opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ*funK in ClosGRb(funK,b)
    by A2, CbBasic;
  then A6: opPlusI.((opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ*funK)
    in ClosGRb(funK,b) by A5;
  funK*funS in ClosGRb(funK,b) by A2, CbBasic;
  then funK*funS*funS in ClosGRb(funK,b) by A2, CbBasic;
  then funK*funS*funS*funS in ClosGRb(funK,b) by A2, CbBasic;
  then funK*funS*funS*funS*
    (opPlusI.((opPlusI.(funZ*(opPlusI.funZ)*funK))*funZ*funK))
    in ClosGRb(funK,b) by A6, CbBasic;
  then exprAK in ClosGRb(funK,b) by A2, CbBasic;
  then A7: funK*funA in ClosGRb(funK,b) by A2, AExprK, CbBasic;
  now
    let x;
    0 <= x;
    then A8: funK.(funA.x + 0) = 0 by Diag;
    thus (funK*funA).x = funK.(funA.x) by CompVal .= 0 by A8
      .= (cst 0).x by DefCst;
  end;
  then funK*funA = cst 0 by UFunExt;
  then funS*(cst 0) in ClosGRb(funK,b) by A2, A7, CbBasic;
  then ClosGR funK c= ClosGRb(funK,b) by A3, A4, OneExpr, CbSub;
  then A9: ClosJR c= ClosGRb(funK,b) by GREqJR;
  funK in ClosGR funE by GERich, RichAVKL;
  then ClosGRb(funK,b) c= ClosGR funE by GRbSubGE;
  then ClosGRb(funK,b) c= ClosJR by GREqJR;
  hence thesis by A9, XBOOLE_0:def 10;
end;

:: The case X = L.  L^-1 = A, U = L (...(A^+b)...)^+b (2b - 2 times) is
:: x + b - 1, L A^+b subtracts b - 2 and S = L A^+b U; P = L S A, 0 = L A^+

theorem LSurjA:
  funL is surj & opInv.funL = funA
proof
  A1: for x holds funL.(funA.x) = x
  proof
    let x;
    0 <= x;
    then funL.(funA.x + 0) = x -' 0 by Diag;
    hence thesis by NAT_D:40;
  end;
  thus A2: funL is surj
  proof
    let x;
    take funA.x;
    thus thesis by A1;
  end;
  now
    let x;
    set y = (opInv.funL).x, t = funV.y, k = funK.y;
    funL.(funA.x) = x by A1;
    then A3: y <= funA.x by A2, InvLeast;
    A4: funL.y = x by A2, InvRight;
    A5: y = funA.t + k & k <= t by Decomp;
    funL.y = t -' k by A5, Diag;
    then x <= t by A4, NAT_D:35;
    then A6: funA.x <= funA.t by AMono;
    funA.t <= y by A5, NAT_1:11;
    then funA.x <= y by A6, XXREAL_0:2;
    hence y = funA.x by A3, XXREAL_0:1;
  end;
  hence thesis by UFunExt;
end;

theorem AAdd:
  funA.(x + n) = funA.x + n*x + funA.n
proof
  A1: 2*(funA.(x + n)) = (x + n)*(x + n) + (x + n) by TwoA;
  2*(funA.x) = x*x + x & 2*(funA.n) = n*n + n by TwoA;
  then 2*(funA.(x + n)) = 2*(funA.x + n*x + funA.n) by A1;
  hence thesis;
end;

theorem IterA:
  ex H st H in ClosGRb(funL,b) & for x holds H.x = funA.x + n*(x + b)
proof
  defpred P[Nat] means ex H st H in ClosGRb(funL,b) &
    for x holds H.x = funA.x + $1*(x + b);
  A1: P[0]
  proof
    take funA;
    funL in ClosGRb(funL,b) by CbBasic;
    then opInv.funL in ClosGRb(funL,b) by CbBasic;
    hence funA in ClosGRb(funL,b) by LSurjA;
    let x;
    thus thesis;
  end;
  A2: for n st P[n] holds P[n+1]
  proof
    let n;
    given H such that A3: H in ClosGRb(funL,b) and
      A4: for x holds H.x = funA.x + n*(x + b);
    take (opPlusIb b).H;
    thus (opPlusIb b).H in ClosGRb(funL,b) by A3, CbBasic;
    let x;
    thus ((opPlusIb b).H).x = H.x + x + b by DefPlusIb
      .= funA.x + n*(x + b) + x + b by A4
      .= funA.x + (n+1)*(x + b);
  end;
  for n holds P[n] from NAT_1:sch 2(A1,A2);
  hence thesis;
end;

theorem CbLS:
  1 <= b implies funS in ClosGRb(funL,b)
proof
  assume 1 <= b;
  then consider c such that A1: b = 1 + c by NAT_1:10;
  consider H such that A2: H in ClosGRb(funL,b) and
    A3: for x holds H.x = funA.x + (2*c)*(x + b) by IterA;
  A4: funL in ClosGRb(funL,b) by CbBasic;
  then A5: funL*H in ClosGRb(funL,b) by A2, CbBasic;
  A6: funA in ClosGRb(funL,b) by A4, CbBasic, LSurjA;
  then (opPlusIb b).funA in ClosGRb(funL,b) by CbBasic;
  then A7: funL*((opPlusIb b).funA) in ClosGRb(funL,b) by A4, CbBasic;
  A8: funA.(2*c) = c*c + (c*c + c)
  proof
    funA.(2*c + 0) = (c + 0)*(c + 0) + (c*c + c) by AHalf;
    hence thesis;
  end;
  now
    let x;
    A9: H.x = funA.x + (2*c)*(x + b) by A3
      .= funA.x + (2*c)*x + (c*c + (c*c + c)) + c by A1
      .= funA.x + (2*c)*x + funA.(2*c) + c by A8
      .= funA.(x + 2*c) + c by AAdd;
    x + 2*c = c + (x + c);
    then A10: c <= x + 2*c by NAT_1:11;
    A11: (funL*H).x = funL.(H.x) by CompVal
      .= x + 2*c -' c by A9, A10, Diag
      .= (x + c) + c -' c
      .= x + c by NAT_D:34;
    A12: funA.(x + c + 1) = funA.(x + c) + (x + c) + 1 by ASuc;
    A13: ((opPlusIb b).funA).(x + c) = funA.(x + c) + (x + c) + b
        by DefPlusIb
      .= funA.(x + c + 1) + c by A1, A12;
    x + c + 1 = c + (x + 1);
    then A14: c <= x + c + 1 by NAT_1:11;
    thus (funL*((opPlusIb b).funA)*(funL*H)).x
        = (funL*((opPlusIb b).funA)).(x + c) by A11, CompVal
      .= funL.(((opPlusIb b).funA).(x + c)) by CompVal
      .= x + c + 1 -' c by A13, A14, Diag
      .= (x + 1) + c -' c
      .= x + 1 by NAT_D:34
      .= funS.x by DefS;
  end;
  then funL*((opPlusIb b).funA)*(funL*H) = funS by UFunExt;
  hence thesis by A5, A7, CbBasic;
end;

theorem GRbL:
  1 <= b implies ClosGRb(funL,b) = ClosJR
proof
  assume A1: 1 <= b;
  A2: funS in ClosGRb(funL,b) & funL in ClosGRb(funL,b) by A1, CbLS, CbBasic;
  then A3: funA in ClosGRb(funL,b) by CbBasic, LSurjA;
  funL*funS in ClosGRb(funL,b) by A2, CbBasic;
  then A4: funL*funS*funA in ClosGRb(funL,b) by A3, CbBasic;
  A5: for x holds (funL*funS*funA).(x+1) = x
  proof
    let x;
    1 <= x + 1 by NAT_1:11;
    then A6: funL.(funA.(x+1) + 1) = x + 1 -' 1 by Diag;
    thus (funL*funS*funA).(x+1) = (funL*funS).(funA.(x+1)) by CompVal
      .= funL.(funS.(funA.(x+1))) by CompVal
      .= funL.(funA.(x+1) + 1) by DefS
      .= x by A6, NAT_D:34;
  end;
  then opPlusI.funA in ClosGRb(funL,b) by A3, A4, CbPlusI;
  then A7: funL*(opPlusI.funA) in ClosGRb(funL,b) by A2, CbBasic;
  now
    let x;
    x <= x;
    then A8: funL.(funA.x + x) = x -' x by Diag;
    thus (funL*(opPlusI.funA)).x = funL.((opPlusI.funA).x) by CompVal
      .= funL.(funA.x + x) by DefPlusI
      .= 0 by A8, XREAL_1:232
      .= (cst 0).x by DefCst;
  end;
  then funL*(opPlusI.funA) = cst 0 by UFunExt;
  then funS*(cst 0) in ClosGRb(funL,b) by A2, A7, CbBasic;
  then ClosGR funL c= ClosGRb(funL,b) by A4, A5, OneExpr, CbSub;
  then A9: ClosJR c= ClosGRb(funL,b) by GREqJR;
  funL in ClosGR funE by GERich, RichAVKL;
  then ClosGRb(funL,b) c= ClosGR funE by GRbSubGE;
  then ClosGRb(funL,b) c= ClosJR by GREqJR;
  hence thesis by A9, XBOOLE_0:def 10;
end;

theorem GRb0Fix:
  X.0 = 0 & F in ClosGRb(X,0) implies F.0 = 0
proof
  assume that A1: X.0 = 0 and A2: F in ClosGRb(X,0);
  A3: for G st G in {X} holds G.0 = 0 by A1, TARSKI:def 1;
  A4: for u being UnOp of Funcs(NAT,NAT), G st u in {opPlusIb 0, opInv} &
    G.0 = 0 holds (u.G).0 = 0
  proof
    let u be UnOp of Funcs(NAT,NAT), G;
    assume A5: u in {opPlusIb 0, opInv} & G.0 = 0;
    per cases by A5, TARSKI:def 2;
    suppose A6: u = opPlusIb 0;
      thus (u.G).0 = G.0 + 0 + 0 by A6, DefPlusIb .= 0 by A5;
    end;
    suppose u = opInv;
      hence thesis by A5, InvFix0;
    end;
  end;
  {X} c= Funcs(NAT,NAT) by SingleFuncs;
  hence thesis by A2, A3, A4, Fix0Clos;
end;

theorem GRbIff:
  (ClosGRb(funE,b) = ClosJR iff 1 <= b) &
  (ClosGRb(funK,b) = ClosJR iff 1 <= b) &
  (ClosGRb(funL,b) = ClosJR iff 1 <= b)
proof
  A1: (cst 1).0 = 1 & cst 1 in ClosJR by DefCst, JRFirst;
  A2: b = 0 implies ClosGRb(funE,b) <> ClosJR & ClosGRb(funK,b) <> ClosJR &
    ClosGRb(funL,b) <> ClosJR by A1, XFix0, GRb0Fix;
  A3: not 1 <= b implies b = 0 by NAT_1:14;
  hence ClosGRb(funE,b) = ClosJR iff 1 <= b by A2, GRbE;
  thus ClosGRb(funK,b) = ClosJR iff 1 <= b by A2, A3, GRbK;
  thus thesis by A2, A3, GRbL;
end;

:: Any constant n >= 1 in place of 1: for X in {E, K, L} and a set U of unary
:: operators with F^+ in U, <n, X, U, FG> and <1, X, U, FG> have the same
:: closure.  Since n^+(x) = x + n, every constant c + kn is generated from c,
:: and X steps down from c to c - 1:
::   E(c + (nc^2 + 2c)n) = c - 1,  K(c + (2nc^2 + 3c)n) = c - 1,
::   L(c + (2nc^2 + 2c)n) = nc - c and L((nc - c) + 2nc^2 n) = c - 1.

definition
  let X be Element of Funcs(NAT,NAT), U be set, n be Nat;
  func ClosC(X,U,n) -> Subset of Funcs(NAT,NAT) equals
  clos({cst n, X}, U, {opComp});
  coherence;
end;

theorem CCBasic:
  cst n in ClosC(X,U,n) & X in ClosC(X,U,n) &
  (opPlusI in U & F in ClosC(X,U,n) implies opPlusI.F in ClosC(X,U,n)) &
  (F in ClosC(X,U,n) & G in ClosC(X,U,n) implies F*G in ClosC(X,U,n))
proof
  cst n in {cst n, X} & X in {cst n, X} by TARSKI:def 2;
  hence cst n in ClosC(X,U,n) & X in ClosC(X,U,n) by ClosInit;
  thus opPlusI in U & F in ClosC(X,U,n) implies opPlusI.F in ClosC(X,U,n)
    by ClosUnop;
  thus thesis by CompIn;
end;

theorem CstComp:
  F*(cst m) = cst (F.m)
proof
  now
    let x;
    thus (F*(cst m)).x = F.((cst m).x) by CompVal .= F.m by DefCst
      .= (cst (F.m)).x by DefCst;
  end;
  hence thesis by UFunExt;
end;

theorem CstShift:
  opPlusI in U & cst c in ClosC(X,U,n) implies
  cst (c + k*n) in ClosC(X,U,n) & cst (X.(c + k*n)) in ClosC(X,U,n)
proof
  assume that A1: opPlusI in U and A2: cst c in ClosC(X,U,n);
  cst n in ClosC(X,U,n) by CCBasic;
  then A3: opPlusI.(cst n) in ClosC(X,U,n) by A1, CCBasic;
  A4: for x holds (opPlusI.(cst n)).x = x + n
  proof
    let x;
    thus (opPlusI.(cst n)).x = (cst n).x + x by DefPlusI .= n + x by DefCst
      .= x + n;
  end;
  consider H such that A5: H in ClosC(X,U,n) and
    A6: for x holds H.x = (cst c).x + k*n by A2, A3, A4, PowShift;
  now
    let x;
    thus H.x = (cst c).x + k*n by A6 .= c + k*n by DefCst
      .= (cst (c + k*n)).x by DefCst;
  end;
  then A7: H = cst (c + k*n) by UFunExt;
  hence cst (c + k*n) in ClosC(X,U,n) by A5;
  X in ClosC(X,U,n) by CCBasic;
  then X*(cst (c + k*n)) in ClosC(X,U,n) by A5, A7, CCBasic;
  hence thesis by CstComp;
end;

:: if X steps down from every constant c >= 1, then 1 is generated
theorem OneByDescent:
  1 <= n & (for c st cst c in ClosC(X,U,n) & 1 <= c holds
    cst (c -' 1) in ClosC(X,U,n)) implies cst 1 in ClosC(X,U,n)
proof
  assume that A1: 1 <= n and
    A2: for c st cst c in ClosC(X,U,n) & 1 <= c holds
      cst (c -' 1) in ClosC(X,U,n);
  defpred P[Nat] means $1 + 1 <= n implies cst (n -' $1) in ClosC(X,U,n);
  A3: P[0]
  proof
    n -' 0 = n by NAT_D:40;
    hence thesis by CCBasic;
  end;
  A4: for j st P[j] holds P[j+1]
  proof
    let j;
    assume A5: P[j];
    assume A6: j + 1 + 1 <= n;
    j + 1 <= j + 1 + 1 by NAT_1:11;
    then A11: j + 1 <= n by A6, XXREAL_0:2;
    then consider m such that A7: n = j + 1 + m by NAT_1:10;
    A8: n -' j = (m + 1) + j -' j by A7 .= m + 1 by NAT_D:34;
    A9: n -' (j + 1) = m + (j + 1) -' (j + 1) by A7 .= m by NAT_D:34;
    A10: cst (n -' j) in ClosC(X,U,n) by A5, A11;
    1 <= m + 1 by NAT_1:11;
    then cst ((m + 1) -' 1) in ClosC(X,U,n) by A2, A8, A10;
    hence thesis by A9, NAT_D:34;
  end;
  A11: for j holds P[j] from NAT_1:sch 2(A3,A4);
  consider m such that A12: n = 1 + m by A1, NAT_1:10;
  A13: n -' m = 1 + m -' m by A12 .= 1 by NAT_D:34;
  m + 1 <= n by A12;
  hence thesis by A11, A13;
end;

theorem CEqC1:
  opPlusI in U & 1 <= n & cst 1 in ClosC(X,U,n) implies
  ClosC(X,U,n) = ClosC(X,U,1)
proof
  assume that A1: opPlusI in U and A2: 1 <= n and
    A3: cst 1 in ClosC(X,U,n);
  ClosC(X,U,n) is_closed_under {cst 1, X}, U, {opComp}
  proof
    thus {cst 1, X} c= ClosC(X,U,n)
    proof
      let z be object;
      assume z in {cst 1, X};
      then z = cst 1 or z = X by TARSKI:def 2;
      hence thesis by A3, CCBasic;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in U & F in ClosC(X,U,n) holds u.F in ClosC(X,U,n) by ClosUnop;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A4: c in {opComp} & F in ClosC(X,U,n) & G in ClosC(X,U,n);
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A4, CCBasic;
  end;
  then A5: ClosC(X,U,1) c= ClosC(X,U,n) by ClosLeast;
  consider m such that A6: n = 1 + m by A2, NAT_1:10;
  cst 1 in ClosC(X,U,1) by CCBasic;
  then cst (1 + m*1) in ClosC(X,U,1) by A1, CstShift;
  then A7: cst n in ClosC(X,U,1) by A6;
  ClosC(X,U,1) is_closed_under {cst n, X}, U, {opComp}
  proof
    thus {cst n, X} c= ClosC(X,U,1)
    proof
      let z be object;
      assume z in {cst n, X};
      then z = cst n or z = X by TARSKI:def 2;
      hence thesis by A7, CCBasic;
    end;
    thus for u being UnOp of Funcs(NAT,NAT), F being Element of Funcs(NAT,NAT)
      st u in U & F in ClosC(X,U,1) holds u.F in ClosC(X,U,1) by ClosUnop;
    let c be BinOp of Funcs(NAT,NAT), F,G be Element of Funcs(NAT,NAT);
    assume A8: c in {opComp} & F in ClosC(X,U,1) & G in ClosC(X,U,1);
    then c = opComp by TARSKI:def 1;
    then c.(F,G) = F*G by DefComp;
    hence thesis by A8, CCBasic;
  end;
  then ClosC(X,U,n) c= ClosC(X,U,1) by ClosLeast;
  hence thesis by A5, XBOOLE_0:def 10;
end;

:: the descent, with n = n1 + 1 and c = c1 + 1
theorem EDesc:
  n = n1 + 1 & c = c1 + 1 implies funE.(c + (n*c*c + 2*c)*n) = c1
proof
  assume that A1: n = n1 + 1 and A2: c = c1 + 1;
  A3: c + (n*c*c + 2*c)*n = (n*c + 1)*(n*c + 1) + c1 by A2;
  2*(n*c + 1) = c1 + (c1 + 2*n1*c + 4) by A1, A2;
  then c1 <= 2*(n*c + 1) by NAT_1:11;
  hence thesis by A3, ESqAdd;
end;

theorem KDesc:
  n = n1 + 1 & c = c1 + 1 implies funK.(c + (2*n*c*c + 3*c)*n) = c1
proof
  assume that A1: n = n1 + 1 and A2: c = c1 + 1;
  set m = 2*n*c + 1;
  2*(funA.m) = m*m + m by TwoA;
  then 2*(funA.m) = 2*((2*n*c + 1)*(n*c + 1));
  then A3: funA.m = (2*n*c + 1)*(n*c + 1);
  A4: c + (2*n*c*c + 3*c)*n = funA.m + c1 by A2, A3;
  m = c1 + (2*n1*c + c + 2) by A1, A2;
  then c1 <= m by NAT_1:11;
  hence thesis by A4, Diag;
end;

theorem LDesc1:
  n = n1 + 1 implies funL.(c + (2*n*c*c + 2*c)*n) = n1*c
proof
  assume A1: n = n1 + 1;
  set m = 2*n*c, k = n*c + c;
  2*(funA.m) = m*m + m by TwoA;
  then 2*(funA.m) = 2*(2*n*n*c*c + n*c);
  then A2: funA.m = 2*n*n*c*c + n*c;
  A3: c + (2*n*c*c + 2*c)*n = funA.m + k by A2;
  A4: m = k + n1*c by A1;
  then k <= m by NAT_1:11;
  then funL.(funA.m + k) = m -' k by Diag .= n1*c by A4, NAT_D:34;
  hence thesis by A3;
end;

theorem LDesc2:
  n = n1 + 1 & c = c1 + 1 implies funL.(n1*c + (2*n*c*c)*n) = c1
proof
  assume that A1: n = n1 + 1 and A2: c = c1 + 1;
  set k = (2*n1 + 1)*c, m = k + c1;
  set q = 2*n1*c1 + 2*n1 + 2*c1 + 1;
  A5: k = (2*n1 + 1)*(c1 + 1) by A2;
  then A6: m = q;
  A7: 2*(funA.m) = m*m + m by TwoA;
  2*(funA.m + k) = m*m + m + 2*k by A7
    .= q*q + q + 2*((2*n1 + 1)*(c1 + 1)) by A5, A6
    .= 2*(n1*(c1 + 1) + (2*(n1 + 1)*(c1 + 1)*(c1 + 1))*(n1 + 1))
    .= 2*(n1*c + (2*n*c*c)*n) by A1, A2;
  then A4: funA.m + k = n1*c + (2*n*c*c)*n;
  k <= m by NAT_1:11;
  then funL.(funA.m + k) = m -' k by Diag .= c1 by NAT_D:34;
  hence thesis by A4;
end;

theorem OneInC:
  opPlusI in U & 1 <= n implies cst 1 in ClosC(funE,U,n) &
  cst 1 in ClosC(funK,U,n) & cst 1 in ClosC(funL,U,n)
proof
  assume that A1: opPlusI in U and A2: 1 <= n;
  consider n1 such that A3: n = 1 + n1 by A2, NAT_1:10;
  for c st cst c in ClosC(funE,U,n) & 1 <= c holds
    cst (c -' 1) in ClosC(funE,U,n)
  proof
    let c;
    assume A4: cst c in ClosC(funE,U,n) & 1 <= c;
    then consider c1 such that A5: c = 1 + c1 by NAT_1:10;
    A6: c -' 1 = c1 by A5, NAT_D:34;
    cst (funE.(c + (n*c*c + 2*c)*n)) in ClosC(funE,U,n) by A1, A4, CstShift;
    hence thesis by A3, A5, A6, EDesc;
  end;
  hence cst 1 in ClosC(funE,U,n) by A2, OneByDescent;
  for c st cst c in ClosC(funK,U,n) & 1 <= c holds
    cst (c -' 1) in ClosC(funK,U,n)
  proof
    let c;
    assume A4: cst c in ClosC(funK,U,n) & 1 <= c;
    then consider c1 such that A5: c = 1 + c1 by NAT_1:10;
    A6: c -' 1 = c1 by A5, NAT_D:34;
    cst (funK.(c + (2*n*c*c + 3*c)*n)) in ClosC(funK,U,n)
      by A1, A4, CstShift;
    hence thesis by A3, A5, A6, KDesc;
  end;
  hence cst 1 in ClosC(funK,U,n) by A2, OneByDescent;
  for c st cst c in ClosC(funL,U,n) & 1 <= c holds
    cst (c -' 1) in ClosC(funL,U,n)
  proof
    let c;
    assume A4: cst c in ClosC(funL,U,n) & 1 <= c;
    then consider c1 such that A5: c = 1 + c1 by NAT_1:10;
    A6: c -' 1 = c1 by A5, NAT_D:34;
    cst (funL.(c + (2*n*c*c + 2*c)*n)) in ClosC(funL,U,n)
      by A1, A4, CstShift;
    then cst (n1*c) in ClosC(funL,U,n) by A3, LDesc1;
    then cst (funL.(n1*c + (2*n*c*c)*n)) in ClosC(funL,U,n) by A1, CstShift;
    hence thesis by A3, A5, A6, LDesc2;
  end;
  hence thesis by A2, OneByDescent;
end;

theorem CEq:
  opPlusI in U & 1 <= n implies ClosC(funE,U,n) = ClosC(funE,U,1) &
  ClosC(funK,U,n) = ClosC(funK,U,1) & ClosC(funL,U,n) = ClosC(funL,U,1)
proof
  assume A1: opPlusI in U & 1 <= n;
  then cst 1 in ClosC(funE,U,n) & cst 1 in ClosC(funK,U,n) &
    cst 1 in ClosC(funL,U,n) by OneInC;
  hence thesis by A1, CEqC1;
end;

theorem C0Fix:
  X.0 = 0 & (for u being UnOp of Funcs(NAT,NAT), G st u in U & G.0 = 0
     holds (u.G).0 = 0) & F in ClosC(X,U,0) implies F.0 = 0
proof
  assume that A1: X.0 = 0 and
    A2: for u being UnOp of Funcs(NAT,NAT), G st u in U & G.0 = 0
      holds (u.G).0 = 0 and A3: F in ClosC(X,U,0);
  A4: for G st G in {cst 0, X} holds G.0 = 0
  proof
    let G;
    assume G in {cst 0, X};
    then G = cst 0 or G = X by TARSKI:def 2;
    hence thesis by A1, DefCst;
  end;
  {cst 0, X} c= Funcs(NAT,NAT) by SingleFuncs;
  hence thesis by A2, A3, A4, Fix0Clos;
end;

theorem BoxInvFix0:
  (for u being UnOp of Funcs(NAT,NAT), G st u in {opPlusI, opBox} &
     G.0 = 0 holds (u.G).0 = 0) &
  (for u being UnOp of Funcs(NAT,NAT), G st u in {opPlusI, opInv} &
     G.0 = 0 holds (u.G).0 = 0)
proof
  thus for u being UnOp of Funcs(NAT,NAT), G st u in {opPlusI, opBox} &
     G.0 = 0 holds (u.G).0 = 0
  proof
    let u be UnOp of Funcs(NAT,NAT), G;
    assume A1: u in {opPlusI, opBox} & G.0 = 0;
    then u = opPlusI or u = opBox by TARSKI:def 2;
    hence thesis by A1, PlusIFix0, BoxFix0;
  end;
  let u be UnOp of Funcs(NAT,NAT), G;
  assume A1: u in {opPlusI, opInv} & G.0 = 0;
  then u = opPlusI or u = opInv by TARSKI:def 2;
  hence thesis by A1, PlusIFix0, InvFix0;
end;

:: primitive recursive functions: <n, X, F^+, FG, F^box> generates clos F
:: (Theorems 6.7 and 6.8) if and only if n >= 1
theorem CnBox:
  (ClosC(funE,{opPlusI, opBox},n) = C6 iff 1 <= n) &
  (ClosC(funK,{opPlusI, opBox},n) = C6 iff 1 <= n) &
  (ClosC(funL,{opPlusI, opBox},n) = C6 iff 1 <= n)
proof
  set U = {opPlusI, opBox};
  A1: opPlusI in U by TARSKI:def 2;
  A2: (cst 1).0 = 1 & cst 1 in C6 by DefCst, C6One;
  A3: for u being UnOp of Funcs(NAT,NAT), G st u in U & G.0 = 0
    holds (u.G).0 = 0 by BoxInvFix0;
  A4: n = 0 implies ClosC(funE,U,n) <> C6 & ClosC(funK,U,n) <> C6 &
    ClosC(funL,U,n) <> C6 by A2, A3, XFix0, C0Fix;
  A5: not 1 <= n implies n = 0 by NAT_1:14;
  A6: 1 <= n implies ClosC(funE,U,n) = C6 & ClosC(funK,U,n) = C6 &
    ClosC(funL,U,n) = C6
  proof
    assume 1 <= n;
    then A7: ClosC(funE,U,n) = ClosC(funE,U,1) &
      ClosC(funK,U,n) = ClosC(funK,U,1) &
      ClosC(funL,U,n) = ClosC(funL,U,1) by A1, CEq;
    C6K = C6 & C6L = C6 by Theorem68;
    hence thesis by A7, C6Eq;
  end;
  hence ClosC(funE,U,n) = C6 iff 1 <= n by A4, A5;
  thus ClosC(funK,U,n) = C6 iff 1 <= n by A4, A5, A6;
  thus thesis by A4, A5, A6;
end;

:: general recursive functions: <n, X, F^+, FG, F^-1> generates ClosJR
:: if and only if n >= 1
theorem CnInv:
  (ClosC(funE,{opPlusI, opInv},n) = ClosJR iff 1 <= n) &
  (ClosC(funK,{opPlusI, opInv},n) = ClosJR iff 1 <= n) &
  (ClosC(funL,{opPlusI, opInv},n) = ClosJR iff 1 <= n)
proof
  set U = {opPlusI, opInv};
  A1: opPlusI in U by TARSKI:def 2;
  A2: (cst 1).0 = 1 & cst 1 in ClosJR by DefCst, JRFirst;
  A3: for u being UnOp of Funcs(NAT,NAT), G st u in U & G.0 = 0
    holds (u.G).0 = 0 by BoxInvFix0;
  A4: n = 0 implies ClosC(funE,U,n) <> ClosJR & ClosC(funK,U,n) <> ClosJR &
    ClosC(funL,U,n) <> ClosJR by A2, A3, XFix0, C0Fix;
  A5: not 1 <= n implies n = 0 by NAT_1:14;
  A6: 1 <= n implies ClosC(funE,U,n) = ClosJR & ClosC(funK,U,n) = ClosJR &
    ClosC(funL,U,n) = ClosJR
  proof
    assume 1 <= n;
    then ClosC(funE,U,n) = ClosC(funE,U,1) &
      ClosC(funK,U,n) = ClosC(funK,U,1) &
      ClosC(funL,U,n) = ClosC(funL,U,1) by A1, CEq;
    hence thesis by GREqJR;
  end;
  hence ClosC(funE,U,n) = ClosJR iff 1 <= n by A4, A5;
  thus ClosC(funK,U,n) = ClosJR iff 1 <= n by A4, A5, A6;
  thus thesis by A4, A5, A6;
end;
