/-
  Lemma 3.3 and Theorem 6.7.
-/
import UPRF.Robinson

namespace UPRF

/-- footnote 3: x - y stands for any function d(x, y) equal to x - y whenever x ≥ y -/
def IsDifference (d : ℕ → ℕ → ℕ) : Prop := ∀ a b, b ≤ a → d a b = a - b

def opDiff (d : ℕ → ℕ → ℕ) (F G : UFun) : UFun := fun x => d (F x) (G x)

/-- the basis ⟨S, Sq, O, Hf, Rt, F + G, F - G, FG, F^□⟩ of Lemma 3.3 -/
@[clos_defs] def basisL33 (d : ℕ → ℕ → ℕ) : Basis :=
  ⟨{funS, funSq, funO, funHf, funRt}, {opBox}, {opPlus, opDiff d, (· ∘ ·)}⟩

/-- Lemma 3.3, for every primitive recursive difference function.  The paper derives it
  from Lemma 3.1 and Theorem 2 of [15]; here it follows from Theorem 3 of [15] via
  E ≡ I - Sq Rt. -/
theorem Lemma_3_3 {d : ℕ → ℕ → ℕ} (hd : IsDifference d) (hdP : Primrec₂ d) :
    Suitable (basisL33 d) := by
  have diff : ∀ F G, Clos (basisL33 d) F → Clos (basisL33 d) G →
      Clos (basisL33 d) (opDiff d F G) := fun F G hF hG => .binop (by clos_mem) hF hG
  have E : Clos (basisL33 d) funE := by
    rw [← (show opDiff d funI (funSq ∘ funRt) = funE from funext fun x => hd _ _ (funRt_sq_le x)),
      ← funI_eq_box_S]
    clos_solve
  have diffPR : ∀ F G, PrimNN F → PrimNN G → PrimNN (opDiff d F G) :=
    fun F G hF hG => prim_of (hdP.comp (primrec_of hF) (primrec_of hG))
  simulate Robinson_1947_sec7_thm3

theorem C6_sound : ∀ F, C6 F → PrimNN F := by prim_sound

/-- Theorem 6.7: 𝓕 = ⟨1, E, F⁺, FG, F^□⟩ is suitable. -/
theorem Theorem_6_7 : Suitable basis6 := fun F => ⟨C6_sound F, PrimNN_sub_C6⟩

/-- The proof of the paper: the basis of Lemma 3.3 (with the difference function dE of
  footnote 8) is generated by 𝓕. -/
theorem Theorem_6_7_via_L33 : Suitable basis6 := by
  have hd : IsDifference dE := fun a b h => dE_diff h
  have hdP : Primrec₂ dE := by
    have := primrec_of funE_PR
    refine this.comp ?_
    exact Primrec.nat_add.comp (Primrec.nat_add.comp (Primrec.nat_add.comp
      (Primrec.nat_mul.comp (Primrec.nat_add.comp Primrec.fst Primrec.snd)
        (Primrec.nat_add.comp Primrec.fst Primrec.snd))
      (Primrec.nat_mul.comp (Primrec.const 3) Primrec.fst)) Primrec.snd) (Primrec.const 1)
  have diff : ∀ F G, C6 F → C6 G → C6 (opDiff dE F G) := fun F G hF hG => diffE_in hF hG
  simulate (Lemma_3_3 hd hdP)

end UPRF
